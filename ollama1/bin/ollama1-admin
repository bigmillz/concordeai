function renderTune(t,g){g=g||{};const pairs=[];
 if(!t){chip('tunechip','Not set up','');pairs.push(['Power limit',g.power_cap_w?g.power_cap_w+' W':'?']);if(g.sclk_mhz)pairs.push(['Core clock now',g.sclk_mhz+' MHz']);
  kv($('tune'),pairs);$('tunenote').textContent='Off unless you opt in at the server: sudo ./setup.sh --gpu-tune (an AMD Navi 21 card only).';return;}
 chip('tunechip',t.reverted?'Back at stock':t.wanted==='on'?'On':t.wanted==='off'?'Off':'Not set up',t.reverted?'warn':t.wanted==='on'?'ok':'');
