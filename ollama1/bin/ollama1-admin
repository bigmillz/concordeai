 if(f.aio){const t=el('div',undefined,'fan'+(f.aio.pump_rpm>0?' on':''));const ic=fanIcon();if(f.aio.pump_rpm>0)ic.querySelector('.blades').style.animationDuration=clamp(1200/f.aio.pump_rpm,0.18,3).toFixed(2)+'s';
  const d=el('div');d.append(el('div','Pump'+(f.aio.name?' · '+f.aio.name:''),'fl'),el('div',isNum(f.aio.pump_rpm)?Math.round(f.aio.pump_rpm)+' rpm':'no rpm','fr'),el('div',isNum(f.aio.coolant_c)?'coolant '+f.aio.coolant_c.toFixed(1)+' °C':'','fp'));t.append(ic,d);box.append(t);}
