// ---- status: the ring, the attention list, the hero figures -------------------------------
function gpuTemp(g){const t=(g||{}).temps||{};return isNum(t.junction)?t.junction:isNum(t.edge)?t.edge:null;}
function assess(s){const bad=[],warn=[],info=[];const gw=s.gateway||{},tun=s.tunnel||{},up=s.updates||{},c=s.cpu||{};
 if(!tun.up)bad.push('Tunnel is down');
 if(!(gw.time&&!gw.stale))bad.push('Gateway is not running');
 (s.raid||[]).forEach(a=>{if(!a.healthy)bad.push('RAID '+a.name+' is missing a member');
  else if(a.action&&a.action!=='check')warn.push('RAID '+a.name+': '+a.action+(a.progress!=null?' '+a.progress+'%':''));
  else if(a.action)info.push('RAID '+a.name+': check '+(a.progress!=null?a.progress+'%':'running'));});
 (s.disks||[]).forEach(d=>{if(!d.mounted)bad.push(d.mount+' is not mounted');else if(d.total&&d.used/d.total>=0.9)warn.push(d.mount+' is '+Math.round(100*d.used/d.total)+'% full');});
 if((up.ollama||{}).result==='failed')bad.push('The last Ollama update failed');
 if(((up.sleep||{}).resume_check||{}).ok===false)bad.push('The check after waking failed');
 const gt=gpuTemp(s.gpu);if(gt!=null&&gt>=100)bad.push('GPU at '+Math.round(gt)+' °C');else if(gt!=null&&gt>=90)warn.push('GPU at '+Math.round(gt)+' °C');
 const t=c.temp,th=c.thresholds||{};if(t&&isNum(t.c)){if(t.c>=(th.hot_c||90))bad.push('CPU at '+Math.round(t.c)+' °C');else if(t.c>=(th.warn_c||80))warn.push('CPU at '+Math.round(t.c)+' °C');}
 if(c.throttle)warn.push('CPU: '+c.throttle);
 if(up.reboot_required)warn.push('A reboot is needed for updates');
 if(s.pairing_open)warn.push('The pairing window is open');
 const working=(gw.active||0)>0||(gw.queued||0)>0;
 return {bad,warn,info,working,level:bad.length?'bad':warn.length?'warn':working?'work':'ok'};}
function renderHero(s){const a=assess(s),gw=s.gateway||{},ring=$('ring');
 ring.className='ring '+a.level;
 const WORD={ok:'Healthy',work:'Working',warn:'Attention',bad:'Problem'};$('statusword').textContent=WORD[a.level];
 const sub=a.level==='work'?(gw.active||0)+' running, '+(gw.queued||0)+' queued':a.level==='ok'?'All systems normal':(a.bad[0]||a.warn[0]);
 $('statussub').textContent=sub;ring.setAttribute('aria-label','Server status: '+WORD[a.level]+'. '+sub);
 const L=$('attn');L.replaceChildren();const items=[...a.bad.map(x=>[x,'bad']),...a.warn.map(x=>[x,'warn']),...a.info.map(x=>[x,'info'])];
 if(!items.length){const tun=s.tunnel||{};items.push(['Tunnel up ('+(tun.connections||0)+' connections)','ok'],['Gateway running','ok']);
  if((s.raid||[]).length)items.push(['RAID healthy','ok']);items.push(['Ollama '+(gw.ollama_version||'?'),'ok']);}
 items.slice(0,6).forEach(([t,c])=>{const li=el('li');li.append(el('span',undefined,'dot '+c),el('span',t));L.append(li);});
 const tp=gw.tps||{};$('tps').textContent=(tp.current??0).toFixed(1);$('tpsavg').textContent='1 h '+(tp['1h']??0)+'  ·  24 h '+(tp['24h']??0);
 $('req').textContent=String(gw.active||0);$('reqsub').textContent=(gw.queued||0)+' queued  ·  '+(gw.requests_today||0)+' today  ·  '+((gw.totals||{}).refused_gpu||0)+' refused for GPU';
 $('uptime').textContent=dur(s.uptime);$('upsub').textContent=s.hostname||'';
 const sl=sleepSummary(s.idle);$('sleeptxt').textContent=sl[0];$('sleeptxt').className='v'+(sl[1]==='warn'?' warn':'');$('sleepsub').textContent=sl[2]||'';}

// the idle service's own last decision (idle.json, 6b396), as the server screen shows it
function sleepSummary(i){if(!i)return ['Unknown','warn','no word from the idle service'];
 const age=(i.age_s||0)+Math.max(0,Date.now()/1000-fetchedAt);
 if(age>180||i.sleep_ok==null){if(i.supported===false&&age<=180)return ['No deep sleep','dim','this machine can\'t suspend'];
  if(i.enabled===false&&age<=180)return ['Off','dim','auto sleep is off'];return ['Unknown','warn','the idle service hasn\'t said lately'];}
 if(i.supported===false)return ['No deep sleep','dim','this machine can\'t suspend'];
 if(i.enabled===false)return ['Off','dim','auto sleep is off'];
 if(i.sleep_ok===true)return ['Now','warn','going to sleep now'];
 const reason=String(i.reason||'').trim();
 if(reason.startsWith('idle ')&&i.minutes&&isNum(i.idle_s)){const left=i.minutes*60-i.idle_s-age;
  if(left<=0)return ['Very soon','warn','sleeping very soon'];return ['in '+mmss(left),left<300?'warn':'','after '+i.minutes+' min idle'];}
 return ['Awake','warn',reason?reason.charAt(0).toUpperCase()+reason.slice(1):'awake'];}

