<script nonce="{{NONCE}}">
"use strict";
const CSRF=document.querySelector('meta[name=csrf]').content;
const $=id=>document.getElementById(id);
const el=(t,txt,cls)=>{const e=document.createElement(t);if(txt!==undefined)e.textContent=txt;if(cls)e.className=cls;return e;};
const gib=b=>b==null?'?':(b/1073741824).toFixed(1)+' GiB';
const tib=b=>b==null?'?':(b>=1099511627776?(b/1099511627776).toFixed(1)+' TiB':gib(b));
const ago=t=>{if(!t)return 'never';const s=Date.now()/1000-t;return s<90?Math.round(s)+' s ago':s<5400?Math.round(s/60)+' min ago':s<172800?Math.round(s/3600)+' h ago':Math.round(s/86400)+' d ago';};
const dur=s=>{if(s==null)return '?';const d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60);return d?d+'d '+h+'h':h+'h '+m+'m';};
function kv(dl,pairs){dl.replaceChildren();for(const [k,v,c] of pairs){dl.append(el('dt',k));dl.append(el('dd',v,c||''));}}
function table(t,head,rows){t.replaceChildren();const tr=el('tr');head.forEach(h=>tr.append(el('th',h)));t.append(tr);
 if(!rows.length){const r=el('tr'),td=el('td','None','note');td.colSpan=head.length;r.append(td);t.append(r);}
 rows.forEach(cells=>{const r=el('tr');cells.forEach(c=>{const td=el('td');if(c instanceof Node)td.append(c);else td.textContent=c;r.append(td);});t.append(r);});}
async function api(p){const r=await fetch(p,{credentials:'same-origin'});if(!r.ok)throw new Error(r.status);return r.json();}
async function act(action,arg,confirm){const m=$('msg');m.textContent='Starting '+action+'...';
 try{const r=await fetch('/api/action',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','X-O1-CSRF':CSRF},
 body:JSON.stringify({action,arg,confirm})});const j=await r.json();m.textContent=action+': '+j.result;}catch(e){m.textContent=action+': failed ('+e.message+')';}
 setTimeout(refreshSlow,1500);}
let lan=false;
document.querySelectorAll('button[data-act]').forEach(b=>b.addEventListener('click',()=>{const a=b.dataset.act;
 if(a==='reboot'){if(confirm('Reboot the desktop now?'))act('reboot',null,'reboot');return;}
 if(a==='sleep'){let t='The desktop will sleep. Press its power button to wake it. While it sleeps it can\'t be reached, and anything plugged into its second network port loses its connection.';
  if((lastState.raid||[]).some(r=>r.action))t+=' The mirror\'s sync pauses while it sleeps and carries on after it wakes.';
  if(confirm(t))act('sleep',null,'sleep');return;}
 if(a==='lan'){if(confirm(lan?'Turn LAN mode off?':'Turn LAN mode on? The gateway will also answer on the home network without Cloudflare Access (signatures still required, traffic unencrypted).'))act(lan?'lan-off':'lan-on');return;}
 if(a==='update'&&!confirm('Apply all pending updates and update Ollama now?'))return;
 if(a==='restart'&&!confirm('Restart Ollama, the gateway, the terminal and the tunnel? Running requests end.'))return;
 act(a);}));
let lastState={};
async function refreshFast(){let s;try{s=await api('/api/state');}catch(e){return;}
 lastState=s;
 const gw=s.gateway||{},t=gw.tps||{},g=s.gpu||{},tun=s.tunnel||{},up=s.updates||{},ou=up.ollama||{};
 $('tps').textContent=(t.current??0).toFixed(1);$('tpsavg').textContent='1 h '+(t['1h']??0)+'  ·  24 h '+(t['24h']??0);
 $('req').textContent=(gw.active||0)+' active';$('reqsub').textContent=(gw.queued||0)+' queued  ·  '+(gw.requests_today||0)+' today  ·  '+((gw.totals||{}).refused_gpu||0)+' refused for GPU';
 $('gpu').textContent=(g.busy_pct??'?')+'% busy';const temps=Object.entries(g.temps||{}).map(([k,v])=>k+' '+Math.round(v)+'°C').join('  ');
 $('gpusub').textContent='VRAM '+gib(g.vram_used)+' of '+gib(g.vram_total)+'  ·  '+temps+'  ·  '+(g.power_w??'?')+' W  ·  fan '+(g.fan_rpm??'?')+' rpm';
 lan=!!s.lan_mode;$('lanbtn').textContent=lan?'LAN mode: on':'LAN mode: off';
 kv($('svc'),[['Tunnel',tun.up?'connected ('+tun.connections+')':'down',tun.up?'ok':'bad'],
  ['Gateway',gw.time&&!gw.stale?'running':'not running',gw.time&&!gw.stale?'ok':'bad'],
  ['Ollama',gw.ollama_version||'?'],['Pairing window',s.pairing_open?'open':'closed',s.pairing_open?'warn':''],
  ['Reboot required',up.reboot_required?'yes':'no',up.reboot_required?'warn':''],
  ['Last sleep / wake',((up.sleep||{}).last_sleep?ago(up.sleep.last_sleep):'never')+' / '+((up.sleep||{}).last_wake?ago(up.sleep.last_wake):'never')+(((up.sleep||{}).resume_check||{}).detail?' ('+up.sleep.resume_check.detail+')':''),((up.sleep||{}).resume_check||{}).ok===false?'bad':''],
  ['Security updates',up.last_unattended?'last ran '+ago(up.last_unattended):'never'],
  ['Ollama updater',(ou.result||'not run')+' '+(ou.version||'')+(ou.last_run?', '+ago(ou.last_run):''),ou.result==='failed'?'bad':''],
  ['Next Ollama check',up.next_ollama_update||'?']]);
 const vt=g.vram_total||0;table($('loaded'),['Model','Size','On GPU','Context'],(gw.loaded||[]).map(m=>{const sh=m.size?m.size_vram/m.size:0;
  return [m.name,gib(m.size),sh>=1?'100%':Math.round(sh*100)+'% (rest in system memory)',String(m.context_length??'?')];}));
 if(vt){const r=el('tr'),td=el('td','VRAM headroom '+gib(vt-(g.vram_used||0)),'note');td.colSpan=4;r.append(td);$('loaded').append(r);}
 const mem=s.memory||{},pairs=[['Uptime',dur(s.uptime)],['CPU',(s.cpu_pct??'?')+'%  ·  load '+(s.load||[]).map(x=>x.toFixed(2)).join(' ')],
  ['Memory',gib(mem.used)+' of '+gib(mem.total)]];
 const net=s.network;if(net){pairs.push([net.name,(net.address||'no address')+'  ·  '+(net.state==='up'?'up':net.state),net.state==='up'?'':'bad']);
  (net.ports||[]).forEach(p=>pairs.push(['  '+p.name,(p.carrier?'link'+(p.speed_mbps?' '+p.speed_mbps+' Mb/s':''):'no link')+(p.name==='enp38s0'?'  ·  Pi port':'')]));}
 (s.disks||[]).forEach(d=>pairs.push([d.mount,d.mounted?tib(d.used)+' of '+tib(d.total)+' ('+Math.round(100*d.used/d.total)+'%)':'not mounted',d.mounted?'':'bad']));
 (s.raid||[]).forEach(a=>pairs.push([a.name,a.level+' ['+a.members+'] '+(a.healthy?'healthy':'DEGRADED')+(a.action?'  ·  '+a.action+' '+a.progress+'%'+(a.finish?' ('+a.finish+' left)':''):''),a.healthy?'ok':'bad']));
 if(!(s.raid||[]).length)pairs.push(['RAID','no array','warn']);kv($('sys'),pairs);}
async function refreshSlow(){try{const d=await api('/api/devices');table($('devices'),['Name','Id','Paired',''],d.devices.map(x=>{
  const b=el('button','Remove','danger');b.addEventListener('click',()=>{if(confirm('Unpair '+x.name+'? It will need to pair again at the desktop.'))act('remove-device',x.id);});
  return [x.name,x.id,(x.paired_at||'').slice(0,16).replace('T',' '),b];}));}catch(e){}
 try{const m=await api('/api/models');const rows=[];const allowed=new Set(m.allow.map(a=>a.name));
  m.installed.forEach(x=>{const b=el('button','Remove','danger');b.addEventListener('click',()=>{const c=prompt('Type the model name to remove it: '+x.name);if(c===x.name)act('remove-model',x.hash,c);});
   const a=m.allow.find(a=>a.name===x.name);rows.push([x.name,gib(x.size),a?(a.ram?'allow-listed, may use system memory':'allow-listed, GPU only'):'installed by hand, GPU only',b]);});
  m.allow.filter(a=>!a.installed).forEach(a=>{const b=el('button','Pull');b.addEventListener('click',()=>act('pull',a.hash));rows.push([a.name,'-','allow-listed'+(a.ram?', may use system memory':'')+', not installed',b]);});
  (m.allow_errors||[]).forEach(e=>rows.push(['line '+e.line+': '+e.text,'-','ignored: '+e.reason,'']));
  table($('models'),['Model','Size','',''],rows);const p=m.pull;
  $('pull').textContent=p&&p.model?('Pull '+p.model+': '+p.status+(p.total?' '+Math.round(100*p.completed/p.total)+'%':'')):'';}catch(e){}
 try{const l=await api('/api/logs');const acts=[];for(const [k,v] of Object.entries(l.actions||{}))acts.push([k,v.result+', '+ago(v.at),v.result==='failed'?'bad':'']);kv($('acts'),acts);
  table($('log'),['Time','Device','Model','Kind','Status','ms','Tokens in','Tokens out'],(l.recent||[]).slice().reverse().slice(0,40).map(r=>
   [new Date(r.t*1000).toLocaleTimeString(),r.device,r.model,r.kind,String(r.status),String(r.ms),String(r.prompt_tokens),String(r.tokens)]));}catch(e){}}
// --- history charts: one series each, one axis each, crosshair + tooltip ---
let range=3600,hist={rows:[]};
const CH=[['Tokens per second',1,v=>v.toFixed(1)],['GPU busy (%)',2,v=>Math.round(v)+'%'],['VRAM used (GiB)',3,v=>v.toFixed(1)+' GiB'],
 ['GPU temperature (°C)',4,v=>Math.round(v)+'°C'],['GPU power (W)',5,v=>Math.round(v)+' W']];
const NS='http://www.w3.org/2000/svg';const sv=(t,a)=>{const e=document.createElementNS(NS,t);for(const k in a)e.setAttribute(k,a[k]);return e;};
function draw(){const box=$('charts');box.replaceChildren();const now=Date.now()/1000,rows=hist.rows.filter(r=>r[0]>=now-range);
 for(const [title,ix,fmt] of CH){const wrap=el('div',undefined,'chart');wrap.append(el('div',title,'sub'));
  const W=360,H=150,L=38,R=8,T=8,B=20;const svg=sv('svg',{viewBox:'0 0 '+W+' '+H,preserveAspectRatio:'none',role:'img','aria-label':title});
  const pts=rows.filter(r=>r[ix]!=null).map(r=>[r[0],r[ix]]);let max=Math.max(1,...pts.map(p=>p[1]));
  const nice=Math.pow(10,Math.floor(Math.log10(max)));max=Math.ceil(max/nice)*nice;
  const x=t=>L+(t-(now-range))/range*(W-L-R),y=v=>T+(1-v/max)*(H-T-B);
  for(let i=0;i<=2;i++){const v=max*i/2;svg.append(sv('line',{x1:L,x2:W-R,y1:y(v),y2:y(v),stroke:'var(--grid)','stroke-width':1}));
   const tx=sv('text',{x:L-4,y:y(v)+4,'text-anchor':'end','font-size':10,fill:'var(--muted)'});tx.textContent=Number.isInteger(v)?v:v.toFixed(1);svg.append(tx);}
  const lab=range===3600?['-60 min','-30 min','now']:['-24 h','-12 h','now'];[0,.5,1].forEach((f,i)=>{const tx=sv('text',{x:L+f*(W-L-R),y:H-5,'text-anchor':i===0?'start':i===2?'end':'middle','font-size':10,fill:'var(--muted)'});tx.textContent=lab[i];svg.append(tx);});
  if(pts.length>1){let d='';let prev=null;for(const p of pts){d+=(prev&&p[0]-prev>60?'M':(d?'L':'M'))+x(p[0]).toFixed(1)+' '+y(p[1]).toFixed(1);prev=p[0];}
   svg.append(sv('path',{d,fill:'none',stroke:'var(--series)','stroke-width':2,'stroke-linejoin':'round','vector-effect':'non-scaling-stroke'}));}
  else{const tx=sv('text',{x:W/2,y:H/2,'text-anchor':'middle','font-size':11,fill:'var(--muted)'});tx.textContent='No data yet';svg.append(tx);}
  const hair=sv('line',{y1:T,y2:H-B,stroke:'var(--ink2)','stroke-width':1,visibility:'hidden','vector-effect':'non-scaling-stroke'});svg.append(hair);
  const tip=el('div',undefined,'tip');wrap.append(svg,tip);
  svg.addEventListener('pointermove',e=>{if(!pts.length)return;const r=svg.getBoundingClientRect();const t=(now-range)+((e.clientX-r.left)/r.width*W-L)/(W-L-R)*range;
   let best=pts[0];for(const p of pts)if(Math.abs(p[0]-t)<Math.abs(best[0]-t))best=p;const px=x(best[0]);hair.setAttribute('x1',px);hair.setAttribute('x2',px);hair.setAttribute('visibility','visible');
   tip.replaceChildren(el('b',fmt(best[1])),document.createTextNode('  '+new Date(best[0]*1000).toLocaleTimeString()));tip.style.display='block';
   const left=px/W*r.width;tip.style.left=Math.min(left+8,r.width-tip.offsetWidth)+'px';tip.style.top='18px';});
  svg.addEventListener('pointerleave',()=>{hair.setAttribute('visibility','hidden');tip.style.display='none';});
  box.append(wrap);}}
document.querySelectorAll('button[data-range]').forEach(b=>b.addEventListener('click',()=>{range=+b.dataset.range;
 document.querySelectorAll('button[data-range]').forEach(x=>x.classList.toggle('on',x===b));draw();}));
async function refreshHist(){try{hist=await api('/api/history');draw();}catch(e){}}
refreshFast();refreshSlow();refreshHist();setInterval(refreshFast,2000);setInterval(refreshSlow,10000);setInterval(refreshHist,30000);
</script></body></html>
"""


def main():
    import argparse
    import signal
    ap = argparse.ArgumentParser(description="ollama1 admin panel")
    ap.add_argument("--config")
    a = ap.parse_args()
    cfg = load_config(a.config)
    panel, srv, stop = serve(cfg)
    done = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: done.set())
    signal.signal(signal.SIGINT, lambda *_: done.set())
    done.wait()
    stop.set()
    srv.shutdown()
    try:
        panel.save_history()
    except OSError:
        pass


if __name__ == "__main__":
    main()
