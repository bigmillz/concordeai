 const hb=$('fanhold');hb.hidden=!hold;if(hold){const span=Math.max(f.hold_left||0,hb._max&&hb._phase===f.phase?hb._max:0);hb._max=span;hb._phase=f.phase;hb.firstChild.style.width=(span?100*(f.hold_left||0)/span:0)+'%';}
 (f.outputs||[]).forEach(o=>{const t=el('div',undefined,'fan'+(isNum(o.rpm)&&o.rpm>0?' on':''));const ic=fanIcon();
  if(isNum(o.rpm)&&o.rpm>0)ic.querySelector('.blades').style.animationDuration=clamp(600/o.rpm,0.18,3).toFixed(2)+'s';
