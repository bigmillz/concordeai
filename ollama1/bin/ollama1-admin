 else{const v=o.typed?window.prompt(o.title+'\n'+o.typedLabel):window.confirm(o.title+'\n\n'+(o.body||[]).join('\n'));done(o.typed?v:(v||null));}});}

// ---- the buttons ---------------------------------------------------------------------------
