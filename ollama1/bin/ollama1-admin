  return {v,max:Math.max(100,(th.hot_c||90)+10),t:v!=null?String(Math.round(v)):null,u:'°C',sub:t?(t.label||'')+(isNum(t.peak_c)?'  ·  peak '+Math.round(t.peak_c)+'°':''):'',lvl:v>=(th.hot_c||90)?'bad':v>=(th.warn_c||80)?'warn':''};}},
 {id:'ram',label:'Memory',grad:'violet',glow:'rgba(167,139,250,.13)',f:s=>{const m=s.memory||{};return {v:m.used,max:m.total,t:m.total?(m.used/1073741824).toFixed(1):null,u:'GiB',sub:m.total?'of '+gib(m.total)+'  ·  '+Math.round(100*m.used/m.total)+'%':''};}}];
