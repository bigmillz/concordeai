 const waiting=ou.result==='waiting for the network';chip('updchip',ou.result==='failed'?'Last update failed':waiting?'Waiting for the network':up.reboot_required?'Reboot needed':ou.result?'Up to date':'Not run',ou.result==='failed'?'bad':(up.reboot_required||waiting)?'warn':ou.result?'ok':'');
 const u=[['Ollama',(gw.ollama_version||'?')],['Updater',(ou.result||'not run')+(ou.version?' '+ou.version:'')+(ou.last_run?', '+ago(ou.last_run):''),ou.result==='failed'?'bad':''],
  ['Next check',up.next_ollama_update||'?'],['Security updates',up.last_unattended?'last ran '+ago(up.last_unattended):'never'],['Reboot required',up.reboot_required?'yes'+((up.reboot_pkgs||[]).length?' ('+up.reboot_pkgs.join(', ')+')':''):'no',up.reboot_required?'warn':'']];
 if(ou.detail)u.push(['Detail',ou.detail,ou.result==='failed'?'bad':'']);kv($('upd'),u);
 renderAuto(s);
 lan=!!s.lan_mode;const lb=$('lanbtn');lb.setAttribute('aria-checked',String(lan));$('lansub').textContent=lan?'On: the gateway also answers on the home network':'Off: only through Cloudflare';
 chip('pairchip',s.pairing_open?'Pairing open':'Pairing closed',s.pairing_open?'warn':'');}
// ---- auto sleep: the setting the server really holds, and changing it ----------------------
function renderAuto(s){const i=s.idle,st=s.sleep_setting,sl=sleepSummary(i);
 const en=st?st.enabled:null,mins=st?st.minutes:null;
 chip('autochip',en==null?'Unknown':en?'On':'Off',en==null?'warn':en?'ok':'');
 const sw=$('autoswitch');sw.setAttribute('aria-checked',String(!!en));sw.disabled=sleepBusy;$('minset').disabled=sleepBusy;
 $('autoswsub').textContent=en==null?'No word from the server yet':en?'On: it sleeps after '+mins+' idle minutes':'Off: it stays awake'+(mins!=null?' ('+mins+' minutes when on)':'');
 document.querySelectorAll('#minchips [data-min]').forEach(b=>{b.setAttribute('aria-pressed',String(mins!=null&&+b.dataset.min===mins));b.disabled=sleepBusy;});
 const box=$('minbox');if(document.activeElement!==box&&!minDirty)box.value=mins==null?'':String(mins);
 const stale=!!(i&&st&&st.source==='this page'&&i.at<st.at);       // the idle service has not looked since this change
 $('autostate').textContent=!i?'-':stale?'Saved':en?(sl[0].startsWith('in ')?'Sleeps '+sl[0]:sl[0]):sl[0];$('autostate').className='st mt'+(!stale&&sl[1]==='warn'?' warn':'');
 $('autosub').textContent=[stale?'the idle service looks again within 30 seconds':null,!stale&&i&&i.supported===false?'this machine has no deep sleep':null,!stale&&i&&i.reason?'now: '+i.reason:null,i&&i.wake_cards?i.wake_cards+' network card'+(i.wake_cards===1?'':'s')+' can wake it':null,
  st?'setting read from '+st.source+', '+ago(st.at):null].filter(Boolean).join('  ·  ')||'No word from the idle service.';}
async function saveSleep(enabled,minutes){
 if(!Number.isInteger(minutes)||minutes<5||minutes>1440){toast('Not saved','Idle minutes must be a whole number from 5 to 1440.','bad');return;}
 sleepBusy=true;renderAuto(lastState);
 const r=await post('/api/sleep-config',{enabled,minutes});
 sleepBusy=false;
 if(r.ok&&r.j.confirmed){minDirty=false;toast('Auto sleep saved',(r.j.enabled?'On, after '+r.j.minutes+' idle minutes':'Off ('+r.j.minutes+' minutes when on)')+'. The server read the file back.','ok');}
 else toast('Auto sleep not saved',r.msg+' ('+(r.status||'no answer')+')','bad');
 await refreshFast();}
const curSleep=()=>{const st=lastState.sleep_setting;return {en:st?st.enabled:false,min:st?st.minutes:30};};
$('autoswitch').addEventListener('click',()=>{const c=curSleep();saveSleep(!c.en,c.min);});
document.querySelectorAll('#minchips [data-min]').forEach(b=>b.addEventListener('click',()=>saveSleep(curSleep().en,+b.dataset.min)));
$('minbox').addEventListener('input',()=>{minDirty=true;});
$('minbox').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();saveSleep(curSleep().en,Number($('minbox').value));}});
$('minset').addEventListener('click',()=>saveSleep(curSleep().en,$('minbox').value===''?NaN:Number($('minbox').value)));
const MODEL_COLORS=['#2dd4ef','#a78bfa','#f472b6','#fbbf24','#34d399','#6f8fff','#fb923c'];
function renderLoaded(s){const gw=s.gateway||{},g=s.gpu||{},L=$('loaded'),st=$('vstack'),lg=$('vlegend');L.replaceChildren();st.replaceChildren();lg.replaceChildren();
 const vt=g.vram_total||0,used=g.vram_used||0;chip('vramchip',vt?gib(used)+' of '+gib(vt):'no GPU reading','');
 let acc=0;(gw.loaded||[]).forEach((m,ix)=>{const col=MODEL_COLORS[ix%MODEL_COLORS.length],sh=m.size?m.size_vram/m.size:0;
  if(vt&&m.size_vram){const i=el('i');i.style.width=(100*clamp(m.size_vram/vt,0,1-acc))+'%';i.style.background=col;st.append(i);acc+=m.size_vram/vt;}
  const sp=el('span'),k=el('i');k.style.background=col;sp.append(k,document.createTextNode(m.name+' '+gib(m.size_vram)));lg.append(sp);
  const it=el('div',undefined,'item'),hd=el('div',undefined,'hd');hd.append(el('span',m.name,'nm mono'),el('span',gib(m.size),'num dim'));
  let exp='';const e=Date.parse(m.expires_at||'');if(isFinite(e)){const left=e/1000-snow();exp=left>3e7?'stays loaded':left>0?'unloads in '+mmss(left):'unloading';}
  it.append(hd,bar(sh,sh>=1?'':'warn'),el('div',(sh>=1?'100% on the GPU':Math.round(sh*100)+'% on the GPU (rest in system memory)')+'  ·  context '+(m.context_length??'?')+(exp?'  ·  '+exp:''),'note'));L.append(it);});
 if(vt&&used>acc*vt+1){const i=el('i');i.style.width=(100*clamp((used-acc*vt)/vt,0,1-acc))+'%';i.style.background='rgba(148,163,200,.45)';st.append(i);const sp=el('span'),k=el('i');k.style.background='rgba(148,163,200,.45)';sp.append(k,document.createTextNode('other '+gib(used-acc*vt)));lg.append(sp);}
 if(vt){const sp=el('span'),k=el('i');k.style.background='rgba(148,163,200,.14)';sp.append(k,document.createTextNode('free '+gib(vt-used)));lg.append(sp);}
 if(!(gw.loaded||[]).length)L.append(el('div','No model is loaded. The first request loads one.','note'));}

// ---- fast refresh: /api/state every few seconds -------------------------------------------
let fetchedAt=Date.now()/1000;
async function refreshFast(){let s;try{s=await api('/api/state');}catch(e){setLive('off','Offline');return;}
 fetchedAt=Date.now()/1000;if(isNum(s.time))skew=s.time-fetchedAt;lastState=s;if(JOBS[0].t)setLive('','Live');
 $('asof').textContent='Updated '+new Date().toLocaleTimeString();
 pushLive(s);
 const parts=[['hero',()=>renderHero(s)],['gauges',()=>renderGauges(s)],['cpu',()=>renderCpu(s.cpu,s)],['fans',()=>renderFans(s.fan_status)],['leds',()=>renderLeds(s.leds_status)],
  ['storage',()=>renderStorage(s)],['net',()=>renderNet(s)],['tune',()=>renderTune(s.gpu_tune,s.gpu)],['svc',()=>renderSvc(s)],['loaded',()=>renderLoaded(s)],['charts',draw]];
 for(const [,f] of parts){try{f();}catch(e){}}
 const fl=$('fanline');if(fl){fl.hidden=!s.fan;fl.textContent=s.fan||'';}
 const ll=$('ledsline');if(ll){ll.hidden=!s.leds;ll.textContent=s.leds||'';}
 if(LOG.tab==='status')renderLogs();}

// ---- slow refresh: devices, models, logs -------------------------------------------------
let devs=[],models=null,logs=null;
async function refreshSlow(){
 try{const d=await api('/api/devices');devs=d.devices||[];renderDevices();}catch(e){}
 try{models=await api('/api/models');renderModels();}catch(e){}
 try{logs=await api('/api/logs');const acts=[];for(const [k,v] of Object.entries(logs.actions||{}))acts.push([LABEL[k]||k,v.result+', '+ago(v.at),v.result==='failed'?'bad':'']);
  acts.sort();kv($('acts'),acts.length?acts:[['Last actions','none yet']]);renderLogs();}catch(e){}}
function renderDevices(){const box=$('devices');box.replaceChildren();const on={};((lastState.gateway||{}).devices||[]).forEach(d=>{on[d.id]=d;});
 if(!devs.length){box.append(el('div','No paired devices yet. Open the pairing window, then pair from the app with the code on the server\'s screen.','note'));return;}
 devs.forEach(x=>{const it=el('div',undefined,'item'),hd=el('div',undefined,'hd'),g=on[x.id];
  const nm=el('span',undefined,'nm row');nm.append(el('span',undefined,'dot '+(g&&g.connected?'ok':'')),el('span',x.name));hd.append(nm);
  const b=el('button','Remove','danger small');b.type='button';b.addEventListener('click',async()=>{if(await ask({title:'Unpair '+x.name+'?',body:['Unpair '+x.name+'? It will need to pair again at the server.'],ok:'Remove',danger:true}))act('remove-device',x.id,undefined,b);});
  hd.append(b);it.append(hd,el('div','id '+x.id+'  ·  paired '+(x.paired_at||'').slice(0,16).replace('T',' ')+(g?'  ·  '+(g.active?g.active+' running':g.connected?'connected':'last seen '+ago(g.last_seen)):''),'note mono'));box.append(it);});}
function renderModels(){const m=models;if(!m)return;const rows=[];
 m.installed.forEach(x=>{const b=el('button','Remove','danger small');b.type='button';
  b.addEventListener('click',async()=>{const c=await ask({title:'Remove '+x.name+'?',body:['This deletes the model from the server\'s disk. Download it again from the allow-list to get it back.'],typed:x.name,typedLabel:'Type the model name to remove it: '+x.name,ok:'Remove model',danger:true});
   if(c===x.name)act('remove-model',x.hash,c,b);});
  const a=m.allow.find(a=>a.name===x.name);rows.push([el('span',x.name,'mono'),gib(x.size),a?(a.ram?'allow-listed, may use system memory':'allow-listed, GPU only'):'installed by hand, GPU only',b]);});
 m.allow.filter(a=>!a.installed).forEach(a=>{const b=el('button','Pull','small');b.type='button';b.addEventListener('click',()=>act('pull',a.hash,undefined,b));rows.push([el('span',a.name,'mono'),'-','allow-listed'+(a.ram?', may use system memory':'')+', not installed',b]);});
 (m.allow_errors||[]).forEach(e=>rows.push(['line '+e.line+': '+e.text,'-','ignored: '+e.reason,'']));
 table($('models'),['Model','Size','',''],rows);const p=m.pull,pe=$('pull');pe.replaceChildren();
 if(p&&p.model){pe.append(el('div','Pull '+p.model+': '+p.status+(p.total?' '+Math.round(100*p.completed/p.total)+'%':'')));if(p.total)pe.append(bar(p.completed/p.total));}
 // the last model set from the app (6b410): one line, as text
 const lp=m.last_plan,pl=$('planline');pl.hidden=!lp;
 if(lp)pl.textContent='Last change: '+lp.plan.charAt(0).toUpperCase()+lp.plan.slice(1)+' from '+(lp.by||'a paired device')+', '+stamp(lp.at)+': +'+lp.added+' -'+lp.removed
  +(lp.state==='running'?' (in progress)':lp.state==='interrupted'?' (stopped before it finished)':lp.failed?' ('+lp.failed+' failed)':'');}

// --- model library: preview, then exactly that ---
let libWant=0,libState=null;
$('libbtn').addEventListener('click',()=>{libWant=Date.now()/1000-2;act('library-preview',undefined,undefined,$('libbtn'));$('libmsg').textContent='Checking the registry...';});
function eta(s){if(s==null)return '';return s<60?'less than a minute left':'about '+Math.ceil(s/60)+' min left';}
async function refreshLib(){let l;try{l=await api('/api/library');}catch(e){return;}libState=l;
 const box=$('lib'),p=l.preview,sy=l.sync||{};box.replaceChildren();$('libbtn').disabled=sy.state==='running';
 if(LOG.tab==='library')renderLogs();
 if(sy.state==='running'){const e=sy.event||{};$('libmsg').textContent='Syncing...';
  if(e.phase!=='remove'&&e.model_total!=null){box.append(el('div',(e.phase==='update'?'Updating ':'Downloading ')+e.index+' of '+e.count+': '+e.name+'  ·  '+gib(e.model_done)+' of '+gib(e.model_total)+(e.attempt>1?' (try '+e.attempt+' of 3)':''),'sub'),bar(e.model_total?e.model_done/e.model_total:0),
   el('div','All: '+Math.round(100*(e.overall||0))+'%'+(e.eta!=null?'  ·  '+eta(e.eta):''),'sub'),bar(e.overall||0,'violet'));}
  (sy.log||[]).slice(-6).forEach(x=>box.append(el('div',x,'note')));return;}
 if(sy.state==='done'&&sy.summary&&!libWant){const s=sy.summary;$('libmsg').textContent=sy.message||('Done '+ago(sy.at)+': removed '+(s.removed||[]).length+', downloaded '+(s.downloaded||[]).length+', updated '+(s.updated||[]).length+((s.failed||[]).length?', failed '+s.failed.length:''));
  (s.failed||[]).forEach(f=>box.append(el('div','failed: '+f.name+' ('+f.error+')','bad')));return;}
 if(sy.state==='failed'||sy.state==='changed'||sy.state==='refused')$('libmsg').textContent=sy.message||sy.state;
 if(libWant&&(!p||p.made_at<libWant)){$('libmsg').textContent=sy.state==='failed'&&sy.at>=libWant?'Could not check: '+sy.message:'Checking the registry...';return;}
 if(!p)return;
 if(libWant){$('libmsg').textContent='';}
 (p.allow_errors||[]).forEach(e=>box.append(el('div','Allow-list line '+e.line+' ignored ('+e.reason+'): '+e.text,'bad')));
 if((p.removals_blocked||[]).length)box.append(el('div','Not removing '+p.removals_blocked.map(x=>x.name).join(', ')+' while the allow-list has a line it can\'t read. Fix it at the server first.','warn'));
 const rows=[];p.remove.forEach(x=>rows.push([el('span','Remove','chip bad'),x.name,gib(x.bytes)]));p.download.forEach(x=>rows.push([el('span','Download','chip info'),x.name,gib(x.bytes)]));
 p.update.forEach(x=>rows.push([el('span','Update','chip ok'),x.name,gib(x.bytes)]));(p.unknown||[]).forEach(x=>rows.push(['?',x.name,x.why]));
 const t=el('table');table(t,['','Model','Size'],rows);const w=el('div',undefined,'tbl mt');w.append(t);box.append(w);const tt=p.totals;
 box.append(el('div','Download '+gib(tt.download_bytes+tt.update_bytes)+'  ·  free '+gib(tt.freed_bytes)+'  ·  disk free now '+tib(tt.free_now)+', after '+tib(tt.free_after),'sub'));
 const n=p.remove.length+p.download.length+p.update.length;
 if(!n){box.append(el('div','Nothing to change: the library matches the allow-list.','sub'));return;}
 if(!p.enough_space){box.append(el('div',tt.free_now==null?'Can\'t read the free disk space, so nothing will be done.':'Not enough disk space for this.','bad'));return;}
 const go=el('button','Apply these '+n+' changes','primary');go.type='button';go.classList.add('mt');go.addEventListener('click',async()=>{
  const body=['Remove '+p.remove.length+', download '+p.download.length+', update '+p.update.length+' model(s), exactly as listed?'];
  if(p.remove.length)body.push('Removing: '+p.remove.map(x=>x.name).join(', '));
  if((p.allow_errors||[]).length)body.push('The allow-list has '+p.allow_errors.length+' line(s) it can\'t read; models they name are kept.');
  if(await ask({title:'Apply the library changes?',body,ok:'Apply',danger:p.remove.length>0})){libWant=0;act('library-sync',p.id,p.id,go);}});
 box.append(go);}

// --- power and cost ---
