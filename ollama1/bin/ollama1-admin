#!/usr/bin/python3
"""ollama1-admin: the web admin panel, at <server-name>-admin.<your-domain>.

Bound to 127.0.0.1:8432; only cloudflared reaches it. Every request must
carry a valid Cloudflare Access JWT for the admin application whose email
is the configured admin email. Actions also need the CSRF token from the
page, a same-origin Origin header and a JSON body.

The panel can't run commands. Each button starts one fixed systemd unit;
polkit (50-ollama1.rules) lets this panel's user start those units and
nothing else. Units that take an argument get a hash or a device id,
which the root helper checks against its own lists.

/term/ is a proxy to ttyd (a UNIX socket only this panel's user can open) running `login`: a terminal
that still asks for the admin user's Linux password.
"""
import collections
import datetime
import hashlib
import hmac
import html
import http.client
import json
import os
import re
import secrets
import socket
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

import o1cpu  # noqa: E402
import o1fan  # noqa: E402
import o1gputune  # noqa: E402
import o1idle  # noqa: E402
import o1leds  # noqa: E402
import o1library  # noqa: E402
import o1modelplan  # noqa: E402
import o1ollama  # noqa: E402
import o1pair  # noqa: E402
import o1power  # noqa: E402
import o1sleep  # noqa: E402
import o1stats  # noqa: E402
import o1tariff  # noqa: E402
from o1common import (Paths, load_config, name_hash, parse_allow_list, read_allow_list, read_json,  # noqa: E402
                      read_json_safe, write_json_atomic)
from o1jwt import AccessVerifier, JWTError  # noqa: E402

FIXED_UNITS = {
    "update": "ollama1-update-now.service",
    "restart": "ollama1-restart.service",
    "reboot": "ollama1-reboot.service",
    "sleep": "ollama1-sleep.service",
    "pair": "ollama1-pair-window.service",
    "lan-on": "ollama1-lan-on.service",
    "lan-off": "ollama1-lan-off.service",
    "backup": "ollama1-backup.service",
    "library-preview": "ollama1-models-preview.service",
    "library-sync": "ollama1-models-sync.service",
    "power-apply": "ollama1-power-apply.service",
}
TEMPLATE_UNITS = {
    "remove-device": "ollama1-rmdevice@%s.service",
    "pull": "ollama1-pull@%s.service",
    "remove-model": "ollama1-rmmodel@%s.service",
    "sleep-config": "ollama1-sleepcfg@%s.service",       # %s: on-30 / off-60 (6b402)
}
SLEEP_WAIT_S = 8.0     # how long the answer to a sleep-setting change waits for the unit to say what it saved
HISTORY_COLS = 11     # t, tps, gpu busy, vram, gpu temp, gpu power, active, cpu temp, cpu GHz, cpu %, RAM GiB
HISTORY_FIELDS = ["t", "tps", "gpu_busy", "vram_gib", "gpu_temp", "power_w", "active", "cpu_temp", "cpu_ghz",
                  "cpu_pct", "ram_gib"]
TERM_OVERRIDE = {"x-frame-options", "content-security-policy", "cache-control", "referrer-policy",
                 "x-content-type-options"}


class UnixHTTPConnection(http.client.HTTPConnection):
    """HTTP to ttyd over its UNIX socket (no TCP port for the terminal)."""

    def __init__(self, path, timeout=30):
        super().__init__("localhost", timeout=timeout)
        self.unix_path = path

    def connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(self.timeout)
        s.connect(self.unix_path)
        self.sock = s


HOP = {"connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "te",
       "trailers", "transfer-encoding", "upgrade", "host", "content-length"}


def log(event, **fields):
    print(" ".join([event] + ["%s=%s" % (k, str(v).replace(" ", "_")[:64]) for k, v in fields.items()]),
          flush=True)


# ---- status files, cut down to known fields (6b398) -------------------------------
# The page draws the fan, lights, sleep and GPU-tuning cards from these. Each
# file is someone else's (root services write them), so only named fields of
# the expected type are passed on, strings are cut short, and the page puts
# every one of them in with textContent, never as markup.

def _num(v):
    return v if isinstance(v, (int, float)) and not isinstance(v, bool) and v == v and abs(v) < 1e12 else None


def _txt(v, n=160):
    return v[:n] if isinstance(v, str) else None


def _temp_row(t):
    if not isinstance(t, dict):
        return None
    return {"label": _txt(t.get("label"), 40), "c": _num(t.get("c")), "limit": _num(t.get("limit"))}


def clean_fan(st):
    """The fan service's status (/run/ollama1/fan.json, already checked for
    freshness by o1fan.read_status): phase, level, each output's rpm."""
    if not isinstance(st, dict):
        return None
    outs = []
    for o in (st.get("outputs") if isinstance(st.get("outputs"), list) else [])[:16]:
        if isinstance(o, dict):
            outs.append({"label": _txt(o.get("label"), 40), "rpm": _num(o.get("rpm")), "pwm": _num(o.get("pwm")),
                         "min_pct": _num(o.get("min_pct")), "note": _txt(o.get("note"), 120)})
    aio = st.get("aio") if isinstance(st.get("aio"), dict) else None
    return {"at": _num(st.get("at")), "phase": _txt(st.get("phase"), 16), "pct": _num(st.get("pct")),
            "why": _txt(st.get("why"), 120), "hold_left": _num(st.get("hold_left")), "outputs": outs,
            "temps": [r for r in (_temp_row(t) for t in (st.get("temps") if isinstance(st.get("temps"), list)
                                                          else [])[:16]) if r],
            "hottest": _temp_row(st.get("hottest")), "closest": _temp_row(st.get("closest")),
            "aio": {"name": _txt(aio.get("name"), 60), "pump_rpm": _num(aio.get("pump_rpm")),
                    "coolant_c": _num(aio.get("coolant_c"))} if aio and aio.get("found") else None}


def clean_leds(st):
    """The lights service's status (/run/ollama1/leds.json)."""
    if not isinstance(st, dict):
        return None
    rgb = st.get("rgb")
    rgb = [max(0, min(255, int(c))) for c in rgb] if isinstance(rgb, list) and len(rgb) == 3 and all(
        _num(c) is not None for c in rgb) else None
    devs = st.get("devices") if isinstance(st.get("devices"), list) else []
    return {"at": _num(st.get("at")), "state": _txt(st.get("state"), 16), "target": _txt(st.get("target"), 16),
            "rgb": rgb, "why": _txt(st.get("why"), 120), "connected": st.get("connected") is True,
            "error": _txt(st.get("error"), 160), "devices": len(devs),
            "names": [_txt(d.get("name"), 60) for d in devs[:8] if isinstance(d, dict) and isinstance(d.get("name"), str)]}


def clean_idle(st, now):
    """The idle service's last decision (/run/ollama1/idle.json, 6b396):
    the setting, sleep_ok, its exact reason and the idle seconds it counted,
    plus the file's age in seconds by the server's own clock (so the page's
    "Sleeps in mm:ss" never depends on the browser's clock)."""
    if not isinstance(st, dict) or _num(st.get("at")) is None:
        return None
    return {"at": st["at"], "age_s": round(now - st["at"], 1),
            "enabled": st.get("enabled") if isinstance(st.get("enabled"), bool) else None,
            "minutes": _num(st.get("minutes")),
            "supported": st.get("supported") if isinstance(st.get("supported"), bool) else None,
            "sleep_ok": st.get("sleep_ok") if isinstance(st.get("sleep_ok"), bool) else None,
            "reason": _txt(st.get("reason"), 160), "idle_s": _num(st.get("idle_s")),
            "wake_cards": len(st["wake"]) if isinstance(st.get("wake"), list) else 0}


def clean_gpu_tune(st):
    """The GPU tuner's saved state (/var/lib/ollama1/gpu-tune.json): what was
    asked, what is applied, and the last check's verdict."""
    if not isinstance(st, dict) or not st:
        return None
    ap = st.get("applied") if isinstance(st.get("applied"), dict) else {}
    stock = st.get("stock") if isinstance(st.get("stock"), dict) else {}
    chk = st.get("check") if isinstance(st.get("check"), dict) else {}
    watts = (lambda uw: round(uw / 1e6) if _num(uw) else None)
    return {"wanted": _txt(st.get("wanted"), 8), "reverted": _txt(st.get("reverted"), 200),
            "reverted_at": _num(st.get("reverted_at")),
            "applied": {"power_w": watts(ap.get("power_uw")), "mclk": _num(ap.get("mclk")), "at": _num(ap.get("at"))},
            "stock": {"power_w": watts(stock.get("power_uw")), "mclk": _num(stock.get("mclk"))},
            "check": {"result": _txt(chk.get("result"), 20), "note": _txt(chk.get("note"), 300),
                      "at": _num(chk.get("at")), "tps": _num(chk.get("tps"))} if chk else None}


def clean_sleepres(res):
    """What the last change from this panel did (/run/ollama1/stats/sleepcfg.json,
    written by ollama1-sleepcfg as the gateway's user): the request, whether the
    file read back as asked, and what it held."""
    if not isinstance(res, dict) or _num(res.get("at")) is None:
        return None
    return {"req": _txt(res.get("req"), 16), "at": res["at"], "ok": res.get("ok") is True,
            "enabled": res.get("enabled") if isinstance(res.get("enabled"), bool) else None,
            "minutes": _num(res.get("minutes")), "error": _txt(res.get("error"), 160)}


def effective_sleep_setting(idle, res):
    """The setting as best the panel can know it. The file itself is the
    gateway's (0700 folder), so two witnesses: the idle service's tick, which
    re-reads it every 30 s (whatever the app or this page set last), and the
    read-back of this page's own last change. The newer one wins, so a change
    from the app shows within a tick and one from this page at once."""
    best = None
    if idle and isinstance(idle.get("enabled"), bool) and _num(idle.get("minutes")) is not None:
        best = {"enabled": idle["enabled"], "minutes": idle["minutes"], "at": idle["at"], "source": "idle service"}
    if res and res.get("ok") and isinstance(res.get("enabled"), bool) and res.get("minutes") is not None:
        if best is None or res["at"] > best["at"]:
            best = {"enabled": res["enabled"], "minutes": res["minutes"], "at": res["at"], "source": "this page"}
    return best


def clean_modelplan(st):
    """The last model set from the app (6b410), for the Models card's one
    line: the set, the device, when, how many added and removed, whether it
    is still running or was cut short, how many jobs failed. From
    o1modelplan.read_status(), already cut down to known fields."""
    if not isinstance(st, dict) or not st.get("plan"):
        return None
    jobs = st.get("jobs") or []
    return {"plan": st["plan"]["name"], "by": st["plan"]["by"], "at": st["plan"]["at"],
            "added": len(st.get("add") or []), "removed": len(st.get("remove") or []), "state": st.get("state"),
            "failed": sum(1 for j in jobs if j.get("state") == "failed")}


def json_bytes(obj):
    """JSON with <, > and & as \\u escapes: the same data to any JSON reader,
    and never markup to anything that sniffs it (6b398)."""
    return json.dumps(obj).replace("<", "\\u003c").replace(">", "\\u003e").replace("&", "\\u0026").encode()


def start_unit(unit):
    """The only way the panel acts: `systemctl start` of a named unit."""
    r = subprocess.run(["systemctl", "start", "--no-block", unit], capture_output=True, text=True,
                       timeout=15)
    return r.returncode == 0, (r.stderr or "").strip()[:200]


class Panel:
    def __init__(self, cfg, runner=start_unit, clock=time.time):
        self.cfg = cfg
        self.runner = runner
        self.clock = clock
        self.access = AccessVerifier(cfg["access_team_domain"], cfg["admin_aud"],
                                     cfg.get("certs_url") or "",
                                     bool(cfg.get("allow_insecure_certs_url")), clock=clock)
        self.secret = secrets.token_bytes(32)
        self.origin = "https://" + cfg["hostname_admin"].lower()
        self.cpu = o1stats.CPU()
        self.cpu.sample()
        self.cpuprobe = o1cpu.CpuProbe()
        self.history = collections.deque(maxlen=24 * 360)
        h = read_json(Paths.history, {}) or {}
        for row in h.get("rows", []) if isinstance(h, dict) else []:
            if isinstance(row, list) and len(row) in (7, 9, HISTORY_COLS) and self.clock() - row[0] < 86400:
                self.history.append(row + [None] * (HISTORY_COLS - len(row)))   # older files have 7 or 9 columns
        self.state_cache = (0, None)
        self.power_cache = (0, None, None)
        self.busy = o1sleep.busy_reasons
        self.sleep_wait_s = SLEEP_WAIT_S
        self.nap = time.sleep
        self.lock = threading.Lock()

    # -- auth -----------------------------------------------------------
    def identify(self, headers):
        """The admin's email, or raises JWTError."""
        want = (self.cfg.get("admin_email") or "").strip().lower()
        if not want or not self.access.configured:
            raise JWTError("admin access is not configured")
        host = (headers.get("Host") or "").split(":")[0].lower()
        if host != self.cfg["hostname_admin"].lower():
            raise JWTError("wrong host")
        claims = self.access.verify(headers.get("Cf-Access-Jwt-Assertion") or "")
        email = str(claims.get("email") or "").strip().lower()
        if not email or not hmac.compare_digest(email.encode(), want.encode()):
            raise JWTError("not the admin")
        return email

    def csrf(self, email):
        return hmac.new(self.secret, b"csrf\n" + email.encode(), hashlib.sha256).hexdigest()

    def check_csrf(self, headers, email):
        if (headers.get("Content-Type") or "").split(";")[0].strip() != "application/json":
            return "JSON only"
        if (headers.get("Origin") or "").lower() != self.origin:
            return "cross-origin request"
        sfs = headers.get("Sec-Fetch-Site")
        if sfs and sfs != "same-origin":
            return "cross-site request"
        tok = headers.get("X-O1-CSRF") or ""
        if not hmac.compare_digest(tok.encode(), self.csrf(email).encode()):
            return "bad CSRF token"
        return None

    # -- data -----------------------------------------------------------
    def state(self):
        now = self.clock()
        with self.lock:
            if self.state_cache[1] is not None and now - self.state_cache[0] < 1.5:
                return self.state_cache[1]
            st = o1stats.collect(self.cpu, int(self.cfg["tunnel_metrics_port"]))
            st["pairing_open"] = bool((st.get("gateway") or {}).get("pairing_open")) or \
                bool(o1pair.read_public())
            st["lan_mode"] = bool(self.cfg.get("lan_mode"))
            try:
                st["cpu"] = self.cpuprobe.snapshot()
            except Exception as e:           # a CPU reading never takes the panel's data down
                log("cpu-probe-error", kind=type(e).__name__)
                st["cpu"] = None
            try:
                st["fan"] = o1fan.panel_line()           # one line from the fan service's status file, or None
            except Exception:
                st["fan"] = None
            try:
                st["leds"] = o1leds.panel_line()         # the same from the lights service's status file
            except Exception:
                st["leds"] = None
            # the graphical page's fan, lights, sleep and GPU-tuning cards (6b398): known fields only
            for key, read in (("fan_status", lambda: clean_fan(o1fan.read_status())),
                              ("leds_status", lambda: clean_leds(o1leds.read_status())),
                              ("idle", lambda: clean_idle(read_json_safe(os.path.join(Paths.run, "idle.json"), None,
                                                                         max_bytes=8192), now)),
                              ("gpu_tune", lambda: clean_gpu_tune(o1gputune.read_state()))):
                try:
                    st[key] = read()
                except Exception:
                    st[key] = None
            try:
                st["sleepcfg"] = clean_sleepres(read_json_safe(o1idle.sleepcfg_result_file(), None, max_bytes=4096))
            except Exception:
                st["sleepcfg"] = None
            st["sleep_setting"] = effective_sleep_setting(st.get("idle"), st["sleepcfg"])
            self.state_cache = (now, st)
            return st

    def sample(self):
        st = self.state()
        g = st.get("gpu") or {}
        gw = st.get("gateway") or {}
        temps = g.get("temps") or {}
        cpu = st.get("cpu") or {}
        ghz = (cpu.get("freq") or {}).get("avg_mhz")
        mem = st.get("memory") or {}
        util = cpu.get("util_pct") if isinstance(cpu.get("util_pct"), (int, float)) else st.get("cpu_pct")
        row = [int(self.clock()), (gw.get("tps") or {}).get("current", 0), g.get("busy_pct"),
               round((g.get("vram_used") or 0) / 2**30, 2), temps.get("junction", temps.get("edge")),
               g.get("power_w"), gw.get("active", 0),
               (cpu.get("temp") or {}).get("c"), round(ghz / 1000.0, 2) if ghz else None,
               round(util, 1) if isinstance(util, (int, float)) else None,
               round(mem["used"] / 2**30, 2) if mem.get("total") else None]
        self.history.append(row)

    def save_history(self):
        write_json_atomic(Paths.history, {"rows": list(self.history)}, mode=0o600)

    def models(self):
        installed = []
        try:
            st, data = o1ollama.call(self.cfg["ollama_url"], "GET", "/api/tags", timeout=5)
            for m in (data or {}).get("models", []) if st == 200 else []:
                if not o1ollama.is_remote(m):
                    installed.append({"name": m["name"], "size": m.get("size"), "hash": name_hash(m["name"]),
                                      "modified_at": m.get("modified_at")})
        except OSError:
            pass
        names = {m["name"] for m in installed}
        entries, errors = parse_allow_list()
        allow = [{"name": e["name"], "ram": e["ram"], "hash": name_hash(e["name"]),
                  "installed": e["name"] in names or (e["name"] + ":latest") in names}
                 for e in entries]
        try:
            last_plan = clean_modelplan(o1modelplan.read_status())
        except Exception:                # the line is extra: it never takes the models card down
            last_plan = None
        return {"installed": installed, "allow": allow, "allow_errors": errors,
                "pull": read_json(Paths.pull_status), "last_plan": last_plan}

    def power(self):
        """Watts, kWh and cost; recomputed at most every 15 s, or at once
        after the prices change."""
        now = self.clock()
        sched = o1power.load_schedule()
        sid = o1tariff.schedule_id(sched)
        with self.lock:
            t, cached_sid, val = self.power_cache
            if val is not None and cached_sid == sid and now - t < 15:
                return val
        val = o1power.summary(now, sched)
        year = datetime.datetime.fromtimestamp(now, o1tariff.ZoneInfo(sched["timezone"])).year
        tf = o1tariff.Tariff(sched)
        val["schedule"] = sched
        val["holidays_this_year"] = sorted(
            [d.isoformat(), n] for d, n in (o1tariff.holiday_dates(year, sched["holidays"]["names"],
                                                                   sched["holidays"]["observed"]).items()
                                            if sched["holidays"]["enabled"] else []))
        val["options"] = {"holiday_names": o1tariff.HOLIDAY_NAMES, "federal": list(o1tariff.FEDERAL),
                          "presets": {k: {"label": v[0], "schedule": o1tariff.preset(k, sched)}
                                      for k, v in o1tariff.PRESETS.items()},
                          "tiers": o1tariff.TIER_LABEL}
        val["tz_now"] = tf.local(now).strftime("%a %H:%M %Z")
        with self.lock:
            self.power_cache = (now, sid, val)
        return val

    def save_schedule(self, obj):
        """Checked here for the answer, then handed to root: the panel leaves
        it in its own folder and starts the fixed apply unit, which checks it
        again and writes root's tariff file."""
        clean, errs = o1tariff.validate(obj)
        if errs:
            return 400, {"errors": errs}
        write_json_atomic(o1power.request_file(), clean, mode=0o600)
        ok, err = self.runner(FIXED_UNITS["power-apply"])
        log("power-schedule", mode=clean["mode"], seasons=len(clean["seasons"]), ok=ok)
        if not ok:
            return 500, {"errors": ["could not start the apply step: %s" % err]}
        return 202, {"ok": True, "schedule_id": o1tariff.schedule_id(clean)}

    def save_sleep_config(self, obj):
        """Auto sleep, from the page (6b402). Exactly {"enabled": bool,
        "minutes": whole number 5..1440}, checked here and again by the unit.
        The panel can't write the gateway's file, so it starts
        ollama1-sleepcfg@<on|off>-<minutes>.service (the gateway's own user,
        the same write_config as /v1/sleep-config) and waits for that unit's
        read-back of the file; the answer is what it holds, never an
        assumption."""
        enabled, minutes = obj.get("enabled"), obj.get("minutes")
        errs = []
        if set(obj) != {"enabled", "minutes"}:
            errs.append("send exactly enabled and minutes")
        if not isinstance(enabled, bool):
            errs.append("enabled must be true or false")
        if not (isinstance(minutes, int) and not isinstance(minutes, bool)
                and o1idle.MIN_MINUTES <= minutes <= o1idle.MAX_MINUTES):
            errs.append("minutes must be a whole number from %d to %d" % (o1idle.MIN_MINUTES, o1idle.MAX_MINUTES))
        if errs:
            return 400, {"errors": errs}
        arg = o1idle.sleepcfg_arg(enabled, minutes)
        t0 = self.clock()
        ok, err = self.runner(TEMPLATE_UNITS["sleep-config"] % arg)
        log("sleep-config", enabled=enabled, minutes=minutes, started=ok)
        if not ok:
            return 500, {"errors": ["could not start the change: %s" % err]}
        res = None
        end = time.monotonic() + self.sleep_wait_s
        while True:
            r = clean_sleepres(read_json_safe(o1idle.sleepcfg_result_file(), None, max_bytes=4096))
            if r and r["req"] == arg and r["at"] >= t0:
                res = r
                break
            if time.monotonic() >= end:
                break
            self.nap(0.1)
        with self.lock:
            self.state_cache = (0, None)
        if res is None:
            return 504, {"errors": ["the change was started but the server didn't say it was saved in time; "
                                    "look at the setting again"]}
        out = {"ok": res["ok"], "enabled": res["enabled"], "minutes": res["minutes"], "confirmed": True}
        if not res["ok"]:
            out["errors"] = [res["error"] or "not saved"]
            return 500, out
        return 200, out

    def library(self):
        return {"preview": o1library.read_preview(), "sync": read_json(o1library.status_file())}

    def library_sync_refusal(self, arg, confirm):
        """The sync unit carries out the preview the panel showed; start it
        only for that preview, confirmed, fresh, and with something to do."""
        p = o1library.read_preview()
        if p is None:
            return 409, "no current preview: press Update model library again"
        if arg != p["id"] or confirm != p["id"]:
            return 409, "the preview changed: look at it again"
        if not p.get("enough_space", False):
            return 409, "not enough disk space for this"
        if o1library.nothing_to_do(p):
            return 409, "nothing to do"
        if o1sleep.setup_running(o1library.lock_file()):
            return 409, "a sync is already running"
        return None

    def action(self, obj):
        act = obj.get("action")
        arg = obj.get("arg")
        if not isinstance(act, str) or not (arg is None or isinstance(arg, str)):
            return 400, "unknown action"
        if act in FIXED_UNITS:
            if act == "reboot" and obj.get("confirm") != "reboot":
                return 400, "confirm the reboot"
            if act == "library-sync":
                bad = self.library_sync_refusal(arg, obj.get("confirm"))
                if bad:
                    return bad
            if act == "sleep":
                if obj.get("confirm") != "sleep":
                    return 400, "confirm the sleep"
                reasons = self.busy()
                if reasons:
                    return 409, "not now: " + "; ".join(reasons)
            unit = FIXED_UNITS[act]
        elif act == "remove-device":
            ids = {d["id"] for d in o1pair.devices_list()}
            if not isinstance(arg, str) or not re.match(r"^[0-9a-f]{16}$", arg) or arg not in ids:
                return 400, "no such device"
            unit = TEMPLATE_UNITS[act] % arg
        elif act == "pull":
            allowed = {name_hash(n): n for n in read_allow_list()}
            if arg not in allowed:
                return 403, "not on the allow-list"
            if o1modelplan.plan_running():
                return 409, "not now: a model set from the app is being applied"
            unit = TEMPLATE_UNITS[act] % arg
        elif act == "remove-model":
            names = {m["hash"]: m["name"] for m in self.models()["installed"]}
            if arg not in names or obj.get("confirm") != names[arg]:
                return 400, "no such model, or not confirmed"
            if o1modelplan.plan_running():
                return 409, "not now: a model set from the app is being applied"
            unit = TEMPLATE_UNITS[act] % arg
        else:
            return 400, "unknown action"
        ok, err = self.runner(unit)
        log("action", action=act, unit=unit, ok=ok)
        return (202, "started") if ok else (500, "could not start %s: %s" % (unit, err))

    def logs(self):
        gw = o1stats.gateway_snapshot() or {}
        return {"recent": gw.get("recent", []), "per_minute": gw.get("per_minute", []),
                "totals": gw.get("totals", {}), "auth_failures": gw.get("auth_failures", {}),
                "events": gw.get("events", []), "errors": gw.get("errors", {}),
                "actions": read_json(Paths.helper_status, {}) or {},
                "ollama_update": read_json(Paths.update_status, {}) or {}}


def make_handler(panel):
    cfg = panel.cfg

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "ollama1-admin"
        sys_version = ""

        def log_message(self, fmt, *args):
            pass

        def send(self, status, body, ctype="application/json", extra=None):
            raw = body if isinstance(body, bytes) else (
                json_bytes(body) if ctype == "application/json" else body.encode())
            self.send_response(status)
            self.send_header("Content-Type", ctype + ("; charset=utf-8" if ctype.startswith("text/") else ""))
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("X-Frame-Options", "DENY")
            self.send_header("Referrer-Policy", "no-referrer")
            if status >= 400:
                # an unread body must never be taken as the next request on
                # a connection cloudflared reuses: close after every error
                self.send_header("Connection", "close")
                self.close_connection = True
            for k, v in (extra or {}).items():
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(raw)

        def auth(self):
            try:
                return panel.identify(self.headers)
            except JWTError as e:
                log("denied", reason=str(e))
                self.send(403, "Not allowed.\n", "text/plain")
                return None

        def do_GET(self):
            email = self.auth()
            if email is None:
                return
            path = self.path.split("?", 1)[0]
            if path == "/term" or path.startswith("/term/"):
                return self.proxy_term(email)
            if path == "/":
                nonce = secrets.token_urlsafe(16)
                page = PAGE.replace("{{CSRF}}", panel.csrf(email)).replace("{{NONCE}}", nonce) \
                    .replace("{{EMAIL}}", html.escape(email)).replace("{{NAME}}", html.escape(cfg.get("server_name") or "")).replace("{{HOST}}", html.escape(cfg["hostname_gateway"]))
                # nothing loads from anywhere else; the one script and the one style block carry this
                # request's nonce; the page builds no markup from strings (Trusted Types, 6b398)
                csp = ("default-src 'none'; script-src 'nonce-%s'; style-src 'nonce-%s'; "
                       "connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; "
                       "base-uri 'none'; form-action 'none'; require-trusted-types-for 'script'; "
                       "trusted-types 'none'" % (nonce, nonce))
                return self.send(200, page, "text/html", {"Content-Security-Policy": csp})
            if path == "/api/state":
                return self.send(200, panel.state())
            if path == "/api/history":
                return self.send(200, {"rows": list(panel.history), "fields": HISTORY_FIELDS})
            if path == "/api/devices":
                return self.send(200, {"devices": o1pair.devices_list()})
            if path == "/api/models":
                return self.send(200, panel.models())
            if path == "/api/library":
                return self.send(200, panel.library())
            if path == "/api/power":
                return self.send(200, panel.power())
            if path == "/api/power/schedule.json":
                raw = (json.dumps(o1power.load_schedule(), indent=2) + "\n").encode()
                return self.send(200, raw, "application/json",
                                 {"Content-Disposition": 'attachment; filename="ollama1-prices.json"'})
            if path == "/api/logs":
                return self.send(200, panel.logs())
            if path == "/api/sleep-config":
                st = panel.state()
                return self.send(200, {"setting": st.get("sleep_setting"), "last_change": st.get("sleepcfg"),
                                       "decision": st.get("idle")})
            self.send(404, {"error": "not found"})

        def do_POST(self):
            email = self.auth()
            if email is None:
                return
            try:
                n = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                n = -1
            path = self.path.split("?", 1)[0]
            if path not in ("/api/action", "/api/power/schedule", "/api/sleep-config"):
                return self.send(404, {"error": "not found"})
            if n < 0 or n > (65536 if path == "/api/power/schedule" else 4096):
                return self.send(413, {"error": "too large"})
            body = self.rfile.read(n)
            bad = panel.check_csrf(self.headers, email)
            if bad:
                log("csrf-refused", reason=bad)
                return self.send(403, {"error": bad})
            try:
                obj = json.loads(body.decode())
                assert isinstance(obj, dict)
            except (ValueError, AssertionError, UnicodeDecodeError):
                return self.send(400, {"error": "bad JSON"})
            if path == "/api/power/schedule":
                try:
                    status, out = panel.save_schedule(obj)
                except Exception as e:
                    log("power-error", kind=type(e).__name__)
                    status, out = 500, {"errors": ["internal error"]}
                return self.send(status, out)
            if path == "/api/sleep-config":
                try:
                    status, out = panel.save_sleep_config(obj)
                except Exception as e:
                    log("sleep-config-error", kind=type(e).__name__)
                    status, out = 500, {"errors": ["internal error"]}
                return self.send(status, out)
            try:
                status, msg = panel.action(obj)
            except Exception as e:
                log("action-error", kind=type(e).__name__)
                status, msg = 500, "internal error"
            self.send(status, {"result": msg})

        # -- the web terminal (ttyd, on a UNIX socket) -------------------
        def proxy_term(self, email):
            upgrade = (self.headers.get("Upgrade") or "").lower() == "websocket"
            if upgrade and (self.headers.get("Origin") or "").lower() != panel.origin:
                return self.send(403, "Not allowed.\n", "text/plain")
            sock_path = cfg["ttyd_socket"]
            if not upgrade:
                conn = UnixHTTPConnection(sock_path, timeout=30)
                try:
                    hdrs = {k: v for k, v in self.headers.items()
                            if k.lower() not in HOP and not k.lower().startswith("cf-")}
                    hdrs["Host"] = self.headers.get("Host", "")
                    conn.request("GET", self.path, headers=hdrs)
                    r = conn.getresponse()
                    data = r.read()
                    self.send_response(r.status)
                    for k, v in r.getheaders():
                        if k.lower() not in HOP and k.lower() not in TERM_OVERRIDE:
                            self.send_header(k, v)
                    self.send_header("X-Frame-Options", "DENY")
                    self.send_header("Content-Security-Policy", "frame-ancestors 'none'; base-uri 'none'; form-action 'none'")
                    self.send_header("X-Content-Type-Options", "nosniff")
                    self.send_header("Referrer-Policy", "no-referrer")
                    self.send_header("Cache-Control", "no-store")
                    self.send_header("Content-Length", str(len(data)))
                    self.end_headers()
                    self.wfile.write(data)
                except OSError:
                    self.send(502, "The terminal service is not running.\n", "text/plain")
                finally:
                    conn.close()
                return
            try:
                up = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                up.settimeout(10)
                up.connect(sock_path)
            except OSError:
                return self.send(502, "The terminal service is not running.\n", "text/plain")
            lines = ["GET %s HTTP/1.1" % self.path]
            for k, v in self.headers.items():
                if not k.lower().startswith("cf-"):
                    lines.append("%s: %s" % (k, v))
            up.sendall(("\r\n".join(lines) + "\r\n\r\n").encode("latin-1"))
            up.settimeout(None)
            self.connection.settimeout(None)
            log("terminal-open")
            self.close_connection = True

            def pump_up():
                try:
                    while True:
                        b = self.rfile.read1(65536)
                        if not b:
                            break
                        up.sendall(b)
                except OSError:
                    pass
                finally:
                    try:
                        up.shutdown(socket.SHUT_WR)
                    except OSError:
                        pass

            t = threading.Thread(target=pump_up, daemon=True)
            t.start()
            try:
                while True:
                    b = up.recv(65536)
                    if not b:
                        break
                    self.wfile.write(b)
            except OSError:
                pass
            finally:
                up.close()
                log("terminal-closed")

    return Handler


def sampler(panel, stop):
    n = 0
    while not stop.is_set():
        try:
            panel.sample()
            if n % 30 == 0:
                panel.save_history()
        except Exception as e:
            log("sample-error", kind=type(e).__name__)
        n += 1
        stop.wait(10)


def serve(cfg, runner=start_unit):
    panel = Panel(cfg, runner)
    if not panel.access.configured or not cfg.get("admin_email"):
        log("warning", reason="admin_access_not_configured_all_requests_refused")
    srv = ThreadingHTTPServer(("127.0.0.1", int(cfg["admin_port"])), make_handler(panel))
    srv.daemon_threads = True
    stop = threading.Event()
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    threading.Thread(target=sampler, args=(panel, stop), daemon=True).start()
    log("started", port=cfg["admin_port"])
    return panel, srv, stop


