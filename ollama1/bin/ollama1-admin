// money is whole cents, always two digits; an amount under half a cent says so instead of showing $0.00
const money=(v,sym)=>{if(v==null)return '-';const c=Math.round(Math.abs(v)*100);if(v>0&&c===0)return '<'+sym+'0.01';return (v<0?'-':'')+sym+(c/100).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});};
const TIERN={on:'On-peak',mid:'Mid-peak',off:'Off-peak',discount:'Discount',flat:'Flat'};
function pchart(series){const svg=$('pchart');svg.replaceChildren();const W=360,H=90,now=Date.now()/1000;
 const pts=(series||[]).filter(p=>p[0]>=now-3600&&p[1]!=null);if(pts.length<2){const t=sv('text',{x:W/2,y:H/2,'text-anchor':'middle','font-size':11,fill:'var(--muted)'});t.textContent='No data yet';svg.append(t);return;}
 let max=Math.max(...pts.map(p=>p[1]))*1.15||1;const x=t=>(t-(now-3600))/3600*W,y=v=>H-4-(v/max)*(H-8);
 let d='',prev=null;for(const p of pts){d+=(prev&&p[0]-prev>40?'M':(d?'L':'M'))+x(p[0]).toFixed(1)+' '+y(p[1]).toFixed(1);prev=p[0];}
 svg.append(sv('path',{d,fill:'none',stroke:'var(--series)','stroke-width':2,'vector-effect':'non-scaling-stroke'}));
 const t=sv('text',{x:4,y:12,'font-size':10,fill:'var(--muted)'});t.textContent=Math.round(max/1.15)+' W peak';svg.append(t);}
function renderPower(){const s=pw,sym=s.symbol,live=s.live;
 $('pw').textContent=live?Math.round(live.watts)+' W':'-';
 if(!live)$('pwsrc').textContent='No reading: is ollama1-power.service running?';
 else if(live.src==='plug')$('pwsrc').textContent='Smart plug ('+live.plug.type+')';
 else $('pwsrc').textContent='Estimate: GPU '+(live.gpu_w??'?')+' W + CPU '+(live.cpu_w??'?')+' W + '+live.baseline_w+' W for the rest, at '+Math.round(live.psu_efficiency*100)+'% PSU efficiency'+(live.plug&&live.plug.configured&&!live.plug.ok?'. Smart plug not answering ('+live.plug.error+')':'');
 const b=s.badge;$('pbadge').textContent=b.text.charAt(0).toUpperCase()+b.text.slice(1)+(b.price!=null?'  ·  '+sym+b.price.toFixed(4)+'/kWh':'');
 $('pbadge').className='chip '+(b.tier==='on'?'bad':b.tier==='mid'?'warn':b.tier==='discount'?'ok':'');
 pchart(live&&live.series);
 const rows=[['Last hour','1h'],['Last 24 h','1d'],['Last 7 days','1w'],['Last 30 days','1m']].map(([lab,k])=>{const w=s.windows[k];
  const split=Object.entries(w.by_tier).filter(([t])=>t!=='flat').sort((a,b)=>b[1].kwh-a[1].kwh).map(([t,v])=>TIERN[t]+' '+v.kwh.toFixed(2)+' kWh'+(v.cost!=null?' '+money(v.cost,sym):'')).join(', ');
  const r=[lab,w.kwh.toFixed(3)+' kWh',s.priced?money(w.cost,sym):'set a price'];if(s.mode==='tou')r.push(split||'-');r.push(w.unknown_h>=0.1?w.unknown_h.toFixed(1)+' h':'');return r;});
 table($('ptable'),['','Energy','Cost'].concat(s.mode==='tou'?['By tier']:[],['Unknown']),rows);
 if(s.since&&s.since>Date.now()/1000-30*86400){const r=el('tr'),td=el('td','Measured since '+new Date(s.since*1000).toLocaleString()+'. Unknown = time with no reading (the server off, or the sampler stopped); it is never counted as zero.','note');td.colSpan=5;r.append(td);$('ptable').append(r);}
 const p=s.projection;$('pproj').textContent=p?'Next 30 days: about '+p.kwh.toFixed(0)+' kWh'+(p.cost!=null?', about '+money(p.cost,sym):'')+' (the average of each hour of the week over the last '+p.basis_days+' days, at '+Math.round(p.avg_w)+' W on average)':'Next 30 days: not enough data yet.';
 const m=s.windows['1m'];$('ptok').textContent=m.cost_per_1k_tokens!=null?'Cost per 1 million tokens: '+money(m.cost_per_1k_tokens*1000,sym)+' (all electricity in the last 30 days over '+m.tokens.toLocaleString()+' tokens generated)':'';}
function editorFrom(s){edit=JSON.parse(JSON.stringify(s));seasonIx=0;drawEditor();}
function inp(type,val,on,attrs){const e=document.createElement('input');e.type=type;if(type==='checkbox')e.checked=!!val;else e.value=val??'';for(const k in attrs||{})e.setAttribute(k,attrs[k]);e.addEventListener('change',()=>on(type==='checkbox'?e.checked:e.value));return e;}
function drawEditor(){const s=edit,o=pw.options;$('pcur').value=s.currency;
 document.querySelectorAll('input[name=pmode]').forEach(r=>r.checked=r.value===s.mode);
 $('pflat').style.display=s.mode==='flat'?'':'none';$('ptou').style.display=s.mode==='tou'?'':'none';
 $('pflatrate').value=s.flat_rate??'';$('ptz').value=s.timezone;$('pwknd').checked=s.weekends_off_peak;
 $('phol').checked=s.holidays.enabled;$('pobs').checked=s.holidays.observed;$('pholx').value=s.holidays.extra.join(', ');
 const tiers=$('ptiers');tiers.replaceChildren();for(const t of ['on','mid','off','discount']){const l=el('label',TIERN[t]+' ');
  l.append(inp('number',s.tiers[t],v=>{s.tiers[t]=v===''?null:+v;},{step:'0.0001',min:'0',max:'10',size:'7',placeholder:'unused'}));tiers.append(l);}
 const hn=$('pholnames');hn.replaceChildren();for(const [k,n] of Object.entries(o.holiday_names)){const l=el('label','');
  l.append(inp('checkbox',s.holidays.names.includes(k),v=>{s.holidays.names=Object.keys(o.holiday_names).filter(x=>x===k?v:s.holidays.names.includes(x));}),document.createTextNode(' '+n));hn.append(l);}
 const tabs=$('pseasontabs');tabs.replaceChildren(el('span','Seasons:','note'));
 s.seasons.forEach((se,i)=>{const b=el('button',se.name||('Season '+(i+1)));b.type='button';if(i===seasonIx)b.className='on';b.addEventListener('click',()=>{seasonIx=i;drawEditor();});tabs.append(b);});
 const add=el('button','+ Season');add.type='button';add.addEventListener('click',()=>{s.seasons.push({name:'Season '+(s.seasons.length+1),from:'01-01',to:'12-31',windows:[]});seasonIx=s.seasons.length-1;drawEditor();});tabs.append(add);
 const box=$('pseason');box.replaceChildren();const se=s.seasons[seasonIx];if(!se)return;
 const head=el('div',undefined,'row mt');const nm=el('label','Name ');nm.append(inp('text',se.name,v=>{se.name=v;drawEditor();},{size:'14',maxlength:'40'}));
 const fr=el('label','From (MM-DD) ');fr.append(inp('text',se.from,v=>{se.from=v;},{size:'6',placeholder:'05-01'}));
 const to=el('label','to ');to.append(inp('text',se.to,v=>{se.to=v;},{size:'6',placeholder:'09-30'}));
 const del=el('button','Remove season','danger');del.type='button';del.addEventListener('click',()=>{if(s.seasons.length>1){s.seasons.splice(seasonIx,1);seasonIx=0;drawEditor();}});
 head.append(nm,fr,to,del);box.append(head);
 const t=el('table');t.className='mt';const hr=el('tr');['Tier','Days','Start','End',''].forEach(h=>hr.append(el('th',h)));t.append(hr);
 se.windows.forEach((w,j)=>{const r=el('tr');const sel=document.createElement('select');for(const k of ['on','mid','discount','off']){const op=el('option',TIERN[k]);op.value=k;sel.append(op);}sel.value=w.tier;sel.addEventListener('change',()=>{w.tier=sel.value;});
  const days=document.createElement('select');for(const k of ['weekdays','weekends','every day','custom']){const op=el('option',k);op.value=k;days.append(op);}
  const custom=Array.isArray(w.days);days.value=custom?'custom':w.days;const cd=el('span','');
  const dn=['mon','tue','wed','thu','fri','sat','sun'];if(custom){dn.forEach(d=>{const l=el('label','');l.append(inp('checkbox',w.days.includes(d),v=>{w.days=dn.filter(x=>x===d?v:w.days.includes(x));}),document.createTextNode(d+' '));cd.append(l);});}
  days.addEventListener('change',()=>{w.days=days.value==='custom'?['mon','tue','wed','thu','fri']:days.value;drawEditor();});
  const dcell=el('td');dcell.append(days,cd);
  const st=inp('time',w.start,v=>{w.start=v;},{step:'60'}),en=inp('text',w.end,v=>{w.end=v;},{size:'5',placeholder:'21:00'});
  const x=el('button','Remove','danger');x.type='button';x.addEventListener('click',()=>{se.windows.splice(j,1);drawEditor();});
  [sel,dcell,st,en,x].forEach(c=>{if(c.tagName==='TD')r.append(c);else{const td=el('td');td.append(c);r.append(td);}});t.append(r);});
 box.append(t);const aw=el('button','+ Window');aw.type='button';aw.className='mt';aw.addEventListener('click',()=>{se.windows.push({tier:'on',days:'weekdays',start:'16:00',end:'21:00'});drawEditor();});box.append(aw);
 const pr=$('ppresets');pr.replaceChildren();for(const [k,v] of Object.entries(o.presets)){const b=el('button',v.label);b.type='button';b.addEventListener('click',()=>{const keep=edit;editorFrom(v.schedule);edit.tiers=keep.tiers;edit.currency=keep.currency;drawEditor();});pr.append(b);}}
function readEditor(){const s=edit;s.currency=$('pcur').value.trim().toUpperCase();
 s.mode=(document.querySelector('input[name=pmode]:checked')||{}).value||'flat';
 const fr=$('pflatrate').value;s.flat_rate=fr===''?null:+fr;s.timezone=$('ptz').value.trim();s.weekends_off_peak=$('pwknd').checked;
 s.holidays.enabled=$('phol').checked;s.holidays.observed=$('pobs').checked;
 s.holidays.extra=$('pholx').value.split(/[\s,]+/).filter(Boolean);return s;}
async function saveSchedule(obj){$('pmsg').textContent='Saving...';$('perr').replaceChildren();
 try{const r=await fetch('/api/power/schedule',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','X-O1-CSRF':CSRF},body:JSON.stringify(obj)});
  const j=await r.json();if(r.ok){$('pmsg').textContent='Saved.';edit=null;await new Promise(z=>setTimeout(z,1500));pw=null;await refreshPower(true);}
  else{$('pmsg').textContent='Not saved:';(j.errors||[j.error||'failed']).forEach(e=>$('perr').append(el('li',e)));}}catch(e){$('pmsg').textContent='Not saved ('+e.message+')';}}
document.querySelectorAll('input[name=pmode]').forEach(r=>r.addEventListener('change',()=>{readEditor();drawEditor();}));
$('psave').addEventListener('click',()=>saveSchedule(readEditor()));
$('pimport').addEventListener('change',async e=>{const f=e.target.files[0];e.target.value='';if(!f)return;
 let obj;try{obj=JSON.parse(await f.text());}catch(err){$('pmsg').textContent='That file isn\'t JSON.';return;}
 if(confirm('Replace the prices with '+f.name+'?'))saveSchedule(obj);});
async function refreshPower(force){try{pw=await api('/api/power');renderPower();if(!edit||force)editorFrom(pw.schedule);}catch(e){}}
refreshPower();setInterval(()=>{if(!$('pset').open)refreshPower();else api('/api/power').then(p=>{pw=p;renderPower();}).catch(()=>{});},10000);
// --- history charts: one series each, one axis each, crosshair + tooltip ---
let range=3600,hist={rows:[]};
const CH=[['Tokens per second',1,v=>v.toFixed(1)],['GPU busy (%)',2,v=>Math.round(v)+'%'],['VRAM used (GiB)',3,v=>v.toFixed(1)+' GiB'],
 ['GPU temperature (°C)',4,v=>Math.round(v)+'°C'],['GPU power (W)',5,v=>Math.round(v)+' W']];
const NS='http://www.w3.org/2000/svg';const sv=(t,a)=>{const e=document.createElementNS(NS,t);for(const k in a)e.setAttribute(k,a[k]);return e;};
function draw(){const box=$('charts');box.replaceChildren();const now=Date.now()/1000,rows=hist.rows.filter(r=>r[0]>=now-range);
 for(const [title,ix,fmt] of CH){const wrap=el('div',undefined,'chart');wrap.append(el('div',title,'sub'));
  const W=360,H=150,L=38,R=8,T=8,B=20;const svg=sv('svg',{viewBox:'0 0 '+W+' '+H,preserveAspectRatio:'none',role:'img','aria-label':title});
  const pts=rows.filter(r=>r[ix]!=null).map(r=>[r[0],r[ix]]);let max=Math.max(1,...pts.map(p=>p[1]));
  const nice=Math.pow(10,Math.floor(Math.log10(max)));max=Math.ceil(max/nice)*nice;
  const x=t=>L+(t-(now-range))/range*(W-L-R),y=v=>T+(1-v/max)*(H-T-B);
  for(let i=0;i<=2;i++){const v=max*i/2;svg.append(sv('line',{x1:L,x2:W-R,y1:y(v),y2:y(v),stroke:'var(--grid)','stroke-width':1}));
   const tx=sv('text',{x:L-4,y:y(v)+4,'text-anchor':'end','font-size':10,fill:'var(--muted)'});tx.textContent=Number.isInteger(v)?v:v.toFixed(1);svg.append(tx);}
  const lab=range===3600?['-60 min','-30 min','now']:['-24 h','-12 h','now'];[0,.5,1].forEach((f,i)=>{const tx=sv('text',{x:L+f*(W-L-R),y:H-5,'text-anchor':i===0?'start':i===2?'end':'middle','font-size':10,fill:'var(--muted)'});tx.textContent=lab[i];svg.append(tx);});
  if(pts.length>1){let d='';let prev=null;for(const p of pts){d+=(prev&&p[0]-prev>60?'M':(d?'L':'M'))+x(p[0]).toFixed(1)+' '+y(p[1]).toFixed(1);prev=p[0];}
   svg.append(sv('path',{d,fill:'none',stroke:'var(--series)','stroke-width':2,'stroke-linejoin':'round','vector-effect':'non-scaling-stroke'}));}
  else{const tx=sv('text',{x:W/2,y:H/2,'text-anchor':'middle','font-size':11,fill:'var(--muted)'});tx.textContent='No data yet';svg.append(tx);}
  const hair=sv('line',{y1:T,y2:H-B,stroke:'var(--ink2)','stroke-width':1,visibility:'hidden','vector-effect':'non-scaling-stroke'});svg.append(hair);
  const tip=el('div',undefined,'tip');wrap.append(svg,tip);
  svg.addEventListener('pointermove',e=>{if(!pts.length)return;const r=svg.getBoundingClientRect();const t=(now-range)+((e.clientX-r.left)/r.width*W-L)/(W-L-R)*range;
   let best=pts[0];for(const p of pts)if(Math.abs(p[0]-t)<Math.abs(best[0]-t))best=p;const px=x(best[0]);hair.setAttribute('x1',px);hair.setAttribute('x2',px);hair.setAttribute('visibility','visible');
   tip.replaceChildren(el('b',fmt(best[1])),document.createTextNode('  '+new Date(best[0]*1000).toLocaleTimeString()));tip.style.display='block';
   const left=px/W*r.width;tip.style.left=Math.min(left+8,r.width-tip.offsetWidth)+'px';tip.style.top='18px';});
  svg.addEventListener('pointerleave',()=>{hair.setAttribute('visibility','hidden');tip.style.display='none';});
  box.append(wrap);}}
document.querySelectorAll('button[data-range]').forEach(b=>b.addEventListener('click',()=>{range=+b.dataset.range;
 document.querySelectorAll('button[data-range]').forEach(x=>x.classList.toggle('on',x===b));draw();}));
async function refreshHist(){try{hist=await api('/api/history');draw();}catch(e){}}
refreshFast();refreshSlow();refreshHist();setInterval(refreshFast,2000);setInterval(refreshSlow,10000);setInterval(refreshHist,30000);
</script></body></html>
"""


def main():
    import argparse
    import signal
    ap = argparse.ArgumentParser(description="ollama1 admin panel")
    ap.add_argument("--config")
    a = ap.parse_args()
    cfg = load_config(a.config)
    panel, srv, stop = serve(cfg)
    done = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: done.set())
    signal.signal(signal.SIGINT, lambda *_: done.set())
    done.wait()
    stop.set()
    srv.shutdown()
    try:
        panel.save_history()
    except OSError:
        pass


if __name__ == "__main__":
    main()
