 if(t.applied.mclk||t.stock.mclk)pairs.push(['Memory clock',(t.applied.mclk?t.applied.mclk+' ('+t.applied.mclk*2+' MHz effective)':'stock')+(t.stock.mclk?'  ·  stock '+t.stock.mclk:'')]);
 if(t.applied.at)pairs.push(['Applied',ago(t.applied.at)]);
 if(t.check)pairs.push(['Last check',(t.check.result||'?')+(t.check.at?', '+ago(t.check.at):''),t.check.result==='passed'?'ok':t.check.result==='reverted'?'bad':'']);
