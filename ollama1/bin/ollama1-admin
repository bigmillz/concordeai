// ---- the CPU card (unchanged figures, new look) ---------------------------------------------
const fnum=(v,d)=>typeof v==='number'&&isFinite(v)?v.toFixed(d):null;
const ghz=m=>{const t=fnum(m==null?null:m/1000,2);return t==null?null:t+' GHz';};
const deg=v=>{const t=fnum(v,0);return t==null?null:t+' °C';};
function bars(id,vals,max,name,fmt,hot){const svg=$(id),box=svg.parentNode;svg.replaceChildren();
 const n=Math.min(vals.length,1024);if(!n||!vals.some(v=>v!=null)){box.hidden=true;return;}box.hidden=false;
 svg.setAttribute('viewBox','0 0 '+n*4+' 24');
 for(let i=0;i<n;i++){const v=vals[i],f=v==null||!(max>0)?0:Math.max(0,Math.min(1,v/max)),h=Math.max(f*24,v==null?0:1);
  const r=sv('rect',{x:i*4,y:24-h,width:3,height:h,rx:0.6,fill:hot&&f>0.85?'#fb923c':'url(#gr-cyan)'});
  if(n<=128){const t=sv('title',{});t.textContent=name+' '+i+': '+(v==null?'no reading':fmt(v));r.append(t);}svg.append(r);}}
function spark(id,boxId,ix,live,scale,minSpan){const svg=$(id),box=$(boxId);svg.replaceChildren();const now=snow();
 const pts=rows().filter(r=>r[0]>=now-300&&typeof r[ix]==='number').map(r=>[r[0],r[ix]*scale]);
 if(typeof live==='number')pts.push([now,live]);if(pts.length<2){box.hidden=true;return;}box.hidden=false;
 let lo=Math.min(...pts.map(p=>p[1])),hi=Math.max(...pts.map(p=>p[1]));if(hi-lo<minSpan){const m=(hi+lo)/2;lo=m-minSpan/2;hi=m+minSpan/2;}
 let d='';pts.forEach((p,i)=>{d+=(i?'L':'M')+((p[0]-(now-300))/300*200).toFixed(1)+' '+(42-(p[1]-lo)/(hi-lo)*38).toFixed(1);});
 svg.append(sv('path',{d:d+'L200 46L0 46Z',fill:'url(#fa-cyan)',stroke:'none'}));
 svg.append(sv('path',{d,fill:'none',stroke:'#2dd4ef','stroke-width':2,'stroke-linejoin':'round','vector-effect':'non-scaling-stroke'}));}
function renderCpu(c,s){c=c||{};const f=c.freq||{},t=c.temp,th=c.thresholds||{},warn=th.warn_c||80,hot=th.hot_c||90;
 $('cpumodel').textContent=c.model||'';
 const lim=f.max_mhz&&f.rated_mhz&&f.max_mhz<f.rated_mhz*0.98;
 $('cpuline').textContent=[c.cores?c.cores+' cores':null,c.threads?c.threads+' threads':null,c.driver,c.governor?'governor '+c.governor:null,
  f.min_mhz&&(f.max_mhz||f.rated_mhz)?ghz(f.min_mhz)+' to '+ghz(f.max_mhz||f.rated_mhz)+(lim?' (limit set; rated '+ghz(f.rated_mhz)+')':' (rated)'):null].filter(Boolean).join('  ·  ');
 const note=$('cpunote');note.hidden=!c.throttle;note.textContent=c.throttle?('Slower than it could be: '+c.throttle+'.'):'';
 const util=typeof c.util_pct==='number'?c.util_pct:s.cpu_pct;$('cpubusy').textContent=fnum(util,0)==null?'-':Math.round(util)+'%';
 $('cpubusysub').textContent=[(c.load||[]).length?'load '+c.load.map(x=>x.toFixed(2)).join(' '):null,c.running!=null&&c.tasks!=null?c.running+' running of '+c.tasks+' tasks':null].filter(Boolean).join('  ·  ');
 const sp=$('cpuspeedtile');sp.hidden=f.avg_mhz==null;$('cpuspeed').textContent=ghz(f.avg_mhz)||'-';
 $('cpuspeedsub').textContent=f.avg_mhz==null?'':'average  ·  highest '+(ghz(f.hi_mhz)||'?')+'  ·  lowest '+(ghz(f.lo_mhz)||'?');
 const tt=$('cputemptile');tt.hidden=!t;$('cputemp').textContent=t?(deg(t.c)||'-'):'-';
 $('cputemp').className='big'+(t&&t.c>=hot?' bad':t&&t.c>=warn?' warn':'');
 const others=t?Object.entries(t.sensors||{}).filter(([k])=>k!==t.label).slice(0,3).map(([k,v])=>k+' '+deg(v)):[];
 $('cputempsub').textContent=t?[t.label,'peak '+(deg(t.peak_c)||'?')+' since the panel started'].concat(others).join('  ·  '):'';
 const live=pw&&pw.live,w=typeof c.power_w==='number'?c.power_w:(live&&typeof live.cpu_w==='number'?live.cpu_w:null);
 $('cpuwtile').hidden=w==null;$('cpuw').textContent=w==null?'-':Math.round(w)+' W';$('cpuwsub').textContent=w==null?'':(typeof c.power_w==='number'?'package, measured':'package, from the power sampler');
 bars('cbars',c.util_cores||[],100,'Thread',v=>Math.round(v)+'%',true);
 bars('cfreq',f.cores||[],f.rated_mhz||f.max_mhz||Math.max(0,...(f.cores||[]).filter(v=>v!=null)),'Thread',v=>ghz(v));
 spark('ctempspark','cspark1',7,t&&typeof t.c==='number'?t.c:null,1,10);
 spark('cspeedspark','cspark2',8,typeof f.avg_mhz==='number'?f.avg_mhz/1000:null,1,0.5);}

// ---- fans, lights, storage, network, GPU tuning, services ----------------------------------
const PHASE={working:['Working','info'],hold100:['Cooling down','info'],ramp:['Cooling down','info'],idle20:['Idle',''],idle:['Idle',''],hot:['Hot','bad'],calibrating:['Calibrating','warn']};
function fanIcon(){const s=sv('svg',{viewBox:'0 0 32 32','aria-hidden':'true'});const g=sv('g',{class:'blades',fill:'currentColor'});
