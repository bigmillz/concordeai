const el=(t,txt,cls)=>{const e=document.createElement(t);if(txt!==undefined&&txt!==null)e.textContent=txt;if(cls)e.className=cls;return e;};
const NS='http://www.w3.org/2000/svg';const sv=(t,a)=>{const e=document.createElementNS(NS,t);for(const k in a)e.setAttribute(k,a[k]);return e;};
const isNum=v=>typeof v==='number'&&isFinite(v);
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const gib=b=>b==null?'?':(b/1073741824).toFixed(1)+' GiB';
const tib=b=>b==null?'?':(b>=1099511627776?(b/1099511627776).toFixed(1)+' TiB':gib(b));
let skew=0;                                   // server clock minus this browser's, from /api/state
const snow=()=>Date.now()/1000+skew;
const ago=t=>{if(!t)return 'never';const s=snow()-t;return s<90?Math.max(0,Math.round(s))+' s ago':s<5400?Math.round(s/60)+' min ago':s<172800?Math.round(s/3600)+' h ago':Math.round(s/86400)+' d ago';};
const dur=s=>{if(s==null)return '?';const d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60);return d?d+'d '+h+'h':h+'h '+m+'m';};
const mmss=s=>Math.floor(s/60)+':'+String(Math.floor(s%60)).padStart(2,'0');
const hhmm=t=>new Date(t*1000).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',second:'2-digit'});
const stamp=t=>{const d=new Date(t*1000);return d.toLocaleDateString([],{month:'short',day:'numeric'})+' '+d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});};
function kv(dl,pairs){dl.replaceChildren();for(const [k,v,c] of pairs){dl.append(el('dt',k));dl.append(el('dd',v,c||''));}}
