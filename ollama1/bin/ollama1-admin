 ['Memory used (GiB)',10,'violet',v=>v.toFixed(1)+' GiB','ram']];
const STROKE={cyan:'#2dd4ef',blue:'#6f8fff',violet:'#a78bfa',amber:'#fbbf24',pink:'#f472b6',green:'#34d399',orange:'#fb923c'};
(function buildCharts(){const box=$('charts');CH.forEach(([title],i)=>{const c=el('div',undefined,'card chart');const hd=el('div',undefined,'hd'),l=el('div');
 l.append(el('div',title,'ti'),el('div','','mm'));hd.append(l,el('div','-','cv'));const p=el('div',undefined,'plot');p.id='ch'+i;c.append(hd,p);box.append(c);});})();
function niceMax(v){if(!(v>0))return 1;const p=Math.pow(10,Math.floor(Math.log10(v))),n=v/p;return (n<=1?1:n<=2?2:n<=2.5?2.5:n<=5?5:10)*p;}
function drawChart(host,pts,o){const W=Math.max(160,Math.round(host.clientWidth||360)),H=Math.max(90,Math.round(host.clientHeight||150)),L=40,R=8,T=8,B=22;
 const svg=sv('svg',{width:W,height:H,viewBox:'0 0 '+W+' '+H,role:'img','aria-label':o.label});const span=o.t1-o.t0;
 pts=pts.filter(p=>p[0]>=o.t0-span*0.02&&isNum(p[1]));
 const px=t=>L+(t-o.t0)/span*(W-L-R);
 // one point per 2 pixels: the mean of what falls there (24 h of 10 s rows stays cheap)
 const bk=[];let cur=null;for(const p of pts){const b=Math.floor(px(p[0])/2);if(!cur||cur.b!==b){cur={b,t:0,v:0,n:0,last:p[0]};bk.push(cur);}cur.t+=p[0];cur.v+=p[1];cur.n++;cur.last=p[0];}
 const P=bk.map(b=>[b.t/b.n,b.v/b.n]);
 let max=o.max||niceMax(Math.max(1e-9,...P.map(p=>p[1]))*1.08);const y=v=>T+(1-clamp(v/max,0,1))*(H-T-B);
 for(let i=0;i<=3;i++){const v=max*i/3;svg.append(sv('line',{x1:L,x2:W-R,y1:y(v),y2:y(v),stroke:'rgba(148,163,200,.10)','stroke-width':1}));
  const tx=sv('text',{x:L-6,y:y(v)+4,'text-anchor':'end','font-size':10,fill:'#8a93ab'});tx.textContent=v>=100||Number.isInteger(v)?Math.round(v):v.toFixed(1);svg.append(tx);}
 const lab=span<=3600?['-60 min','-30 min','now']:['-24 h','-12 h','now'];[0,.5,1].forEach((f,i)=>{const tx=sv('text',{x:L+f*(W-L-R),y:H-5,'text-anchor':i===0?'start':i===2?'end':'middle','font-size':10,fill:'#8a93ab'});tx.textContent=lab[i];svg.append(tx);});
 const tip=el('div',undefined,'tip');host.replaceChildren(svg,tip);
 if(P.length<2){const tx=sv('text',{x:(L+W)/2,y:H/2,'text-anchor':'middle','font-size':12,fill:'#8a93ab'});tx.textContent='No data yet';svg.append(tx);return;}
 const gap=Math.max(o.gap||60,span/W*4);const segs=[];let seg=[];
 for(let i=0;i<P.length;i++){if(seg.length&&P[i][0]-P[i-1][0]>gap){segs.push(seg);seg=[];}seg.push([px(P[i][0]),y(P[i][1])]);}if(seg.length)segs.push(seg);
 const col=STROKE[o.color]||'#2dd4ef';
 for(const s of segs){let d='M'+s[0][0].toFixed(1)+' '+s[0][1].toFixed(1);
  for(let i=1;i<s.length;i++){const mx=((s[i-1][0]+s[i][0])/2).toFixed(1);d+='C'+mx+' '+s[i-1][1].toFixed(1)+' '+mx+' '+s[i][1].toFixed(1)+' '+s[i][0].toFixed(1)+' '+s[i][1].toFixed(1);}
  svg.append(sv('path',{d:d+'L'+s[s.length-1][0].toFixed(1)+' '+(H-B)+'L'+s[0][0].toFixed(1)+' '+(H-B)+'Z',fill:'url(#fa-'+o.color+')',stroke:'none'}));
  svg.append(sv('path',{d,fill:'none',stroke:col,'stroke-width':2,'stroke-linejoin':'round','stroke-linecap':'round'}));}
 const lp=segs[segs.length-1][segs[segs.length-1].length-1];
 svg.append(sv('circle',{cx:lp[0],cy:lp[1],r:7,fill:col,opacity:.2}),sv('circle',{cx:lp[0],cy:lp[1],r:3.2,fill:col}));
 const hair=sv('line',{y1:T,y2:H-B,stroke:'rgba(238,242,251,.35)','stroke-width':1,visibility:'hidden'}),hd=sv('circle',{r:4,fill:col,stroke:'#05070c','stroke-width':2,visibility:'hidden'});svg.append(hair,hd);
 const show=cx=>{let best=P[0];const t=o.t0+(cx-L)/(W-L-R)*span;for(const p of P)if(Math.abs(p[0]-t)<Math.abs(best[0]-t))best=p;
  const x=px(best[0]);hair.setAttribute('x1',x);hair.setAttribute('x2',x);hair.setAttribute('visibility','visible');hd.setAttribute('cx',x);hd.setAttribute('cy',y(best[1]));hd.setAttribute('visibility','visible');
  tip.replaceChildren(el('b',o.fmt(best[1])),document.createTextNode(new Date(best[0]*1000).toLocaleTimeString()));tip.style.display='block';
  tip.style.left=clamp(x+10,0,W-tip.offsetWidth)+'px';tip.style.top='0px';host._hx=cx;};
 svg.addEventListener('pointermove',e=>{const r=svg.getBoundingClientRect();show((e.clientX-r.left)/r.width*W);});
 svg.addEventListener('pointerleave',()=>{hair.setAttribute('visibility','hidden');hd.setAttribute('visibility','hidden');tip.style.display='none';host._hx=null;});
 if(host._hx!=null)show(host._hx);}
function draw(){const now=snow(),all=rows(),g=lastState.gpu||{},m=lastState.memory||{};
 CH.forEach(([title,ix,color,fmt,mx],i)=>{const host=$('ch'+i),card=host.parentNode;const pts=all.filter(r=>r[0]>=now-range&&r[ix]!=null).map(r=>[r[0],r[ix]]);
  const max=mx==='vram'?(g.vram_total?niceMax(g.vram_total/1073741824):null):mx==='ram'?(m.total?niceMax(m.total/1073741824):null):mx;
  drawChart(host,pts,{t0:now-range,t1:now,color,fmt,max,label:title,gap:range>3600?120:60});
  const last=pts.length?pts[pts.length-1][1]:null;card.querySelector('.cv').textContent=last==null?'-':fmt(last);
  const v=pts.map(p=>p[1]);card.querySelector('.mm').textContent=v.length?'low '+fmt(Math.min(...v))+'  ·  high '+fmt(Math.max(...v)):'';});}
document.querySelectorAll('button[data-range]').forEach(b=>b.addEventListener('click',()=>{range=+b.dataset.range;
 document.querySelectorAll('button[data-range]').forEach(x=>{x.classList.toggle('on',x===b);x.setAttribute('aria-pressed',String(x===b));});draw();}));
async function refreshHist(){try{hist=await api('/api/history');draw();}catch(e){}}
let rsz=null;if(window.ResizeObserver)new ResizeObserver(()=>{clearTimeout(rsz);rsz=setTimeout(()=>{draw();if(pw)renderPower();},120);}).observe($('charts'));

// ---- logs: a tab per source, filter, follow, copy -----------------------------------------
const LOG={tab:'requests',q:'',follow:true};
const TABS=[['requests','Requests'],['events','Model events'],['actions','Actions'],['updates','Updates'],['library','Model library'],['errors','Errors'],['status','Status lines']];
function logLines(tab){const L=logs||{},out=[];const s=lastState||{},up=s.updates||{};
 if(tab==='requests')(L.recent||[]).forEach(r=>out.push([r.t,[r.status,r.device,r.model,r.kind,r.ms!=null?r.ms+' ms':null,r.prompt_tokens!=null?'in '+r.prompt_tokens:null,r.tokens!=null?'out '+r.tokens:null,r.code?'('+r.code+')':null].filter(x=>x!=null&&x!=='').join('  '),r.status>=400?'bad':'']));
 if(tab==='events')(L.events||[]).forEach(e=>out.push([e.t,(e.kind||'?')+'  '+(e.model||''),'']));
 if(tab==='actions')Object.entries(L.actions||{}).sort((a,b)=>(a[1].at||0)-(b[1].at||0)).forEach(([k,v])=>out.push([v.at,k+'  '+v.result+(v.detail?'  '+v.detail:''),v.result==='failed'?'bad':v.result==='ok'?'ok':'']));
 if(tab==='updates'){const o=L.ollama_update||{};if(o.last_run)out.push([o.last_run,'ollama updater  '+(o.result||'?')+(o.version?'  '+o.version:'')+(o.detail?'  '+o.detail:''),o.result==='failed'?'bad':'ok']);
  if(up.last_unattended)out.push([up.last_unattended,'security updates ran','']);if(up.reboot_required)out.push([null,'reboot required'+((up.reboot_pkgs||[]).length?' by '+up.reboot_pkgs.join(', '):''),'warn']);
  if(up.next_ollama_update)out.push([null,'next Ollama check: '+up.next_ollama_update,'']);out.sort((a,b)=>(a[0]??Infinity)-(b[0]??Infinity));}
 if(tab==='library'){const sy=(libState||{}).sync||{};if(sy.state)out.push([sy.at||null,'sync '+sy.state+(sy.message?': '+sy.message:''),sy.state==='failed'?'bad':'']);(sy.log||[]).forEach(x=>out.push([null,String(x),/fail|error/i.test(x)?'bad':'']));
  const pl=(models||{}).pull;if(pl&&pl.model)out.push([null,'pull '+pl.model+': '+pl.status+(pl.total?' '+Math.round(100*pl.completed/pl.total)+'%':''),'']);}
 if(tab==='errors'){const tt=L.totals||{};out.push([null,'totals: '+Object.entries(tt).map(([k,v])=>k+' '+v).join(', '),'']);
  Object.entries(L.errors||{}).forEach(([k,v])=>out.push([null,'error '+k+': '+v,'bad']));Object.entries(L.auth_failures||{}).forEach(([k,v])=>out.push([null,'refused sign-in '+k+': '+v,'warn']));}
 if(tab==='status'){[['fans',s.fan],['lights',s.leds],['cpu',(s.cpu||{}).throttle],['sleep',(s.idle||{}).reason],['gpu tuning',((s.gpu_tune||{}).check||{}).note]].forEach(([k,v])=>{if(v)out.push([null,k+': '+v,'']);});}
 return out;}
(function buildTabs(){const T=$('logtabs');TABS.forEach(([k,lab])=>{const b=el('button');b.type='button';b.setAttribute('role','tab');b.id='tab-'+k;b.setAttribute('aria-controls','logview');b.dataset.tab=k;
 b.append(document.createTextNode(lab+' '),el('span','','n'));b.addEventListener('click',()=>{LOG.tab=k;renderLogs(true);});
 b.addEventListener('keydown',e=>{const i=TABS.findIndex(t=>t[0]===LOG.tab);if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();LOG.tab=TABS[(i+(e.key==='ArrowRight'?1:TABS.length-1))%TABS.length][0];renderLogs(true);$('tab-'+LOG.tab).focus();}});T.append(b);});})();
function renderLogs(jump){const v=$('logview'),q=LOG.q.toLowerCase();
 TABS.forEach(([k])=>{const b=$('tab-'+k),on=k===LOG.tab;b.setAttribute('aria-selected',String(on));b.tabIndex=on?0:-1;b.querySelector('.n').textContent=String(logLines(k).length);});
 v.setAttribute('aria-labelledby','tab-'+LOG.tab);
 const lines=logLines(LOG.tab).map(([t,txt,c])=>[t?(LOG.tab==='requests'||LOG.tab==='events'?hhmm(t):stamp(t)):'',txt,c]).filter(([t,txt])=>!q||(t+' '+txt).toLowerCase().includes(q));
 const atEnd=v.scrollTop+v.clientHeight>=v.scrollHeight-8;v.replaceChildren();
 if(!lines.length)v.append(el('div',logs?(q?'No line matches.':'Nothing here yet.'):'Loading...','empty'));
 for(const [t,txt,c] of lines){const d=el('div',undefined,c);if(t)d.append(el('span',t,'ts'));d.append(document.createTextNode(txt));v.append(d);}
 $('logcount').textContent=lines.length+' line'+(lines.length===1?'':'s');v._lines=lines;
 if(LOG.follow&&(atEnd||jump))v.scrollTop=v.scrollHeight;else if(jump)v.scrollTop=0;}
$('logq').addEventListener('input',e=>{LOG.q=e.target.value;renderLogs();});
$('logfollow').addEventListener('change',e=>{LOG.follow=e.target.checked;if(LOG.follow)$('logview').scrollTop=$('logview').scrollHeight;});
$('logcopy').addEventListener('click',async()=>{const text=($('logview')._lines||[]).map(([t,txt])=>(t?t+'  ':'')+txt).join('\n');
 try{await navigator.clipboard.writeText(text);toast('Copied',($('logview')._lines||[]).length+' lines','ok');}
 catch(e){const r=document.createRange();r.selectNodeContents($('logview'));const s=getSelection();s.removeAllRanges();s.addRange(r);toast('Selected','Press Ctrl+C or Cmd+C to copy.','warn');}});

// ---- polling: every few seconds while the tab is visible, paused while it is hidden ---------
const JOBS=[[refreshFast,2500],[refreshSlow,10000],[refreshLib,3000],[refreshPowerTick,10000],[refreshHist,30000]];
function startPolling(){for(const j of JOBS){if(j.t)continue;j[0]();j.t=setInterval(j[0],j[1]);}setLive('','Live');}
function stopPolling(){for(const j of JOBS){clearInterval(j.t);j.t=null;}setLive('paused','Paused');}
document.addEventListener('visibilitychange',()=>{if(document.hidden)stopPolling();else startPolling();});
renderLogs();refreshPower();refreshHist();
if(document.hidden){refreshFast();refreshSlow();refreshLib();setLive('paused','Paused');}else startPolling();
setInterval(()=>{if(document.hidden||!lastState.time)return;try{renderHero(lastState);renderSvc(lastState);renderLoaded(lastState);}catch(e){}},1000);
</script></body></html>
"""


def main():
    import argparse
    import signal
    ap = argparse.ArgumentParser(description="ollama1 admin panel")
    ap.add_argument("--config")
    a = ap.parse_args()
    cfg = load_config(a.config)
    panel, srv, stop = serve(cfg)
    done = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: done.set())
    signal.signal(signal.SIGINT, lambda *_: done.set())
    done.wait()
    stop.set()
    srv.shutdown()
    try:
        panel.save_history()
    except OSError:
        pass


if __name__ == "__main__":
    main()
