// ---- history charts: area under a line, one axis each, crosshair + tooltip ---------------
let range=3600,hist={rows:[]};const liveRows=[];
function pushLive(s){const g=s.gpu||{},gw=s.gateway||{},t=(g.temps)||{},c=s.cpu||{},f=c.freq||{},m=s.memory||{};if(!isNum(s.time))return;
