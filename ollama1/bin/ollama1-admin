async function api(p){const r=await fetch(p,{credentials:'same-origin',cache:'no-store'});if(!r.ok)throw new Error('HTTP '+r.status);return r.json();}
// every POST: JSON, same origin, the CSRF token; the answer is shown as the server gave it
async function post(path,obj){
 try{const r=await fetch(path,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','X-O1-CSRF':CSRF},body:JSON.stringify(obj)});
  let j={};try{j=await r.json();}catch(e){}
  const msg=j.result||j.error||(Array.isArray(j.errors)?j.errors.join('; '):'')||('HTTP '+r.status);
  return {ok:r.ok,status:r.status,msg,j};}
 catch(e){return {ok:false,status:0,msg:'no answer from the server ('+e.message+')',j:{}};}}
function toast(title,text,kind){const t=el('div',undefined,'toast'+(kind?' '+kind:''));t.append(el('b',title));if(text)t.append(document.createTextNode(text));
 $('toasts').append(t);setTimeout(()=>t.remove(),kind==='bad'?10000:6000);}
const LABEL={update:'Apply updates',restart:'Restart services',reboot:'Reboot',sleep:'Sleep',pair:'Pairing window',backup:'Back up','lan-on':'LAN mode on','lan-off':'LAN mode off',
 'library-preview':'Model library check','library-sync':'Model library sync','remove-device':'Remove device',pull:'Download model','remove-model':'Remove model'};
async function act(action,arg,confirm,btn){if(btn){btn.disabled=true;btn.setAttribute('aria-busy','true');}
