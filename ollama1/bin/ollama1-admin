 if(btn){btn.disabled=false;btn.removeAttribute('aria-busy');}
 toast((LABEL[action]||action)+(r.ok?': '+r.msg:' refused'),r.ok?'The server answered '+r.status+'.':r.msg+' ('+(r.status||'no answer')+')',r.ok?'ok':'bad');
