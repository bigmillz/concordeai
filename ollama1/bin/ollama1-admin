 liveRows.push([s.time,(gw.tps||{}).current??0,g.busy_pct??null,g.vram_used!=null?g.vram_used/1073741824:null,t.junction??t.edge??null,g.power_w??null,gw.active||0,
  (c.temp||{}).c??null,isNum(f.avg_mhz)?f.avg_mhz/1000:null,isNum(u)?u:null,m.total?m.used/1073741824:null]);
 while(liveRows.length&&liveRows[0][0]<s.time-3700)liveRows.shift();}
function rows(){const r=hist.rows||[],last=r.length?r[r.length-1][0]:0;return r.concat(liveRows.filter(x=>x[0]>last));}
const CH=[['Tokens per second',1,'cyan',v=>v.toFixed(1),null],['GPU busy (%)',2,'blue',v=>Math.round(v)+'%',100],['VRAM used (GiB)',3,'violet',v=>v.toFixed(1)+' GiB','vram'],
