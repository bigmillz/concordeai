 const check=()=>{ok.disabled=o.typed?inp.value!==o.typed:false;};
 const done=v=>{inp.removeEventListener('input',check);inp.removeEventListener('keydown',key);ok.onclick=no.onclick=null;d.onclose=null;if(d.open)d.close();res(v);};
 const key=e=>{if(e.key==='Enter'&&!ok.disabled){e.preventDefault();done(inp.value);}};
 inp.addEventListener('input',check);inp.addEventListener('keydown',key);
