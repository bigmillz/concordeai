// ---- a styled, accessible confirm (the native <dialog>: focus kept inside, Esc cancels) --
function ask(o){return new Promise(res=>{const d=$('dlg'),ok=$('dlgok'),no=$('dlgno'),inp=$('dlgin'),lab=$('dlgl');
 $('dlgt').textContent=o.title;const b=$('dlgb');b.replaceChildren();(o.body||[]).forEach(p=>b.append(el('p',p)));
 ok.textContent=o.ok||'Confirm';ok.className=o.danger?'danger':'primary';
