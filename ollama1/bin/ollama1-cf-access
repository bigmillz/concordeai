#!/usr/bin/python3
"""ollama1-cf-access: all of the server's Cloudflare setup through the API,
with one API token. setup.sh runs it; it can also be run on its own:

  sudo ollama1-cf-access                 asks for the token (not echoed)
  ... | ollama1-cf-access --token-stdin  setup.sh: the token arrives on stdin

The token lives in this process's memory only. It is never written to a
file, a log, the environment or a command line, and it is dropped when the
work is done. Make it at dash.cloudflare.com > My Profile > API Tokens >
Create Token > Create Custom Token, with a 1-day TTL:
  Account  Cloudflare Tunnel                                    Edit
  Account  Access: Apps and Policies                            Edit
  Account  Access: Service Tokens                               Edit
  Account  Access: Organizations, Identity Providers, and Groups Read
  Zone     DNS    Edit   (Specific zone: your zone, <your-domain>)
  Zone     Zone   Read   (Specific zone: the same)
Delete it in the dashboard afterwards.

What it does (each step finds what exists and reuses it, so reruns change
nothing that is already right):
  1. finds the zone (cf_zone in config.json, <your-domain>) and
     the account that owns it
  2. finds the Zero Trust team domain (needs a one-time dashboard visit if
     the account has no Zero Trust organization yet; it says which click)
  3. tunnel "<server-name>": a LOCALLY-MANAGED tunnel (config_src "local"), so its
     routes and the Access check live in /etc/ollama1/cloudflared.yml on
     the server. Its credential is written to /etc/cloudflared/ollama1.json
     (root, 0600), rebuilt from the tunnel's token if the file is missing
  4. DNS: one proxied CNAME per hostname to <tunnel id>.cfargotunnel.com;
     only CNAMEs pointing at a tunnel or made by this helper are fixed or
     deduplicated; any other record on those names stops it (it never
     changes or deletes records it didn't make)
  5. Access: service token "<server-name>-app" (never expires), policies
     "<server-name> admin - <your-name> only" (email) and "<server-name> app -
     service token", and one self-hosted application per hostname. The
     names come from server_name and owner_label in config.json (setup.sh
     --name and --owner); ollama1 in this command's name is the kit's, not yours
  6. writes the team domain, both AUD tags, the admin email, the service
     token's Client ID and the tunnel id to /etc/ollama1/config.json (0600)
The service token's Client Secret is shown once on the terminal (never
stdout, so never setup's log), the moment it is created or rotated, and
saved nowhere. If a run stops before showing it, the next run rotates it.
Redirects are never followed, so the token only ever goes to the API.
"""
import argparse
import base64
import getpass
import json
import os
import secrets
import sys
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from o1common import Paths, access_names, load_config, read_json, write_json_atomic  # noqa: E402

API = "https://api.cloudflare.com/client/v4"
# The names below are filled in from config.json by main() (server_name and
# what derives from it; see o1common.access_names).
TUNNEL = TOKEN_NAME = POL_ADMIN = POL_APP = APP_ADMIN = APP_GATEWAY = ""
NO_ORG = """This Cloudflare account has no Zero Trust organization yet. That needs one visit:
  dash.cloudflare.com > Zero Trust (left sidebar) > choose a team name (e.g. concorde)
  > select the Free plan > Proceed. Then run this again."""


class Stop(Exception):
    pass


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Never follow a redirect: the Authorization header must only ever go
    to api.cloudflare.com."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url, code, "redirect refused: %s" % newurl, headers, fp)


OPENER = urllib.request.build_opener(NoRedirect)


class CF:
    def __init__(self, token, base):
        self._token = token
        self.base = base

    def forget(self):
        self._token = None

    def call(self, method, path, body=None, ok404=False):
        data = None if body is None else json.dumps(body).encode()
        req = urllib.request.Request(self.base + path, data=data, method=method, headers={
            "Authorization": "Bearer " + self._token, "Content-Type": "application/json",
            "User-Agent": "ollama1-cf-access"})
        try:
            with OPENER.open(req, timeout=30) as r:
                out = json.loads(r.read())
        except urllib.error.HTTPError as e:
            if ok404 and e.code == 404:
                return None
            try:
                out = json.loads(e.read())
            except ValueError:
                out = {"success": False, "errors": [{"message": "HTTP %d" % e.code}]}
            if e.code in (401, 403) and not out.get("errors"):
                out["errors"] = [{"message": "the token is not allowed to do this"}]
        except urllib.error.URLError as e:
            raise Stop("can't reach Cloudflare: %s" % e.reason)
        if not out.get("success"):
            msgs = "; ".join(str(x.get("message")) for x in out.get("errors") or []) or "failed"
            raise Stop("Cloudflare refused %s %s: %s" % (method, path.split("?")[0], msgs))
        return out.get("result")


def q(**kw):
    return "?" + urllib.parse.urlencode(kw)


def say(msg=""):
    print(msg, flush=True)


def ask_tty(prompt, default="", interactive=True):
    if not interactive:
        return default
    with open("/dev/tty") as tty:
        sys.stdout.write(prompt + (" [%s]" % default if default else "") + ": ")
        sys.stdout.flush()
        return tty.readline().strip() or default


def tunnel_step(cf, acct, creds_path):
    found = [t for t in cf.call("GET", "/accounts/%s/cfd_tunnel%s" % (acct, q(name=TUNNEL, is_deleted="false"))) or []
             if t.get("name") == TUNNEL and not t.get("deleted_at")]
    if found:
        tid = found[0]["id"]
        say("tunnel %s exists (%s)" % (TUNNEL, tid))
    else:
        secret = base64.b64encode(secrets.token_bytes(32)).decode()
        t = cf.call("POST", "/accounts/%s/cfd_tunnel" % acct,
                    {"name": TUNNEL, "tunnel_secret": secret, "config_src": "local"})
        tid = t["id"]
        say("created tunnel %s (%s)" % (TUNNEL, tid))
    cur = read_json(creds_path, {}) or {}
    if cur.get("TunnelID") == tid and cur.get("TunnelSecret") and cur.get("AccountTag") == acct:
        say("tunnel credential already in %s" % creds_path)
    else:
        # The tunnel's token carries its account, id and secret; the
        # credential file is the same three things under cloudflared's names.
        tok = cf.call("GET", "/accounts/%s/cfd_tunnel/%s/token" % (acct, tid))
        try:
            raw = base64.b64decode(tok + "=" * (-len(tok) % 4))
            t = json.loads(raw)
            creds = {"AccountTag": t["a"], "TunnelID": t["t"], "TunnelSecret": t["s"]}
        except (ValueError, KeyError, TypeError):
            raise Stop("the tunnel token from Cloudflare didn't decode")
        if creds["TunnelID"] != tid:
            raise Stop("the tunnel token is for another tunnel")
        os.makedirs(os.path.dirname(creds_path), mode=0o755, exist_ok=True)
        write_json_atomic(creds_path, creds, mode=0o600)
        del t, creds, raw, tok
        say("tunnel credential written to %s (root-only)" % creds_path)
    return tid


DNS_COMMENT = "ollama1 tunnel (ollama1-cf-access)"


def _ours(r):
    """A CNAME this kit may change: one pointing at a tunnel, or one it made."""
    return (str(r.get("content") or "").endswith(".cfargotunnel.com")
            or "ollama1 tunnel" in str(r.get("comment") or ""))


def dns_step(cf, zone_id, hosts, tid):
    target = "%s.cfargotunnel.com" % tid
    for host in hosts:
        recs = cf.call("GET", "/zones/%s/dns_records%s" % (zone_id, q(name=host, per_page=100))) or []
        recs = [r for r in recs if r.get("name", "").lower() == host.lower()]
        others = [r for r in recs if r.get("type") != "CNAME"]
        if others:
            raise Stop("%s already has %s record(s); remove them in the dashboard (DNS > Records) "
                       "and run this again" % (host, ", ".join(sorted({r["type"] for r in others}))))
        cnames = [r for r in recs if r.get("type") == "CNAME"]
        foreign = [r for r in cnames if not _ours(r)]
        if foreign:
            r = foreign[0]
            raise Stop("%s has a CNAME to %s that setup didn't make; it won't change it. Remove it in "
                       "the dashboard (DNS > Records) and run this again" % (host, r.get("content")))
        body = {"type": "CNAME", "name": host, "content": target, "proxied": True, "ttl": 1,
                "comment": DNS_COMMENT}
        if not cnames:
            cf.call("POST", "/zones/%s/dns_records" % zone_id, body)
            say("DNS %s -> %s (created, proxied)" % (host, target))
            continue
        keep, extra = cnames[0], cnames[1:]
        for r in extra:
            cf.call("DELETE", "/zones/%s/dns_records/%s" % (zone_id, r["id"]))
            say("DNS %s: removed a duplicate CNAME" % host)
        if keep.get("content") != target or not keep.get("proxied"):
            cf.call("PATCH", "/zones/%s/dns_records/%s" % (zone_id, keep["id"]), body)
            say("DNS %s -> %s (updated, proxied)" % (host, target))
        else:
            say("DNS %s -> %s (already right)" % (host, target))


def _cf_state():
    return read_json(os.path.join(Paths.state, "cf-state.json"), {}) or {}


def _save_cf_state(st):
    os.makedirs(Paths.state, exist_ok=True)
    write_json_atomic(os.path.join(Paths.state, "cf-state.json"), st, mode=0o600)


def access_step(cf, acct, cfg, admin, interactive, rotate, test_mode=False):
    a = "/accounts/%s/access" % acct
    tokens = cf.call("GET", a + "/service_tokens" + q(per_page=100)) or []
    tok = next((t for t in tokens if t.get("name") == TOKEN_NAME), None)
    st = _cf_state()
    # If an earlier run created or rotated the token but never got to show
    # its secret, nobody has it: rotate now without asking.
    unshown = st.get("secret_unshown") == TOKEN_NAME
    if tok is None:
        _save_cf_state(dict(st, secret_unshown=TOKEN_NAME))
        tok = cf.call("POST", a + "/service_tokens", {"name": TOKEN_NAME, "duration": "forever"})
        say("created service token %s (never expires)" % TOKEN_NAME)
        if show_secret(tok["client_id"], tok.get("client_secret"), test_mode):
            _save_cf_state(dict(_cf_state(), secret_unshown=None))
    else:
        if tok.get("expires_at") and not str(tok.get("expires_at")).startswith("0001"):
            say("note: service token %s expires %s; rotate it before then "
                "(sudo ollama1-cf-access --rotate-service-token)" % (TOKEN_NAME, tok["expires_at"]))
        if unshown:
            say("an earlier run made the service token but never showed its secret; making a new one")
            rotate = True
        if rotate is None:
            ans = ask_tty("Service token %s exists. Rotate its secret (the app then needs the new "
                          "one)? y/N" % TOKEN_NAME, "n", interactive)
            rotate = ans.lower().startswith("y")
        if rotate:
            _save_cf_state(dict(st, secret_unshown=TOKEN_NAME))
            tok = dict(tok, **cf.call("POST", a + "/service_tokens/%s/rotate" % tok["id"]))
            say("rotated the secret of %s" % TOKEN_NAME)
            if show_secret(tok["client_id"], tok.get("client_secret"), test_mode):
                _save_cf_state(dict(_cf_state(), secret_unshown=None))
        else:
            say("service token %s exists (secret unchanged)" % TOKEN_NAME)

    pols = cf.call("GET", a + "/policies" + q(per_page=100)) or []

    def policy(name, decision, include):
        body = {"name": name, "decision": decision, "include": include, "exclude": [], "require": []}
        cur = next((p for p in pols if p.get("name") == name), None)
        if cur:
            same = cur.get("decision") == decision and cur.get("include") == include
            if not same:
                cf.call("PUT", a + "/policies/%s" % cur["id"], body)
            say("policy %r %s" % (name, "already right" if same else "updated"))
            return cur["id"]
        say("policy %r created" % name)
        return cf.call("POST", a + "/policies", body)["id"]

    pid_admin = policy(POL_ADMIN, "allow", [{"email": {"email": admin}}])
    pid_app = policy(POL_APP, "non_identity", [{"service_token": {"token_id": tok["id"]}}])
    apps = cf.call("GET", a + "/apps" + q(per_page=100)) or []

    def app(name, domain, pid, extra):
        body = {"name": name, "domain": domain, "type": "self_hosted", "session_duration": "24h",
                "app_launcher_visible": False, "http_only_cookie_attribute": True,
                "same_site_cookie_attribute": "lax", "policies": [{"id": pid, "precedence": 1}]}
        body.update(extra)
        cur = next((x for x in apps if x.get("domain") == domain), None)
        if cur:
            res = cf.call("PUT", a + "/apps/%s" % cur["id"], body)
            say("Access application %s: brought in line" % domain)
        else:
            res = cf.call("POST", a + "/apps", body)
            say("Access application %s: created" % domain)
        return res["aud"]

    admin_aud = app(APP_ADMIN, cfg["hostname_admin"], pid_admin, {})
    gw_aud = app(APP_GATEWAY, cfg["hostname_gateway"], pid_app, {"service_auth_401_redirect": True})
    return tok["client_id"], admin_aud, gw_aud


def show_secret(client_id, secret, test_mode):
    """Straight to the terminal, the moment the token is made: never stdout,
    so never setup's log (tee). True if it was shown."""
    tty = os.environ.get("OLLAMA1_TTY") if test_mode and os.environ.get("OLLAMA1_TTY") else "/dev/tty"
    try:
        with open(tty, "w") as t:
            t.write("\nThe app's service token. Copy both lines now: the secret is shown this once\n"
                    "and is saved nowhere (not even in the setup log). ConcordeAI asks for them\n"
                    "when you add the server.\n"
                    "  CF-Access-Client-Id:     %s\n"
                    "  CF-Access-Client-Secret: %s\n\n" % (client_id, secret))
        say("The service token's Client ID and Secret were shown on the terminal (not logged).")
        return True
    except OSError:
        say("No terminal to show the service token's secret on. The next run at a terminal")
        say("makes a new one by itself.")
        return False


def main():
    ap = argparse.ArgumentParser(description="the server's Cloudflare setup, through the API")
    ap.add_argument("--token-stdin", action="store_true", help="read the API token from stdin")
    ap.add_argument("--no-prompt", action="store_true", help="never ask; keep an existing service token")
    ap.add_argument("--rotate-service-token", action="store_true")
    a = ap.parse_args()
    test_mode = bool(os.environ.get("OLLAMA1_PREFIX"))
    if os.geteuid() != 0 and not test_mode:
        sys.exit("run it with sudo: it writes root-only files")
    base = os.environ.get("OLLAMA1_CF_API") if test_mode and os.environ.get("OLLAMA1_CF_API") else API
    os.umask(0o077)
    interactive = not a.no_prompt
    global TUNNEL, TOKEN_NAME, POL_ADMIN, POL_APP, APP_ADMIN, APP_GATEWAY
    cfg = load_config(Paths.config)
    raw = read_json(Paths.config, {}) or {}
    names = access_names(cfg)
    TUNNEL, TOKEN_NAME, POL_ADMIN, POL_APP = names["tunnel"], names["token"], names["policy_admin"], names["policy_app"]
    APP_ADMIN, APP_GATEWAY = names["app_admin"], names["app_gateway"]
    if not cfg.get("hostname_gateway") or not cfg.get("hostname_admin"):
        sys.exit("no hostnames: set cf_zone (setup.sh --zone <your-domain>) in /etc/ollama1/config.json first")
    admin = (cfg.get("admin_email") or "").strip()
    if not admin:
        admin = ask_tty("Admin email (the only one allowed into %s)" % cfg["hostname_admin"], "", interactive)
    if "@" not in admin:
        sys.exit("no admin email: set it in /etc/ollama1/config.json or run setup.sh first")

    if a.token_stdin:
        token = sys.stdin.readline().strip()
    else:
        say("Paste the Cloudflare API token. It is used for this run only and never saved.")
        token = getpass.getpass("API token (not shown): ").strip()
    if not token or any(c.isspace() for c in token):
        sys.exit("no API token given")
    cf = CF(token, base)
    del token
    rotate = True if a.rotate_service_token else (False if a.no_prompt else None)
    try:
        zone = (cfg.get("cf_zone") or "").strip().lower()
        for h in (cfg["hostname_gateway"], cfg["hostname_admin"]):
            if not h.lower().endswith("." + zone):
                raise Stop("%s is not in the zone %s (hostname_* and cf_zone in config.json)" % (h, zone))
        zones = cf.call("GET", "/zones" + q(name=zone)) or []
        if not zones:
            raise Stop("the token can't see the zone %s (Zone > Zone: Read on that zone)" % zone)
        zone_id, acct = zones[0]["id"], zones[0]["account"]["id"]
        say("zone %s, account %s" % (zone, zones[0]["account"].get("name", "")))
        org = cf.call("GET", "/accounts/%s/access/organizations" % acct, ok404=True)
        team = (org or {}).get("auth_domain")
        if not team:
            raise Stop(NO_ORG)
        say("Zero Trust team domain %s" % team)
        tid = tunnel_step(cf, acct, Paths.tunnel_creds)
        dns_step(cf, zone_id, [cfg["hostname_gateway"], cfg["hostname_admin"]], tid)
        client_id, admin_aud, gw_aud = access_step(cf, acct, cfg, admin, interactive, rotate, test_mode)
    except Stop as e:
        say("\nSTOPPED: %s" % e)
        return 1
    finally:
        cf.forget()
        del cf

    raw.update({"access_team_domain": team, "admin_aud": admin_aud, "gateway_aud": gw_aud,
                "admin_email": admin, "service_token_client_id": client_id, "tunnel_id": tid})
    os.makedirs(Paths.etc, exist_ok=True)
    write_json_atomic(Paths.config, raw, mode=0o600)
    say("\nSaved to %s (root-only): team domain, both AUD tags, the admin email," % Paths.config)
    say("the service token's Client ID and the tunnel id.")
    say("\nThe API token is gone from memory. Delete it in the dashboard now:")
    say("  dash.cloudflare.com > My Profile > API Tokens > ... > Delete")
    return 0


if __name__ == "__main__":
    sys.exit(main())
