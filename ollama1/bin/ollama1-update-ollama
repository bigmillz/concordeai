#!/usr/bin/python3
"""ollama1-update-ollama: install or update Ollama from its GitHub release,
verified. Runs as root (weekly timer, the panel's "apply updates", setup).

1. Reads the latest release from api.github.com/repos/ollama/ollama.
2. Downloads ollama-linux-amd64 and (for AMD GPUs; --no-rocm or
   ollama_rocm=false in config.json skips it) its ROCm component (.tar.zst,
   or .tgz on older releases) and the release's sha256sum.txt.
3. Each file's SHA-256 must equal sha256sum.txt's line for it, and the
   digest GitHub reports for the asset when it reports one. Any mismatch,
   missing line or failed download: stop, keep the current version.
4. Unpacks into /opt/ollama/versions/<tag>/ (no absolute paths, no links
   out), points /opt/ollama/current at it, restarts ollama.service and waits
   for /api/version to report the new version. If it doesn't, it switches
   back to the previous version and restarts again.
Keeps the previous version for rollback; older ones are removed.

The network (6b401): the weekly timer's catch-up run fires at boot, before name
resolution works. The run waits up to DNS_WAIT_S (2 minutes) for the API host
to resolve, and a failure that is only "no network" (a name that doesn't
resolve, no route, a timeout) is retried every RETRY_EVERY_S until
RETRY_BUDGET_S (10 minutes) is spent. Until then the result in
ollama-update.json is "waiting for the network", never "failed"; a later run
that succeeds writes "updated" or "current" over it. Any other failure (a bad
checksum, an HTTP error) is "failed" at once. --check and --no-wait make one
attempt and don't wait.
"""
import argparse
import errno
import hashlib
import json
import os
import shutil
import socket
import subprocess
import sys
import tarfile
import time
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

import o1sleep  # noqa: E402
from o1common import Paths, load_config, write_json_atomic  # noqa: E402

API = "https://api.github.com/repos/ollama/ollama/releases/latest"
BASE = "ollama-linux-amd64"
PARTS = [BASE, BASE + "-rocm"]
UA = {"User-Agent": "ollama1-updater", "Accept": "application/vnd.github+json"}


DNS_WAIT_S = 120                 # waiting for the API host to resolve, at most this long a time
DNS_POLL_S = 5
RETRY_BUDGET_S = 600             # the whole run's patience with the network
RETRY_EVERY_S = 30
NET_ERRNOS = frozenset((errno.ENETUNREACH, errno.EHOSTUNREACH, errno.ENETDOWN, errno.ECONNREFUSED,
                        errno.ECONNRESET, errno.ETIMEDOUT))
WAITING = "waiting for the network"


class Refused(Exception):
    pass


class NoNetwork(Exception):
    """The attempt failed only because the network isn't there (yet)."""


def is_no_network(e):
    """True for a name that doesn't resolve, no route, a refused or reset connection, a timeout: not for an
    HTTP error answer (the network works) or anything about the files."""
    r = e.reason if isinstance(e, urllib.error.URLError) else e
    if isinstance(r, (socket.gaierror, socket.timeout, TimeoutError, ConnectionError)):
        return True
    return isinstance(r, OSError) and r.errno in NET_ERRNOS


def wait_for_dns(host, wait_s, resolver=socket.getaddrinfo, sleep=time.sleep, clock=time.monotonic):
    """True as soon as `host` resolves; False after wait_s seconds of trying (at least one try)."""
    deadline = clock() + wait_s
    while True:
        try:
            resolver(host, 443)
            return True
        except OSError:
            if clock() >= deadline:
                return False
            sleep(DNS_POLL_S)


def run_with_retries(attempt, host, cur, wait=True, resolver=socket.getaddrinfo, sleep=time.sleep,
                     clock=time.monotonic, set_status=None, log=None):
    """One attempt, or several while the network is missing: see the module's note. `attempt()` returns the
    exit code or raises NoNetwork."""
    set_status = set_status or status
    log = log or say
    start = clock()
    while True:
        detail = None
        if wait and not wait_for_dns(host, min(DNS_WAIT_S, max(RETRY_BUDGET_S - (clock() - start), 0)),
                                     resolver, sleep, clock):
            detail = "can't resolve %s" % host
        else:
            try:
                return attempt()
            except NoNetwork as e:
                detail = str(e)
        left = RETRY_BUDGET_S - (clock() - start)
        if not wait or left <= 0:
            log("update refused, staying at %s: no network (%s)" % (cur or "none", detail))
            why = ("no network for %d minutes: %s" % (RETRY_BUDGET_S // 60, detail)) if wait else detail
            set_status("failed", cur or "", why)
            return 1
        log("no network yet (%s); trying again" % detail)
        set_status(WAITING, cur or "", "%s; trying again" % detail)
        sleep(min(RETRY_EVERY_S, left))


def say(msg):
    print(msg, flush=True)


def status(result, version="", detail=""):
    os.makedirs(Paths.state, exist_ok=True)
    write_json_atomic(Paths.update_status, {"last_run": int(time.time()), "result": result,
                                            "version": version, "detail": str(detail)[:300]},
                      mode=0o644)


def fetch(url, timeout=60):
    req = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read(8 << 20)


def download(url, dest, timeout=120):
    h = hashlib.sha256()
    req = urllib.request.Request(url, headers={"User-Agent": UA["User-Agent"]})
    with urllib.request.urlopen(req, timeout=timeout) as r, open(dest, "wb") as f:
        while True:
            b = r.read(1 << 20)
            if not b:
                break
            h.update(b)
            f.write(b)
    return h.hexdigest()


def parse_sums(text):
    sums = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) == 2 and len(parts[0]) == 64:
            name = parts[1].lstrip("*")
            if name.startswith("./"):
                name = name[2:]
            sums[name] = parts[0].lower()
    return sums


def pick_assets(release, rocm=True):
    assets = {a["name"]: a for a in release.get("assets", []) if isinstance(a, dict)}
    if "sha256sum.txt" not in assets:
        raise Refused("release has no sha256sum.txt")
    chosen = []
    for part in PARTS if rocm else PARTS[:1]:
        for ext in (".tar.zst", ".tgz"):
            if part + ext in assets:
                chosen.append(assets[part + ext])
                break
        else:
            raise Refused("release has no %s archive" % part)
    return assets["sha256sum.txt"], chosen


def open_archive(path):
    if path.endswith(".tgz") or path.endswith(".tar.gz"):
        return tarfile.open(path, "r:gz"), None
    try:
        from compression import zstd  # Python 3.14+
        return tarfile.open(fileobj=zstd.open(path, "rb"), mode="r|"), None
    except ImportError:
        proc = subprocess.Popen(["zstd", "-dc", path], stdout=subprocess.PIPE)
        return tarfile.open(fileobj=proc.stdout, mode="r|"), proc


def extract(path, dest):
    tf, proc = open_archive(path)
    try:
        tf.extractall(dest, filter="data")  # refuses absolute paths and links leaving dest
    finally:
        tf.close()
        if proc:
            proc.stdout.close()
            if proc.wait() != 0:
                raise Refused("zstd failed on %s" % os.path.basename(path))


def current_tag(opt):
    try:
        return os.path.basename(os.readlink(os.path.join(opt, "current")))
    except OSError:
        return None


def switch(opt, tag):
    link = os.path.join(opt, "current")
    tmp = link + ".new"
    try:
        os.unlink(tmp)
    except FileNotFoundError:
        pass
    os.symlink(os.path.join("versions", tag), tmp)
    os.replace(tmp, link)


def healthy(version, timeout=90):
    end = time.time() + timeout
    while time.time() < end:
        try:
            with urllib.request.urlopen("http://127.0.0.1:11434/api/version", timeout=3) as r:
                if json.loads(r.read()).get("version") == version:
                    return True
        except Exception:
            pass
        time.sleep(2)
    return False


def main():
    ap = argparse.ArgumentParser(description="Install or update Ollama, verified.")
    ap.add_argument("--check", action="store_true", help="only report whether an update exists")
    ap.add_argument("--force", action="store_true", help="reinstall even if current")
    ap.add_argument("--no-rocm", action="store_true",
                    help="skip the ROCm component (NVIDIA or no GPU); also set by ollama_rocm=false in config.json")
    ap.add_argument("--no-restart", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--no-wait", action="store_true", help="one attempt: don't wait for the network")
    ap.add_argument("--api", default=API, help=argparse.SUPPRESS)
    a = ap.parse_args()
    if a.api != API and not os.environ.get("OLLAMA1_PREFIX"):
        sys.exit("--api is for tests only")
    if os.geteuid() != 0 and not os.environ.get("OLLAMA1_PREFIX"):
        sys.exit("run as root")
    os.umask(0o022)
    opt = Paths.opt
    versions = os.path.join(opt, "versions")
    os.makedirs(versions, exist_ok=True)
    cur = current_tag(opt)
    host = urllib.parse.urlparse(a.api).hostname or "api.github.com"
    return run_with_retries(lambda: attempt(a, opt, versions, cur), host, cur, wait=not (a.no_wait or a.check))


def attempt(a, opt, versions, cur):
    try:
        release = json.loads(fetch(a.api))
        tag = release.get("tag_name", "")
        if not tag.startswith("v") or "/" in tag or ".." in tag or release.get("prerelease") or release.get("draft"):
            raise Refused("unexpected release tag %r" % tag)
        say("installed: %s, latest: %s" % (cur or "none", tag))
        if a.check:
            return 0
        if cur == tag and not a.force:
            status("current", tag)
            return 0
        rocm = not a.no_rocm and bool(load_config(Paths.config).get("ollama_rocm", True))
        sums_asset, parts = pick_assets(release, rocm)
        sums = parse_sums(fetch(sums_asset["browser_download_url"]).decode("utf-8", "replace"))
        cache = os.path.join(Paths.state, "download")
        shutil.rmtree(cache, ignore_errors=True)
        os.makedirs(cache, mode=0o700)
        files = []
        for asset in parts:
            name = asset["name"]
            want = sums.get(name)
            if not want:
                raise Refused("%s is not in sha256sum.txt" % name)
            gh = (asset.get("digest") or "").lower()
            if gh and gh != "sha256:" + want:
                raise Refused("%s: GitHub's digest and sha256sum.txt disagree" % name)
            say("downloading %s (%d MB)" % (name, int(asset.get("size", 0)) >> 20))
            dest = os.path.join(cache, name)
            got = download(asset["browser_download_url"], dest)
            if got != want:
                raise Refused("%s: checksum mismatch (got %s, want %s)" % (name, got, want))
            say("verified %s sha256 %s" % (name, got))
            files.append(dest)
        stage = os.path.join(versions, tag + ".tmp")
        shutil.rmtree(stage, ignore_errors=True)
        os.makedirs(stage)
        for f in files:  # base first, then the ROCm component on top
            extract(f, stage)
        binary = os.path.join(stage, "bin", "ollama")
        if not os.path.isfile(binary) or not os.access(binary, os.X_OK):
            raise Refused("archive has no bin/ollama")
        final = os.path.join(versions, tag)
        shutil.rmtree(final, ignore_errors=True)
        os.rename(stage, final)
        shutil.rmtree(cache, ignore_errors=True)
    except (Refused, OSError, ValueError, KeyError, tarfile.TarError) as e:
        if is_no_network(e):
            raise NoNetwork(str(e))
        say("update refused, staying at %s: %s" % (cur or "none", e))
        status("failed", cur or "", e)
        return 1
    switch(opt, tag)
    if not a.no_restart:
        subprocess.run(["systemctl", "restart", "ollama.service"])
        if not healthy(tag.lstrip("v")):
            say("new version did not come up; switching back to %s" % cur)
            if cur:
                switch(opt, cur)
                subprocess.run(["systemctl", "restart", "ollama.service"])
            status("failed", cur or "", "%s did not start; rolled back" % tag)
            return 1
    for old in os.listdir(versions):
        if old not in (tag, cur) and not old.endswith(".tmp"):
            shutil.rmtree(os.path.join(versions, old), ignore_errors=True)
    status("updated", tag, "from %s" % (cur or "none"))
    say("Ollama %s installed" % tag)
    return 0


if __name__ == "__main__":
    with o1sleep.Inhibit("Ollama is being updated"):
        rc = main()
    sys.exit(rc)
