#!/usr/bin/python3
"""ollama1-gateway: the only door from the outside to Ollama on this desktop.

Listens on 127.0.0.1:8431; cloudflared forwards ollama1.flyconcordefly.com
to it. Every request must carry:
  1. a valid Cloudflare Access JWT for the app's Access application
     (Cf-Access-Jwt-Assertion; the service token's), and
  2. an Ed25519 signature from a device paired at the desktop (PROTOCOL.md).
LAN mode (off by default) adds a second listener on the LAN address where
the JWT is not required; signatures still are.

Only chat, generate, embeddings, the model list, ps, show and version are
passed on. Pull, delete, create, copy, push and blobs are not reachable.

Stateless: request and response bodies live only in memory for the length
of one request. Nothing here writes them to disk or to a log. The stats
file and the journal hold counts, timings, model names and device names.

Nothing mixes: one job on the GPU at a time, and when the next job is from
a different paired device, every loaded model is unloaded first, so not
even Ollama's prompt cache is shared between devices.

Before the body: Access and the signature headers are checked before any
body is read, at most 16 requests are handled at once, and every error
closes the connection (cloudflared reuses connections).

Pairing: the gateway never sees the code; it hands requests to a root step
(ollama1-pair --commit) and relays its answer. Never on the LAN listener.

GPU only: a model whose weights plus context can't fit in VRAM is refused
before it loads, and after it loads /api/ps must show it 100% in VRAM; if
any of it landed on the CPU it is unloaded and the request gets an error.
"""
import datetime
import ipaddress
import json
import os
import re
import secrets
import sys
import threading
import time
from collections import deque
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

import o1crypto  # noqa: E402
from o1auth import AuthError, PAIR_MIN_INTERVAL, RequestVerifier, SKEW, parse_pair_request  # noqa: E402
from o1common import (Paths, load_config, ram_models, read_json, safe_label,  # noqa: E402
                       valid_model_name, write_json_atomic)
from o1jwt import AccessVerifier, JWTError  # noqa: E402
import o1ollama  # noqa: E402
from o1pair import DeviceStore, read_public, spool_request, wait_result  # noqa: E402
import o1gpu  # noqa: E402
import o1idle  # noqa: E402
import o1stats  # noqa: E402

VERSION = "1"
USAGE_KEYS = ("busy_pct", "vram_used_bytes", "vram_total_bytes")
RAM_KEYS = ("used_bytes", "total_bytes")
USAGE_CACHE_S = 1.0     # GET /v1/usage reads the card at most this often
GPU_RECHECK_S = 15      # how often a missing card is looked for again (Gateway.gpu)

# Top-level fields and options passed on to Ollama. Anything else is dropped.
# Options that change how a model loads (num_gpu, main_gpu, low_vram,
# use_mmap, num_batch, num_thread...) are never passed: they could push
# layers onto the CPU after the GPU check.
FIELDS = {
    "chat": {"model", "messages", "tools", "format", "options", "stream", "think",
             "logprobs", "top_logprobs"},
    "generate": {"model", "prompt", "suffix", "images", "format", "options", "system",
                 "template", "stream", "raw", "context", "think", "logprobs", "top_logprobs"},
    "embed": {"model", "input", "truncate", "options", "dimensions"},
    "embeddings": {"model", "prompt", "options"},
}
SAMPLING_OPTIONS = {
    "temperature", "top_k", "top_p", "min_p", "typical_p", "repeat_last_n",
    "repeat_penalty", "presence_penalty", "frequency_penalty", "seed", "stop",
    "num_predict", "num_keep", "penalize_newline", "mirostat", "mirostat_tau",
    "mirostat_eta", "tfs_z",
}
NEVER = ("/api/pull", "/api/push", "/api/delete", "/api/create", "/api/copy", "/api/blobs")


def log(event, **fields):
    """Journal line: an event name and counts/names only."""
    parts = [event] + ["%s=%s" % (k, safe_label(v, 64).replace(" ", "_")) for k, v in fields.items()]
    print(" ".join(parts), flush=True)


class GatewayError(Exception):
    def __init__(self, status, code, message, **extra):
        super().__init__(message)
        self.status = status
        self.code = code
        self.extra = extra


# ---- counts-only statistics ------------------------------------------------

class Stats:
    def __init__(self, clock=time.time):
        self.clock = clock
        self.lock = threading.Lock()
        self.started = clock()
        self.active = 0
        self.queued = 0
        self.token_times = deque(maxlen=20000)
        self.minutes = deque(maxlen=24 * 60)   # [minute, tokens, eval_ns, requests, errors]
        self.day = self._today()
        self.requests_today = 0
        self.totals = {"requests": 0, "tokens": 0, "errors": 0, "auth_failures": 0,
                       "refused_gpu": 0, "pairings": 0}
        self.auth_fail = {}
        self.devices = {}      # id -> {"name", "last_seen", "active"}
        self.recent = deque(maxlen=200)
        # for the dashboard: counts, times and model names only
        self.errors = {}                     # error code -> count
        self.events = deque(maxlen=30)       # {"t", "kind", "model"}
        self.ttft = deque(maxlen=20)         # ms from request to first token
        self.prompt = deque(maxlen=20)       # (prompt tokens, prompt eval ns)
        self.loaded = []
        self.ollama_version = ""
        self._load_counters()

    def _today(self):
        return datetime.date.fromtimestamp(self.clock()).isoformat()

    def _load_counters(self):
        c = read_json(Paths.counters, {}) or {}
        if isinstance(c, dict):
            if c.get("day") == self.day:
                self.requests_today = int(c.get("requests_today", 0))
            for k in self.totals:
                try:
                    self.totals[k] = int((c.get("totals") or {}).get(k, 0))
                except (TypeError, ValueError):
                    pass
            now_min = int(self.clock() // 60)
            for m in c.get("minutes", []):
                if isinstance(m, list) and len(m) == 5 and now_min - m[0] < 24 * 60:
                    self.minutes.append([int(x) for x in m])

    def _bucket(self):
        m = int(self.clock() // 60)
        if not self.minutes or self.minutes[-1][0] != m:
            self.minutes.append([m, 0, 0, 0, 0])
        return self.minutes[-1]

    def _roll_day(self):
        d = self._today()
        if d != self.day:
            self.day = d
            self.requests_today = 0

    def auth_failure(self, code):
        with self.lock:
            self.totals["auth_failures"] += 1
            self.auth_fail[code] = self.auth_fail.get(code, 0) + 1

    def begin(self, dev_id, name):
        with self.lock:
            self._roll_day()
            self.requests_today += 1
            self.totals["requests"] += 1
            self._bucket()[3] += 1
            d = self.devices.setdefault(dev_id, {"name": name, "last_seen": 0, "active": 0})
            d["name"] = name
            d["last_seen"] = self.clock()
            d["active"] += 1

    def end(self, dev_id, record):
        with self.lock:
            d = self.devices.get(dev_id)
            if d:
                d["active"] = max(0, d["active"] - 1)
                d["last_seen"] = self.clock()
            if record.get("status", 200) >= 400:
                self.totals["errors"] += 1
                self._bucket()[4] += 1
                code = str(record.get("code") or "other")
                self.errors[code] = self.errors.get(code, 0) + 1
            if record.get("code") == "gpu_fit" or record.get("code") == "gpu_spill":
                self.totals["refused_gpu"] += 1
            self.recent.append(record)

    def event(self, kind, model):
        with self.lock:
            self.events.append({"t": int(self.clock()), "kind": kind, "model": safe_label(model, 64)})

    def first_token(self, ms):
        with self.lock:
            self.ttft.append(int(ms))

    def prompt_done(self, count, ns):
        if count and ns:
            with self.lock:
                self.prompt.append((int(count), int(ns)))

    def token(self, n=1):
        now = self.clock()
        with self.lock:
            for _ in range(n):
                self.token_times.append(now)

    def eval_done(self, eval_count, eval_ns):
        with self.lock:
            b = self._bucket()
            b[1] += int(eval_count or 0)
            b[2] += int(eval_ns or 0)
            self.totals["tokens"] += int(eval_count or 0)

    def _rate(self, minutes):
        now_min = int(self.clock() // 60)
        tok = ns = 0
        for m, t, e, _r, _x in self.minutes:
            if now_min - m < minutes:
                tok += t
                ns += e
        return round(tok / (ns / 1e9), 1) if ns else 0.0

    def snapshot(self):
        with self.lock:
            self._roll_day()
            now = self.clock()
            cur = sum(1 for t in self.token_times if now - t <= 5) / 5.0
            return {
                "version": VERSION,
                "time": int(now),
                "started": int(self.started),
                "active": self.active,
                "queued": self.queued,
                "requests_today": self.requests_today,
                "totals": dict(self.totals),
                "auth_failures": dict(self.auth_fail),
                "tps": {"current": round(cur, 1), "1h": self._rate(60), "24h": self._rate(1440)},
                "per_minute": [list(m) for m in list(self.minutes)[-60:]],
                "devices": [{"id": k, "name": v["name"], "last_seen": int(v["last_seen"]),
                             "active": v["active"],
                             "connected": v["active"] > 0 or now - v["last_seen"] < 120}
                            for k, v in self.devices.items()],
                "recent": list(self.recent)[-50:],
                "loaded": list(self.loaded),
                "ollama_version": self.ollama_version,
                "errors": dict(self.errors),
                "events": list(self.events),
                "ttft_ms": int(sum(self.ttft) / len(self.ttft)) if self.ttft else None,
                "prompt_tps": round(sum(c for c, _ in self.prompt) / (sum(n for _, n in self.prompt) / 1e9), 1)
                if self.prompt else None,
            }

    def counters(self):
        with self.lock:
            return {"day": self.day, "requests_today": self.requests_today,
                    "totals": dict(self.totals), "minutes": [list(m) for m in self.minutes]}


class Slot:
    """One model job on the GPU at a time; a short queue behind it."""

    def __init__(self, stats, max_waiting):
        self.cond = threading.Condition()
        self.busy = False
        self.stats = stats
        self.max_waiting = max_waiting

    def acquire(self, timeout):
        with self.cond:
            if self.busy and self.stats.queued >= self.max_waiting:
                return "full"
            self.stats.queued += 1
            try:
                end = time.monotonic() + timeout
                while self.busy:
                    rem = end - time.monotonic()
                    if rem <= 0:
                        return "timeout"
                    self.cond.wait(rem)
                self.busy = True
                self.stats.active += 1
                return "ok"
            finally:
                self.stats.queued -= 1

    def release(self):
        with self.cond:
            self.busy = False
            self.stats.active = max(0, self.stats.active - 1)
            self.cond.notify()


# ---- the gateway -----------------------------------------------------------

class Gateway:
    def __init__(self, cfg, clock=time.time):
        self.cfg = cfg
        self.clock = clock
        self.devices = DeviceStore()
        self.verifier = RequestVerifier(self.devices, clock)
        self.access = AccessVerifier(cfg["access_team_domain"], cfg["gateway_aud"],
                                     cfg.get("certs_url") or "",
                                     bool(cfg.get("allow_insecure_certs_url")), clock=clock)
        self.stats = Stats(clock)
        self.slot = Slot(self.stats, int(cfg["queue_max"]))
        self.base = cfg["ollama_url"]
        self.pair_lock = threading.Lock()
        self.pair = {"last_try": 0.0}
        self.inflight = threading.BoundedSemaphore(int(cfg.get("max_inflight") or 16))
        self.last_device = None   # whose request last ran on the GPU (see switch_device)
        self.meminfo = o1stats.meminfo
        self.oom_kills = o1stats.ollama_oom_kills
        self.gpu_info = o1gpu.detect()   # vendor, name, vram_bytes (see gpu())
        self.gpu_at = time.monotonic()
        # real work only (chat, generate, embeddings): what auto sleep waits on (6b346)
        self.activity = o1idle.Activity(clock)
        self.sleep_lock = threading.Lock()
        self.usage_lock = threading.Lock()
        self.usage_at = None
        self.usage_val = {}
        self.ram_val = {}
        self._allow_key = object()
        self._ram = set()
        self.tags = {}
        self.tags_at = 0.0
        self.info = {}
        self.lan_net = ipaddress.ip_network(cfg["lan_cidr"], strict=False)

    # -- Access ---------------------------------------------------------

    def gpu(self):
        """The card: detected when the gateway starts, and kept once one is
        found. At boot the gateway can start a moment before the graphics
        driver has finished (seen: 2 s), which once left it saying "no card"
        until the next restart, so while none is found it looks again, at
        most every GPU_RECHECK_S seconds."""
        if not (self.gpu_info or {}).get("vendor") and time.monotonic() - self.gpu_at >= GPU_RECHECK_S:
            self.gpu_at = time.monotonic()
            self.gpu_info = o1gpu.detect()
        return self.gpu_info
    def sleep_view(self):
        """The auto-sleep settings and what the desktop can do about them:
        exactly {enabled, minutes, supported, wake}."""
        cfg = o1idle.read_config()
        return {"enabled": cfg["enabled"], "minutes": cfg["minutes"],
                "supported": o1idle.deep_sleep_supported(), "wake": o1idle.published_wake()}

    def sleep_set(self, changes):
        with self.sleep_lock:
            cfg = o1idle.read_config()
            cfg.update(changes)
            o1idle.write_config(cfg)
        return self.sleep_view()

    def usage(self):
        """The card's busy percent and VRAM in use and the server's memory
        in use, for the app's meter: five numbers and nothing else, read at
        most once a second however many devices ask (one reading at a time)."""
        with self.usage_lock:
            now = time.monotonic()
            if self.usage_at is None or now - self.usage_at >= USAGE_CACHE_S:
                self.usage_at = now
                self.usage_val = o1gpu.usage((self.gpu() or {}).get("vendor"))
                try:
                    r = o1stats.ram_usage(self.meminfo())
                except Exception:
                    r = {}
                self.ram_val = {k: r.get(k) for k in RAM_KEYS}
            # only these, whatever the reader returned
            return {"gpu": {k: self.usage_val.get(k) for k in USAGE_KEYS},
                    "ram": dict(self.ram_val)}

    def check_access(self, headers, lan, client_ip, method="GET"):
        if lan:
            if not self.cfg.get("lan_mode"):
                raise GatewayError(403, "access", "LAN mode is off")
            try:
                if ipaddress.ip_address(client_ip) not in self.lan_net:
                    raise GatewayError(403, "access", "not from the home network")
            except ValueError:
                raise GatewayError(403, "access", "not from the home network")
            return
        if self.cfg.get("access") == "none":
            # No Cloudflare in front: the way in is an SSH tunnel to this
            # loopback port. A web page in the user's browser can reach the
            # tunnel's local end too, so refuse anything a browser would add:
            # a Host that isn't loopback (DNS rebinding), an Origin, and
            # POSTs without a JSON content type (CORS "simple" requests).
            # Signatures are still required after this.
            host = (headers.get("Host") or "").strip().lower()
            if not re.match(r"^(127\.0\.0\.1|localhost)(:[0-9]{1,5})?$", host):
                raise GatewayError(403, "access", "Host must be 127.0.0.1 or localhost")
            if headers.get("Origin") is not None:
                raise GatewayError(403, "access", "requests from web pages are refused")
            if method == "POST" and (headers.get("Content-Type") or "").split(";")[0].strip().lower() \
                    != "application/json":
                raise GatewayError(403, "access", "POST needs Content-Type: application/json")
            return
        host = (headers.get("Host") or "").split(":")[0].lower()
        if host != self.cfg["hostname_gateway"].lower():
            raise GatewayError(403, "access", "wrong host")
        token = headers.get("Cf-Access-Jwt-Assertion")
        if not token:
            raise GatewayError(403, "access", "Cloudflare Access token missing")
        try:
            claims = self.access.verify(token)
        except JWTError as e:
            raise GatewayError(403, "access", "Cloudflare Access token rejected: %s" % e)
        want = (self.cfg.get("service_token_client_id") or "").strip()
        if want and claims.get("common_name") != want:
            raise GatewayError(403, "access", "not the paired service token")

    # -- Ollama ---------------------------------------------------------
    def refresh_tags(self, force=False):
        if not force and self.clock() - self.tags_at < 20 and self.tags:
            return self.tags
        st, data = o1ollama.call(self.base, "GET", "/api/tags", timeout=10)
        if st != 200 or not isinstance(data, dict):
            raise GatewayError(502, "ollama", "Ollama is not answering")
        tags = {}
        for m in data.get("models", []) or []:
            if isinstance(m, dict) and not o1ollama.is_remote(m) and m.get("name"):
                tags[m["name"]] = m
        self.tags = tags
        self.tags_at = self.clock()
        return tags

    def local_model(self, name):
        if not valid_model_name(name):
            raise GatewayError(400, "bad_model", "model name is missing or malformed")
        for force in (False, True):
            for k, m in self.refresh_tags(force).items():
                if o1ollama.same_model(k, name):
                    return k, m
        raise GatewayError(404, "no_model", "model is not installed on this desktop")

    def model_info(self, name, entry):
        key = (name, entry.get("digest"))
        if key not in self.info:
            st, data = o1ollama.call(self.base, "POST", "/api/show", {"model": name}, timeout=30)
            if st != 200 or not isinstance(data, dict):
                raise GatewayError(502, "ollama", "Ollama could not describe the model")
            self.info[key] = {"model_info": data.get("model_info") or {},
                              "capabilities": data.get("capabilities") or []}
        return self.info[key]

    def vram_total(self):
        v = int(self.cfg.get("vram_total_bytes") or 0)
        return v or o1stats.gpu_vram_total()

    def is_ram_model(self, name):
        """True if the allow-list marks this model 'ram': it may load partly
        into system memory. Everything else is GPU only."""
        try:
            st = os.stat(Paths.allow)
            key = (st.st_mtime_ns, st.st_size, st.st_ino)
        except OSError:
            key = None
        if key != self._allow_key:
            self._ram = ram_models()
            self._allow_key = key
        return any(o1ollama.same_model(n, name) for n in self._ram)

    def budget(self, ram, host_only=False):
        """Bytes a model may take: VRAM less the reserve; for 'ram' models
        plus the system RAM available now (and what loaded models hold in
        RAM, since they are unloaded first), less a margin for the OS.
        host_only: the system-memory part alone."""
        total = self.vram_total()
        vram = max(0, total - int(self.cfg["vram_reserve_mib"]) * (1 << 20)) if total else 0
        if not ram:
            return vram or None
        if host_only:
            vram = 0
        mi = self.meminfo()
        avail = int(mi.get("MemAvailable", 0))
        for m in self.stats.loaded:
            avail += max(0, int(m.get("size") or 0) - int(m.get("size_vram") or 0))
        margin = max(8 << 30, int(mi.get("MemTotal", 0) * 0.12), int(self.cfg.get("ram_margin_gib") or 8) << 30)
        ram_part = avail - margin
        cap = int(self.cfg.get("ollama_memory_max_bytes") or 0)
        high = int(self.cfg.get("ollama_memory_high_bytes") or 0) or (cap - (2 << 30) if cap else 0)
        if high:
            # Ollama's MemoryHigh (setup.sh: 2 GiB under its MemoryMax): above
            # it the kernel throttles and reclaims Ollama, so the part in
            # system memory must fit under it, not just under the hard cap.
            ram_part = min(ram_part, high)
        return max(0, vram + max(0, ram_part))

    def fit_check(self, name, entry, n_ctx, ram=False, explicit=True):
        """Refuses a model that can't fit; returns the num_ctx to use. A
        'ram' model without an explicit num_ctx steps down to 4096, then
        2048, before it is refused."""
        info = self.model_info(name, entry)
        # With llama.cpp's CPU weight repacking on (Ollama's default), the
        # CPU copy of the weights is an anonymous buffer whose size Ollama
        # doesn't predict: on the desktop gpt-oss:120b got a 58 GiB
        # CPU_REPACK buffer and almost nothing on the GPU. So a 'ram' model
        # must then fit in system memory on its own, as if nothing went to
        # the GPU. Only with repacking off (ollama_no_repack, which needs
        # LLAMA_ARG_REPACK=false in ollama.service) does VRAM count too.
        host_only = ram and not self.cfg.get("ollama_no_repack")
        budget = self.budget(ram, host_only)
        if budget is None:
            return n_ctx  # no VRAM figure: the /api/ps check after loading still applies
        tries = [n_ctx]
        if ram and not explicit:
            tries += [c for c in (4096, 2048) if c < n_ctx]
        for c in tries:
            need, kv = o1ollama.fit_estimate(int(entry.get("size") or 0), info["model_info"], c, ram)
            if need <= budget:
                return c
        self.stats.event("refused: gpu_fit", name)
        where = ("free system memory (the whole model, since weight repacking is on)" if host_only
                 else "VRAM plus free system memory" if ram else "VRAM")
        raise GatewayError(
            507, "gpu_fit",
            "model does not fit in %s at num_ctx %d: needs about %.1f GiB, %.1f GiB available"
            % (where, tries[-1], need / 2**30, budget / 2**30),
            need_bytes=need, budget_bytes=budget)

    def placement(self, m):
        size = int(m.get("size") or 0)
        pct = int(100 * int(m.get("size_vram") or 0) / size) if size else 0
        return {"placement": "gpu" if pct >= 100 else "gpu+ram", "gpu_pct": min(pct, 100)}

    def make_room(self, name, ram):
        """A 'ram' model loads alone; a GPU-only model never shares the
        machine with a 'ram' model. Unloads what's in the way and confirms
        it through /api/ps, or refuses (503)."""
        try:
            loaded = self.loaded_models()
        except (OSError, ValueError):
            raise GatewayError(503, "busy", "Ollama is not answering; try again")

        def in_ram(m):
            # flagged now, or partly in system memory whatever the flag says
            # (e.g. the flag was removed while the model stayed loaded)
            n = m.get("name") or m.get("model")
            return self.is_ram_model(n) or int(m.get("size_vram") or 0) < int(m.get("size") or 0)
        victims = [m.get("name") or m.get("model") for m in loaded
                   if not o1ollama.same_model(m.get("name") or m.get("model"), name) and (ram or in_ram(m))]
        if not victims:
            return
        for v in victims:
            self.unload(v, "unload: make room")
        try:
            left = self.loaded_names()
        except (OSError, ValueError):
            left = victims
        if any(o1ollama.same_model(v, n) for v in victims for n in left):
            raise GatewayError(503, "busy", "the desktop could not unload another model first; try again")
        log("make-room", model=",".join(victims))

    def check_oom(self, before):
        """If Ollama's memory limit stopped the load, say so plainly."""
        after = self.oom_kills() if before is not None else None
        if before is not None and after is not None and after > before:
            log("ram-oom", reason="ollama_memory_limit")
            self.stats.event("refused: ram_oom", "")
            raise GatewayError(507, "ram_oom",
                               "the model did not fit in memory: Ollama's memory limit stopped the load "
                               "(the desktop itself is fine); try a smaller num_ctx or model")

    def check_placement(self, name, ram, before):
        """After loading: a GPU-only model must be 100% in VRAM; a 'ram'
        model may share, but loading it must not have pushed anything into
        swap or left the machine without memory."""
        if not ram:
            return self.ensure_on_gpu(name)
        share = self.gpu_share(name)
        if share is None:
            raise GatewayError(502, "ollama", "model did not load")
        after = self.meminfo()
        swapped = int(before.get("SwapFree", 0)) - int(after.get("SwapFree", 0))
        if swapped > (512 << 20) or int(after.get("MemAvailable", 1 << 40)) < (1 << 30):
            self.stats.event("refused: ram_pressure", name)
            self.unload(name)
            log("ram-pressure", model=name, gpu_pct=int(share * 100))
            raise GatewayError(507, "ram_pressure",
                               "loading the model would push the desktop into swap; it was unloaded")

    def gpu_share(self, name):
        try:
            st, data = o1ollama.call(self.base, "GET", "/api/ps", timeout=10)
        except OSError:
            raise GatewayError(502, "ollama", "Ollama is not answering")
        if st != 200 or not isinstance(data, dict):
            raise GatewayError(502, "ollama", "Ollama is not answering")
        for m in data.get("models", []) or []:
            if o1ollama.same_model(m.get("name") or m.get("model"), name):
                size = int(m.get("size") or 0)
                vram = int(m.get("size_vram") or 0)
                return (vram / size) if size else 0.0
        return None

    def unload(self, name, why="unload"):
        self.stats.event(why, name)
        for path, body in (("/api/generate", {"model": name, "keep_alive": 0}),
                           ("/api/embed", {"model": name, "input": [], "keep_alive": 0})):
            try:
                st, _ = o1ollama.call(self.base, "POST", path, body, timeout=60)
                if st == 200:
                    return
            except OSError:
                pass

    def loaded_models(self):
        st, data = o1ollama.call(self.base, "GET", "/api/ps", timeout=10)
        if st != 200 or not isinstance(data, dict):
            raise ValueError("Ollama's /api/ps did not answer")
        return [m for m in data.get("models", []) or [] if m.get("name") or m.get("model")]

    def loaded_names(self):
        return [m.get("name") or m.get("model") for m in self.loaded_models()]

    def switch_device(self, dev_id):
        """Nothing is shared between devices, not even Ollama's prompt
        cache: when the GPU's next job belongs to a different paired device
        than the last one, every loaded model is unloaded first, and /api/ps
        must then show nothing loaded. If that can't be confirmed, the job
        is refused (503) and the last device stays as it was, so the next
        attempt tries again. Fails closed. The cost is one reload when the
        device changes. Called with the GPU slot held."""
        if self.last_device is None or self.last_device == dev_id:
            self.last_device = dev_id
            return
        cleared = False
        names = []
        for _attempt in range(2):
            try:
                names = self.loaded_names()
                for name in names:
                    self.unload(name, "unload: device switch")
                if not self.loaded_names():
                    cleared = True
                    break
            except (OSError, ValueError):
                pass
        if not cleared:
            log("device-switch", reason="unload_unconfirmed")
            raise GatewayError(503, "busy", "the desktop could not clear the previous device's model; try again")
        log("device-switch", model=",".join(names) or "-")
        self.last_device = dev_id

    def ensure_on_gpu(self, name, share=None):
        if share is None:
            share = self.gpu_share(name)
        if share is None:
            raise GatewayError(502, "ollama", "model did not load")
        if share < 1.0:
            self.stats.event("refused: gpu_spill", name)
            self.unload(name)
            log("gpu-spill", model=name, gpu_pct=int(share * 100))
            raise GatewayError(
                507, "gpu_spill",
                "model did not fit entirely in VRAM (%d%% on GPU); it was unloaded" % int(share * 100))

    def warm_load(self, name, n_ctx, ram=False):
        was_loaded = any(o1ollama.same_model(m.get("name"), name) for m in self.stats.loaded)
        opts = {"num_ctx": n_ctx}
        if ram and not self.cfg.get("ollama_no_repack"):
            opts["use_mmap"] = False   # see shape()
        try:
            st, data = o1ollama.call(self.base, "POST", "/api/generate",
                                     {"model": name, "prompt": "", "stream": False,
                                      "options": opts}, timeout=900)
        except OSError:
            raise GatewayError(502, "ollama", "Ollama stopped while loading the model")
        if st != 200:
            msg = (data or {}).get("error") if isinstance(data, dict) else None
            raise GatewayError(400 if st < 500 else 502, "ollama",
                               "Ollama refused to load the model: %s" % safe_label(msg or st, 200))
        if not was_loaded:
            self.stats.event("load", name)

    # -- request shaping ------------------------------------------------
    def shape(self, kind, obj, model_name, entry, ram=False):
        if not isinstance(obj, dict):
            raise GatewayError(400, "bad_request", "body must be a JSON object")
        out = {k: v for k, v in obj.items() if k in FIELDS[kind]}
        out["model"] = model_name
        opts = obj.get("options") if isinstance(obj.get("options"), dict) else {}
        clean = {k: v for k, v in opts.items() if k in SAMPLING_OPTIONS}
        n_ctx = None
        if kind in ("chat", "generate"):
            info = self.model_info(model_name, entry)
            cmax = o1ollama.context_max(info["model_info"]) or int(self.cfg["num_ctx_max"])
            default = self.cfg["num_ctx_default_ram"] if ram else self.cfg["num_ctx_default"]
            want = opts.get("num_ctx", default)
            if not isinstance(want, int) or isinstance(want, bool):
                raise GatewayError(400, "bad_request", "options.num_ctx must be an integer")
            n_ctx = max(512, min(want, cmax, int(self.cfg["num_ctx_max"])))
            clean["num_ctx"] = n_ctx
            out["stream"] = obj.get("stream", True) is not False
        if ram and not self.cfg.get("ollama_no_repack"):
            # With repacking on, the CPU weights are copied into anonymous
            # memory anyway; read them straight in (Ollama turns
            # use_mmap=false into llama-server --load-mode none) rather
            # than mmap'ing the file as well. With repacking off, mmap stays
            # on: the CPU weights are then file-backed page cache, which the
            # kernel can evict under Ollama's MemoryMax instead of killing.
            clean["use_mmap"] = False
        out["options"] = clean
        return out, n_ctx, "num_ctx" in opts


def make_handler(gw, lan=False):
    cfg = gw.cfg
    max_body = int(cfg["max_body_mib"]) << 20

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "ollama1"
        sys_version = ""

        def log_message(self, fmt, *args):  # the default logs request lines; we log our own
            pass

        def send_json(self, status, obj, extra_headers=None):
            raw = json.dumps(obj).encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            if status >= 400:
                # An error may leave a request body unread on this connection;
                # cloudflared reuses connections, so never read past it as
                # the next request (request smuggling). Close instead.
                self.send_header("Connection", "close")
                self.close_connection = True
            for k, v in (extra_headers or {}).items():
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(raw)

        def fail(self, e):
            body = {"error": str(e), "code": e.code, "server_time": int(gw.clock())}
            body.update(getattr(e, "extra", {}) or {})
            self.send_json(e.status, body)

        def do_GET(self):
            self.handle_any("GET")

        def do_POST(self):
            self.handle_any("POST")

        def do_PUT(self):
            self.handle_any("PUT")

        def do_DELETE(self):
            self.handle_any("DELETE")

        def read_body(self, limit):
            if self.headers.get("Transfer-Encoding"):
                raise GatewayError(411, "bad_request", "send a Content-Length")
            try:
                n = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                raise GatewayError(400, "bad_request", "bad Content-Length")
            if n < 0 or n > limit:
                raise GatewayError(413, "too_large", "body too large")
            return self.rfile.read(n) if n else b""

        def handle_any(self, method):
            t0 = time.monotonic()
            if not gw.inflight.acquire(blocking=False):
                self.close_connection = True
                return self.fail(GatewayError(503, "busy", "too many requests at once"))
            try:
                # Nothing below reads the body until the headers have passed
                # Access and the header half of the signature check.
                if len(self.path) > 2048:
                    raise GatewayError(414, "bad_request", "path too long")
                gw.check_access(self.headers, lan, self.client_address[0], method)
                route = self.path.split("?", 1)[0]
                if route == "/v1/pair" and method == "POST":
                    return self.handle_pair()
                try:
                    pre = gw.verifier.precheck(method, self.path, self.headers)
                    body = self.read_body(max_body)
                    dev_id, dev = gw.verifier.complete(pre, body)
                except AuthError as e:
                    gw.stats.auth_failure(e.code)
                    log("auth-fail", reason=e.code)
                    raise GatewayError(e.status, e.code, str(e))
                self.route(method, route, body, dev_id, dev, t0)
            except GatewayError as e:
                try:
                    self.fail(e)
                except OSError:
                    self.close_connection = True
            except (BrokenPipeError, ConnectionResetError):
                self.close_connection = True
            except Exception as e:  # never echo request content
                log("error", kind=type(e).__name__)
                try:
                    self.fail(GatewayError(500, "internal", "internal error"))
                except OSError:
                    self.close_connection = True
            finally:
                gw.inflight.release()

        # -- pairing (POST /v1/pair) -------------------------------------
        def handle_pair(self):
            """The gateway never sees the code: it checks the request's
            shape and pace, hands it to the root step, and relays the answer."""
            if lan:
                raise GatewayError(403, "pair_closed", "pairing works only through the tunnel, not on the LAN")
            body = self.read_body(8192)
            now = gw.clock()
            pub = read_public(now)
            if not pub:
                raise GatewayError(403, "pair_closed", "no pairing window is open at the desktop")
            with gw.pair_lock:
                if now - gw.pair["last_try"] < PAIR_MIN_INTERVAL:
                    gw.pair["last_try"] = now
                    raise GatewayError(429, "rate_limited", "wait a moment and try again")
                gw.pair["last_try"] = now
            try:
                obj = json.loads(body.decode("utf-8"))
                parse_pair_request(obj)
            except (ValueError, UnicodeDecodeError):
                raise GatewayError(400, "bad_request", "body must be JSON")
            except AuthError as e:
                raise GatewayError(e.status, e.code, str(e))
            if abs(now - obj["timestamp"]) > SKEW:
                raise GatewayError(401, "clock_skew", "timestamp is more than %d s off" % SKEW)
            req_id = secrets.token_hex(8)
            spool_request(req_id, pub["id"], obj)
            res = wait_result(req_id)
            if res is None:
                raise GatewayError(503, "pair_not_saved",
                                   "the desktop did not answer; open a new window and retry")
            status, out = res
            out = dict(out, server_time=int(gw.clock()))
            if status == 200:
                with gw.stats.lock:
                    gw.stats.totals["pairings"] += 1
                log("pair-ok", device=out.get("name", ""), id=out.get("device_id", ""))
            else:
                log("pair-fail", reason=out.get("code", ""), attempts_left=out.get("attempts_left", "-"))
            self.send_json(status, out)

        # -- signed routes ------------------------------------------------
        def route(self, method, route, body, dev_id, dev, t0):
            if any(route.startswith(p) for p in NEVER):
                raise GatewayError(404, "not_found", "not available through the gateway")
            if method == "GET" and route == "/v1/info":
                g = gw.gpu() or {}
                return self.send_json(200, {"gpu": {"vendor": g.get("vendor"), "name": g.get("name"),
                                                    "vram_bytes": g.get("vram_bytes")}})
            if method == "GET" and route == "/v1/usage":
                return self.send_json(200, gw.usage())
            if route == "/v1/sleep-config" and method == "GET":
                return self.send_json(200, gw.sleep_view())
            if route == "/v1/sleep-config" and method == "POST":
                changes, err = o1idle.parse_config_update(self.json_body(body))
                if err:
                    raise GatewayError(400, "bad_request", err)
                try:
                    view = gw.sleep_set(changes)
                except OSError:
                    raise GatewayError(500, "internal", "couldn't save the setting")
                return self.send_json(200, view)
            if method == "GET" and route == "/v1/whoami":
                return self.send_json(200, {"device_id": dev_id, "name": dev["name"],
                                            "server_time": int(gw.clock())})
            if method == "GET" and route == "/api/tags":
                st, data = o1ollama.call(gw.base, "GET", "/api/ps", timeout=10)
                running = (data or {}).get("models", []) or [] if st == 200 else []
                models = []
                for m in gw.refresh_tags(force=True).values():
                    item = {k: m.get(k) for k in ("name", "model", "size", "digest", "details", "modified_at")}
                    item["placement"] = "gpu+ram" if gw.is_ram_model(m["name"]) else "gpu"
                    item["gpu_pct"] = next((gw.placement(r)["gpu_pct"] for r in running
                                            if o1ollama.same_model(r.get("name") or r.get("model"), m["name"])), None)
                    models.append(item)
                return self.send_json(200, {"models": models})
            if method == "GET" and route == "/api/ps":
                st, data = o1ollama.call(gw.base, "GET", "/api/ps", timeout=10)
                keep = ("name", "model", "size", "size_vram", "context_length", "expires_at",
                        "details", "digest")
                models = [dict({k: m.get(k) for k in keep}, **gw.placement(m))
                          for m in (data or {}).get("models", []) or []]
                return self.send_json(200, {"models": models})
            if method == "GET" and route == "/api/version":
                st, data = o1ollama.call(gw.base, "GET", "/api/version", timeout=10)
                return self.send_json(200, {"version": (data or {}).get("version", "")})
            if method == "POST" and route == "/api/show":
                obj = self.json_body(body)
                name, _entry = gw.local_model(obj.get("model"))
                st, data = o1ollama.call(gw.base, "POST", "/api/show", {"model": name}, timeout=30)
                return self.send_json(st if st else 502, data if isinstance(data, dict) else {})
            kinds = {"/api/chat": "chat", "/api/generate": "generate",
                     "/api/embed": "embed", "/api/embeddings": "embeddings"}
            if method == "POST" and route in kinds:
                gw.activity.begin()
                try:
                    return self.model_job(kinds[route], self.json_body(body), dev_id, dev, t0)
                finally:
                    gw.activity.end()
            raise GatewayError(404, "not_found", "not available through the gateway")

        def json_body(self, body):
            try:
                obj = json.loads(body.decode("utf-8"))
            except (ValueError, UnicodeDecodeError):
                raise GatewayError(400, "bad_request", "body must be JSON")
            if not isinstance(obj, dict):
                raise GatewayError(400, "bad_request", "body must be a JSON object")
            return obj

        def model_job(self, kind, obj, dev_id, dev, t0):
            name, entry = gw.local_model(obj.get("model"))
            ram = gw.is_ram_model(name)
            fwd, n_ctx, explicit = gw.shape(kind, obj, name, entry, ram)
            fitted = gw.fit_check(name, entry, n_ctx or 2048, ram, explicit)
            if n_ctx:
                n_ctx = fitted
                fwd["options"]["num_ctx"] = n_ctx
            streaming = bool(fwd.get("stream")) and kind in ("chat", "generate")
            rec = {"t": int(gw.clock()), "device": dev["name"], "model": name, "kind": kind,
                   "status": 200, "ms": 0, "tokens": 0, "prompt_tokens": 0}
            gw.stats.begin(dev_id, dev["name"])
            headers_sent = False
            got = None
            try:
                if gw.slot.busy and gw.stats.queued >= gw.slot.max_waiting:
                    raise GatewayError(503, "busy", "the desktop is busy; try again shortly")
                if streaming:
                    self.start_stream()
                    headers_sent = True
                got = gw.slot.acquire(float(cfg["queue_wait_s"]))
                if got == "full":
                    raise GatewayError(503, "busy", "the desktop is busy; try again shortly")
                if got == "timeout":
                    raise GatewayError(503, "busy", "waited too long in the queue")
                gw.switch_device(dev_id)
                gw.make_room(name, ram)
                before = gw.meminfo() if ram else {}
                oom_before = gw.oom_kills() if ram else None
                if kind in ("chat", "generate"):
                    try:
                        gw.warm_load(name, n_ctx, ram)
                    except GatewayError:
                        gw.check_oom(oom_before)
                        raise
                    gw.check_placement(name, ram, before)
                    if streaming:
                        self.relay_stream(kind, fwd, rec, t0)
                    else:
                        self.relay_whole(kind, fwd, rec, check_after=None)
                else:
                    self.relay_whole(kind, fwd, rec, check_after=(ram, before))
            except GatewayError as e:
                rec["status"], rec["code"] = e.status, e.code
                if headers_sent:
                    self.stream_error(e)
                else:
                    raise
            except (BrokenPipeError, ConnectionResetError):
                rec["status"], rec["code"] = 499, "client_gone"
                self.close_connection = True
            except Exception as e:
                # e.g. Ollama restarting mid-queue. Once the 200 and chunked
                # headers are out, an HTTP error can't follow: end the stream
                # with an error line instead, and close.
                log("error", kind=type(e).__name__)
                err = GatewayError(502, "ollama", "Ollama is not answering")
                rec["status"], rec["code"] = 502, "ollama"
                if headers_sent:
                    self.stream_error(err)
                else:
                    raise err
            finally:
                if got == "ok":
                    gw.slot.release()
                rec["ms"] = int((time.monotonic() - t0) * 1000)
                gw.stats.end(dev_id, rec)
                log("req", device=dev["name"], model=name, kind=kind, status=rec["status"],
                    ms=rec["ms"], tokens=rec["tokens"], prompt_tokens=rec["prompt_tokens"])

        def start_stream(self):
            self.send_response(200)
            self.send_header("Content-Type", "application/x-ndjson")
            self.send_header("Transfer-Encoding", "chunked")
            self.send_header("Cache-Control", "no-cache, no-store, no-transform")
            self.send_header("X-Accel-Buffering", "no")
            self.end_headers()

        def chunk(self, data):
            self.wfile.write(b"%x\r\n%s\r\n" % (len(data), data))
            self.wfile.flush()

        def end_chunks(self):
            self.wfile.write(b"0\r\n\r\n")
            self.wfile.flush()

        def stream_error(self, e):
            try:
                line = {"error": str(e), "code": e.code, "done": True}
                line.update(getattr(e, "extra", {}) or {})
                self.chunk(json.dumps(line).encode("utf-8") + b"\n")
                self.end_chunks()
            except OSError:
                pass
            self.close_connection = True

        def relay_stream(self, kind, fwd, rec, t0=None):
            conn = o1ollama.connect(gw.base, timeout=600)

            def upstream_line(r):
                # Ollama's side failing is not the client going away.
                try:
                    return r.readline(16 << 20)
                except OSError:
                    raise GatewayError(502, "ollama", "Ollama stopped answering")
            try:
                try:
                    conn.request("POST", "/api/" + kind, body=json.dumps(fwd).encode("utf-8"),
                                 headers={"Content-Type": "application/json"})
                    r = conn.getresponse()
                except OSError:
                    raise GatewayError(502, "ollama", "Ollama stopped answering")
                if r.status != 200:
                    data = r.read(1 << 20)
                    try:
                        msg = json.loads(data.decode("utf-8")).get("error", "")
                    except (ValueError, AttributeError, UnicodeDecodeError):
                        msg = ""
                    raise GatewayError(r.status, "ollama", "Ollama: %s" % safe_label(msg or r.status, 200))
                while True:
                    line = upstream_line(r)
                    if not line:
                        break
                    self.chunk(line)
                    try:
                        obj = json.loads(line)
                    except ValueError:
                        continue
                    piece = (obj.get("message") or {}).get("content") if kind == "chat" else obj.get("response")
                    if piece:
                        if t0 is not None:
                            gw.stats.first_token((time.monotonic() - t0) * 1000)
                            t0 = None
                        gw.stats.token()
                    if obj.get("done"):
                        rec["tokens"] = int(obj.get("eval_count") or 0)
                        rec["prompt_tokens"] = int(obj.get("prompt_eval_count") or 0)
                        gw.stats.eval_done(obj.get("eval_count"), obj.get("eval_duration"))
                        gw.stats.prompt_done(obj.get("prompt_eval_count"), obj.get("prompt_eval_duration"))
                    if obj.get("error"):
                        rec["status"], rec["code"] = 502, "ollama"
                self.end_chunks()
            finally:
                conn.close()

        def relay_whole(self, kind, fwd, rec, check_after):
            try:
                st, data = o1ollama.call(gw.base, "POST", "/api/" + kind, fwd, timeout=600)
            except OSError:
                raise GatewayError(502, "ollama", "Ollama stopped answering")
            if st != 200 or not isinstance(data, dict):
                msg = data.get("error") if isinstance(data, dict) else ""
                raise GatewayError(st if st >= 400 else 502, "ollama",
                                   "Ollama: %s" % safe_label(msg or st, 200))
            if check_after:
                gw.check_placement(fwd["model"], check_after[0], check_after[1])
            rec["tokens"] = int(data.get("eval_count") or 0)
            rec["prompt_tokens"] = int(data.get("prompt_eval_count") or 0)
            gw.stats.prompt_done(data.get("prompt_eval_count"), data.get("prompt_eval_duration"))
            if data.get("eval_count"):
                gw.stats.eval_done(data.get("eval_count"), data.get("eval_duration"))
            self.send_json(200, data)

    return Handler


def stats_loop(gw, stop):
    """Once a second: the counts-only snapshot for the dashboard and panel.
    Every 5 s: which models are loaded. Every 60 s: the day's counters."""
    n = 0
    while not stop.is_set():
        gw.activity.write()            # every second: the file says what is running and that the gateway is alive
        if n % 5 == 0:
            try:
                st, data = o1ollama.call(gw.base, "GET", "/api/ps", timeout=5)
                gw.stats.loaded = [
                    dict({k: m.get(k) for k in ("name", "size", "size_vram", "context_length", "expires_at")},
                         ram_allowed=gw.is_ram_model(m.get("name") or ""), **gw.placement(m))
                    for m in (data or {}).get("models", []) or []] if st == 200 else []
                if not gw.stats.ollama_version or n % 300 == 0:
                    st, v = o1ollama.call(gw.base, "GET", "/api/version", timeout=5)
                    gw.stats.ollama_version = (v or {}).get("version", "") if st == 200 else ""
            except OSError:
                gw.stats.loaded = []
        try:
            snap = gw.stats.snapshot()
            snap["pairing_open"] = bool(read_public())
            write_json_atomic(Paths.stats, snap, mode=0o640, group="o1view")
            if n % 60 == 0:
                write_json_atomic(Paths.counters, gw.stats.counters(), mode=0o600)
        except OSError:
            pass
        n += 1
        stop.wait(1.0)


def serve(cfg, stop=None):
    if not o1crypto.available():
        log("fatal", reason="no_ed25519_backend_install_python3-nacl")
        sys.exit(1)
    if cfg.get("access") == "none" and cfg.get("tunnel_id"):
        # A Cloudflare tunnel forwards to this same loopback port; with no
        # Access check, anyone reaching the hostname would skip Cloudflare.
        log("fatal", reason="access_none_with_a_cloudflare_tunnel_configured")
        sys.exit(1)
    gw = Gateway(cfg)
    if not gw.access.configured and cfg.get("access") != "none":
        log("warning", reason="access_not_configured_all_tunnel_requests_refused")
    servers = [ThreadingHTTPServer(("127.0.0.1", int(cfg["gateway_port"])), make_handler(gw))]
    if cfg.get("lan_mode"):
        servers.append(ThreadingHTTPServer((cfg["lan_bind"], int(cfg["gateway_port"])),
                                           make_handler(gw, lan=True)))
    stop = stop or threading.Event()
    threading.Thread(target=stats_loop, args=(gw, stop), daemon=True).start()
    for s in servers:
        s.daemon_threads = True
        threading.Thread(target=s.serve_forever, daemon=True).start()
    log("started", port=cfg["gateway_port"], lan=bool(cfg.get("lan_mode")),
        crypto=o1crypto.BACKEND, access=gw.access.configured)
    return gw, servers, stop


def main():
    import argparse
    import signal
    ap = argparse.ArgumentParser(description="ollama1 gateway")
    ap.add_argument("--config", help="config file (default: systemd credential or /etc/ollama1/config.json)")
    args = ap.parse_args()
    cfg = load_config(args.config)
    _gw, servers, stop = serve(cfg)
    done = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: done.set())
    signal.signal(signal.SIGINT, lambda *_: done.set())
    done.wait()
    stop.set()
    for s in servers:
        s.shutdown()
    try:
        write_json_atomic(Paths.counters, _gw.stats.counters(), mode=0o600)
    except OSError:
        pass


if __name__ == "__main__":
    main()
