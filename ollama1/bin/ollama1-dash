#!/usr/bin/python3
"""ollama1-dash: the live dashboard.

  ollama1-dash --console        on the server's monitor (tty1), as the no-shell
                                user o1dash; systemd restarts it if it exits.
                                Keys only change the view: t (chart range 5 min / 1 h)
  ollama1-top                   the same over SSH; q quits
  ollama1-top --ascii           plain ASCII (any terminal)
  ollama1-top --once [--size 120x40]   one text frame, then exit
  ollama1-dash --set-font TTY   (root, from the unit) pick a console font for the screen
  ollama1-dash --dash text|graphic|auto   what --console draws (default auto, below)
  ollama1-dash --png out.png [--size 640x360] [--scale 2] [--pairing] [--live] [--screen cost]
                                one frame of the graphical panel as a picture (sample
                                numbers, or --live ones), to look at the design

On a screen that is connected, --console shows a GRAPHICAL panel (6b380): bar
gauges, rings and rolling charts drawn straight to the framebuffer (/dev/fb0), no
desktop and no browser (lib/o1panel.py, o1fb.py, o1paneld.py). "auto" uses it when
/dev/fb0 exists and a monitor is attached (/sys/class/drm/*/status); "text" keeps
the text dashboard below; "graphic" insists on the panel when there is a
framebuffer. The setting is OLLAMA1_DASH, or /etc/ollama1/dash-mode (setup.sh
--dash). Any failure of the panel (no permission, an odd pixel format, an
exception) is logged to the journal and the text dashboard takes over.
On the panel, Space on the server's keyboard flips to a screen of only the
electricity cost (24 hours, 7 days, 30 days) and back (6b381); other keys are ignored.

It shows counts, sizes, timings and names in a few fixed boxes: the GPU,
CPU and memory, requests, loaded models, storage, network and health, each a
label, a value and one bar or trend line (6b359: no chart walls; the drawing
is in lib/o1dashui.py, the terminal output in lib/o1dashterm.py). It
never shows a prompt or an answer: the gateway keeps none, and nothing
else it reads has any. The pairing code fills the screen while a pairing
window is open (on the console; ollama1-top shows it only to root).
"""
import locale
import os
import select
import signal
import sys
import time
import traceback

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

import o1dashterm  # noqa: E402
import o1dashui  # noqa: E402
import o1fb  # noqa: E402
import o1metrics  # noqa: E402

try:
    import termios
except ImportError:           # not a Unix (the tests import this on a Mac: fine)
    termios = None

MODE_FILE = "/etc/ollama1/dash-mode"
FB_PATH = "/dev/fb0"
TTY_PATH = "/dev/tty1"
SWITCH_CHECK_S = 10.0     # the text dashboard looks for a newly connected screen this often
TICK_S = 1.0     # new numbers once a second
POLL_S = 0.25    # the size and the keys are looked at four times a second

winch = [False]


def pick_glyphs(console, force_ascii):
    """blocks or ascii. On the console only what the picked font has (the
    font file says so); anywhere else blocks when the locale is UTF-8."""
    if force_ascii:
        return "ascii"
    font = o1metrics.font_state()
    if console or os.environ.get("TERM", "") == "linux":
        return "blocks" if font.get("glyphs") in ("blocks", "braille") else "ascii"
    enc = (locale.getpreferredencoding(False) or "").lower().replace("-", "")
    return "blocks" if enc == "utf8" else "ascii"


def write(text):
    data = text.encode("utf-8", "replace")
    fd = sys.stdout.fileno()
    while data:
        data = data[os.write(fd, data):]


def raw_input_mode():
    """No echo, no line editing, no signal keys: bytes arrive as typed."""
    if termios is None or not sys.stdin.isatty():
        return None
    old = termios.tcgetattr(0)
    new = termios.tcgetattr(0)
    new[3] &= ~(termios.ECHO | termios.ICANON | termios.ISIG | termios.IEXTEN)
    new[6][termios.VMIN] = 0
    new[6][termios.VTIME] = 0
    termios.tcsetattr(0, termios.TCSANOW, new)
    return old


def read_keys():
    if not sys.stdin.isatty():
        return b""
    try:
        if select.select([0], [], [], POLL_S)[0]:
            return os.read(0, 64)
    except (OSError, ValueError, InterruptedError):
        pass
    return b""


def run(console, force_ascii, switch=None):
    """The text dashboard. With `switch` (a function), it returns "graphic"
    as soon as that says the graphical panel can run (a monitor was plugged in)."""
    glyphs = pick_glyphs(console, force_ascii)
    sampler = o1metrics.Sampler()
    screen = o1dashterm.Screen()
    signal.signal(signal.SIGWINCH, lambda *_: winch.__setitem__(0, True))
    old = raw_input_mode()
    if console and glyphs != "ascii":
        write("\x1b%G")            # the console reads UTF-8 (the blocks are multi-byte)
    range_s = 300
    st, next_tick, last_size, dirty = None, 0.0, None, True
    next_switch = time.time() + SWITCH_CHECK_S
    try:
        while True:
            now = time.time()
            if switch and now >= next_switch:
                next_switch = now + SWITCH_CHECK_S
                if switch():
                    return "graphic"
            if st is None or now >= next_tick:
                st = sampler.tick()
                if not console and os.geteuid() != 0:
                    st["pairing"] = None
                next_tick, dirty = now + TICK_S, True
            size = o1dashterm.term_size()          # asked every time: it is never cached
            if size != last_size or winch[0]:
                winch[0] = False
                last_size, dirty = size, True
            if dirty:
                dirty = False
                write(screen.frame(o1dashui.render(st, size[0], size[1], glyphs, range_s, console=console), now))
            keys = read_keys()
            if not keys:
                if not sys.stdin.isatty():
                    time.sleep(POLL_S)
                continue
            if b"t" in keys or b"T" in keys:
                range_s = 3600 if range_s == 300 else 300
                dirty = True
            if not console and (b"q" in keys or b"Q" in keys or b"\x03" in keys):
                return
    finally:
        if old is not None:
            termios.tcsetattr(0, termios.TCSANOW, old)
        write(o1dashterm.RESTORE + (o1dashterm.CLEAR if not console else ""))


def read_mode_file(path=MODE_FILE):
    try:
        with open(path) as f:
            return f.read(32)
    except OSError:
        return None


def log(msg):
    sys.stderr.write("ollama1-dash: %s\n" % msg)
    sys.stderr.flush()


class Stop(Exception):
    pass


def run_graphic(fb_path=FB_PATH, tty_path=TTY_PATH):
    """The graphical panel until it is told to stop. Raises on any failure (the
    caller falls back to text); the console is back in text mode either way."""
    import o1paneld
    fb = o1fb.FbDevice(fb_path)
    stopping = [False]

    def term(*_):
        stopping[0] = True
    old = signal.signal(signal.SIGTERM, term)
    try:
        fd = 1 if os.isatty(1) else os.open(tty_path, os.O_RDWR)       # the unit gives us tty1 as stdout
        tty = o1fb.TtyGraphics(fd)
        sampler = o1metrics.Sampler()
        keys = o1paneld.Keys(0 if os.isatty(0) else fd)               # Space flips to the electricity cost (6b381)
        keys.start()
        try:
            o1paneld.run(fb, tty, sampler, vt=o1fb.vt_of(os.ttyname(fd)), stop=lambda: stopping[0], log=log, keys=keys)
        finally:
            keys.stop()
    finally:
        signal.signal(signal.SIGTERM, old)
        fb.close()
    return "stopped"


def console_main(force_ascii, flag):
    """--console: the graphical panel when it can run, else the text dashboard;
    and if the panel ever fails, the text dashboard for good (until restart)."""
    mode = o1fb.resolve_mode(flag, os.environ.get("OLLAMA1_DASH"), read_mode_file())
    failed = [False]

    def graphic_ok():
        if mode == "text" or failed[0]:
            return False
        if mode == "graphic":
            return os.path.exists(FB_PATH)
        return o1fb.panel_available(FB_PATH)[0]
    while True:
        if graphic_ok():
            try:
                if run_graphic() == "stopped":
                    return
            except Exception:                                  # never leave the screen dead
                log("the graphical panel stopped, using the text dashboard:\n" + traceback.format_exc())
                failed[0] = True
        if run(True, force_ascii, switch=graphic_ok if mode != "text" and not failed[0] else None) != "graphic":
            return


def png(args):
    """--png FILE: one frame of the graphical panel as a PNG, to review the design."""
    import o1gfx
    import o1panel
    out = args[args.index("--png") + 1]
    cost = "--screen" in args and args[args.index("--screen") + 1:][:1] == ["cost"]
    w, h = (1920, 1080) if cost else (640, 360)          # the cost screen is smooth print drawn at screen size
    if "--size" in args:
        w, h = (int(x) for x in args[args.index("--size") + 1].lower().split("x"))
    up = int(args[args.index("--scale") + 1]) if "--scale" in args else (1 if cost else 2)
    st = None
    if "--live" not in args:
        sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "tests"))
        try:
            import dash_sample
            st = dash_sample.sample(now=time.time(), pairing="--pairing" in args)
        except ImportError:
            st = None
    if st is None:
        sampler = o1metrics.Sampler()
        sampler.tick()
        time.sleep(1.0)
        st = sampler.tick()
    screen = args[args.index("--screen") + 1] if "--screen" in args else "panel"
    pm = o1panel.render(st, w, h, screen=screen if screen in ("panel", "cost") else "panel")
    with open(out, "wb") as f:
        f.write(o1gfx.png_bytes(pm.w, pm.h, pm.buf, upscale=up))
    print("wrote %s (%dx%d, x%d)" % (out, pm.w, pm.h, up))


def once(size, force_ascii):
    w, h = 120, 40
    if size:
        w, h = (int(x) for x in size.lower().split("x"))
    sampler = o1metrics.Sampler()
    sampler.tick()
    time.sleep(1.0)
    st = sampler.tick()
    if os.geteuid() != 0:
        st["pairing"] = None
    print(o1dashui.render(st, w, h, "ascii" if force_ascii else pick_glyphs(False, False)).text())


def main():
    args = sys.argv[1:]
    if "--set-font" in args:
        import o1font
        tty = args[args.index("--set-font") + 1] if len(args) > args.index("--set-font") + 1 else "/dev/tty1"
        print(o1font.set_font(tty))
        return
    console = "--console" in args
    force_ascii = "--ascii" in args
    locale.setlocale(locale.LC_ALL, "")
    if "--png" in args:
        return png(args)
    if "--once" in args:
        size = args[args.index("--size") + 1] if "--size" in args else None
        return once(size, force_ascii)
    if console:
        for s in (signal.SIGINT, signal.SIGQUIT, signal.SIGTSTP, signal.SIGHUP):
            signal.signal(s, signal.SIG_IGN)
        # Linux console: never blank the screen, never power it down.
        sys.stdout.write("\033[9;0]\033[14;0]")
        sys.stdout.flush()
        flag = args[args.index("--dash") + 1] if "--dash" in args and len(args) > args.index("--dash") + 1 else None
        return console_main(force_ascii, flag)
    run(console, force_ascii)


if __name__ == "__main__":
    main()
