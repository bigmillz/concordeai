#!/usr/bin/python3
"""ollama1-dash: the live dashboard.

  ollama1-dash --console        on the server's monitor (tty1), as the no-shell
                                user o1dash; systemd restarts it if it exits.
                                Keys only change the view: t (5 min / 1 h), p (page)
  ollama1-top                   the same over SSH; q quits
  ollama1-top --ascii           plain ASCII (any terminal)
  ollama1-top --once [--size 120x40]   one text frame, then exit
  ollama1-dash --set-font TTY   (root, from the unit) pick a console font for the screen

It shows counts, sizes, timings and names: tokens per second, requests,
the GPU, loaded models and model events, CPU, memory, disks, network,
health and paired devices, with charts over 5 minutes or an hour. It
never shows a prompt or an answer: the gateway keeps none, and nothing
else it reads has any. The pairing code fills the screen while a pairing
window is open (on the console; ollama1-top shows it only to root).
"""
import curses
import locale
import os
import signal
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

import o1dashui  # noqa: E402
import o1metrics  # noqa: E402

STYLES = {
    # name: (foreground, background, bold)
    "header": (curses.COLOR_BLACK, curses.COLOR_CYAN, True),
    "footer": (curses.COLOR_CYAN, -1, False),
    "border": (curses.COLOR_BLUE, -1, False),
    "title": (curses.COLOR_WHITE, -1, True),
    "text": (-1, -1, False),
    "dim": (curses.COLOR_CYAN, -1, False),
    "value": (curses.COLOR_WHITE, -1, True),
    "ok": (curses.COLOR_GREEN, -1, True),
    "warn": (curses.COLOR_YELLOW, -1, True),
    "bad": (curses.COLOR_RED, -1, True),
    "c_tps": (curses.COLOR_GREEN, -1, True),
    "c_req": (curses.COLOR_CYAN, -1, True),
    "c_gpu": (curses.COLOR_MAGENTA, -1, True),
    "c_mem": (curses.COLOR_BLUE, -1, True),
    "c_cpu": (curses.COLOR_YELLOW, -1, True),
    "c_pow": (curses.COLOR_YELLOW, -1, True),
    "c_io": (curses.COLOR_CYAN, -1, True),
    "c_io2": (curses.COLOR_MAGENTA, -1, True),
    "c_net": (curses.COLOR_GREEN, -1, True),
    "overlay": (curses.COLOR_BLACK, curses.COLOR_WHITE, False),
    "overlay_code": (curses.COLOR_BLACK, curses.COLOR_WHITE, True),
}


def pick_glyphs(console, force_ascii):
    if force_ascii:
        return "ascii"
    font = o1metrics.font_state()
    if console or os.environ.get("TERM", "") == "linux":
        return font.get("glyphs") or "ascii"
    enc = (locale.getpreferredencoding(False) or "").lower().replace("-", "")
    return "braille" if enc == "utf8" else "ascii"


def setup_colors():
    attrs = {}
    curses.start_color()
    try:
        curses.use_default_colors()
        default_bg = -1
    except curses.error:
        default_bg = curses.COLOR_BLACK
    for i, (name, (fg, bg, bold)) in enumerate(STYLES.items(), 1):
        try:
            curses.init_pair(i, fg if fg != -1 or default_bg == -1 else curses.COLOR_WHITE,
                             bg if bg != -1 else default_bg)
            attrs[name] = curses.color_pair(i) | (curses.A_BOLD if bold else 0)
        except curses.error:
            attrs[name] = curses.A_BOLD if bold else 0
    return attrs


def paint(scr, canvas, attrs):
    """Draw the canvas in runs of one style (few curses calls per row)."""
    for y in range(canvas.h):
        row, styles = canvas.chars[y], canvas.styles[y]
        x = 0
        while x < canvas.w:
            st = styles[x]
            x2 = x + 1
            while x2 < canvas.w and styles[x2] == st:
                x2 += 1
            try:
                scr.addstr(y, x, "".join(row[x:x2]), attrs.get(st, 0))
            except curses.error:
                pass  # the bottom-right cell
            x = x2
    scr.noutrefresh()
    curses.doupdate()


def run(scr, console, force_ascii):
    curses.curs_set(0)
    attrs = setup_colors()
    if console:
        curses.raw()  # Ctrl+C / Ctrl+Z / Ctrl+\ arrive as plain keys and are ignored
    scr.timeout(250)
    glyphs = pick_glyphs(console, force_ascii)
    sampler = o1metrics.Sampler()
    range_s, page = 300, 0
    next_tick = 0.0
    st = None
    while True:
        now = time.time()
        if now >= next_tick or st is None:
            st = sampler.tick()
            if not console and os.geteuid() != 0:
                st["pairing"] = None
            next_tick = now + 1.0
            h, w = scr.getmaxyx()
            scr.erase()
            paint(scr, o1dashui.render(st, w, h, glyphs, range_s, page), attrs)
        ch = scr.getch()
        if ch in (ord("t"), ord("T")):
            range_s = 3600 if range_s == 300 else 300
            next_tick = 0
        elif ch in (ord("p"), ord("P"), ord(" ")):
            page += 1
            next_tick = 0
        elif ch == curses.KEY_RESIZE:
            next_tick = 0
        elif not console and ch in (ord("q"), ord("Q"), 27):
            return


def once(size, force_ascii):
    w, h = 120, 40
    if size:
        w, h = (int(x) for x in size.lower().split("x"))
    sampler = o1metrics.Sampler()
    sampler.tick()
    time.sleep(1.0)
    st = sampler.tick()
    if os.geteuid() != 0:
        st["pairing"] = None
    print(o1dashui.render(st, w, h, "ascii" if force_ascii else pick_glyphs(False, False)).text())


def main():
    args = sys.argv[1:]
    if "--set-font" in args:
        import o1font
        tty = args[args.index("--set-font") + 1] if len(args) > args.index("--set-font") + 1 else "/dev/tty1"
        print(o1font.set_font(tty))
        return
    console = "--console" in args
    force_ascii = "--ascii" in args
    locale.setlocale(locale.LC_ALL, "")
    if "--once" in args:
        size = args[args.index("--size") + 1] if "--size" in args else None
        return once(size, force_ascii)
    if console:
        for s in (signal.SIGINT, signal.SIGQUIT, signal.SIGTSTP, signal.SIGHUP):
            signal.signal(s, signal.SIG_IGN)
        # Linux console: never blank the screen, never power it down.
        sys.stdout.write("\033[9;0]\033[14;0]")
        sys.stdout.flush()
    os.environ.setdefault("ESCDELAY", "25")
    curses.wrapper(run, console, force_ascii)


if __name__ == "__main__":
    main()
