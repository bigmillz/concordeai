# Fans at full speed while the server works (6b385): the graphics card's fan
# and every fan header the motherboard's chip lets the kit control go to 100%
# while a request, the card, a long job or the load says it is working, and for
# one minute after; then back to automatic, exactly as they were. A sensor over
# its limit forces 100% too. Root, because it writes the fans' sysfs files; no
# network; writes only its own state and status files.
#
# ProtectKernelTunables stays off (it would make /sys read-only), and
# ProtectKernelModules is on: the module (nct6775, the motherboard's chip) is
# loaded by the "+" line below, which runs outside this sandbox.
#
# A clean stop puts the fans back as they were (the service does it, and
# ExecStopPost again). A crash leaves them at 100%, never stopped: Restart=always
# brings it back in 2 s and it takes over from the saved originals.
[Unit]
Description=ollama1: fans at full speed while the server works, and one minute after
After=ollama1-gateway.service
StartLimitIntervalSec=0

[Service]
ExecStartPre=-+/usr/local/lib/ollama1/bin/ollama1-fan load-modules
ExecStart=/usr/local/lib/ollama1/bin/ollama1-fan run
ExecStopPost=/usr/local/lib/ollama1/bin/ollama1-fan stop-post
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=always
RestartSec=2
TimeoutStopSec=20
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/ollama1 /var/lib/ollama1
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
MemoryMax=64M
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0022
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
