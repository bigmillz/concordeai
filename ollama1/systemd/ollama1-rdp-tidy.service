# Remote desktop cleanup (6b506): ends GNOME remote login screens and remote
# desktops nobody is connected to (a login screen at once, a desktop after
# rdp_tidy_minutes), and nothing at all while any RDP client is connected to
# :3389. Root, because it ends other users' sessions through logind and reads
# which process holds each connection; it runs loginctl and ss, can't reach
# the network, and writes only its own state file. Off with "rdp_tidy": false
# in /etc/ollama1/config.json; a no-op without gnome-remote-desktop.
[Unit]
Description=ollama1: end abandoned GNOME remote desktop sessions

[Service]
Type=oneshot
ExecStart=/usr/local/lib/ollama1/bin/ollama1-rdp-tidy run
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=120
LimitCORE=0
Nice=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ollama1
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
MemoryMax=64M
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
IPAddressDeny=any
