# Applies the price schedule the admin panel saved in its own folder
# (/var/lib/ollama1-admin/tariff-request.json): read without following a
# symlink, only a regular file of at most 64 KiB, checked, then written to
# root's /var/lib/ollama1/tariff.json. The panel can start only this.
[Unit]
Description=ollama1: apply the price schedule saved in the admin panel

[Service]
Type=oneshot
ExecStart=/usr/local/lib/ollama1/bin/ollama1-power apply-request
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=1min
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ollama1 /run/ollama1/power /var/lib/ollama1-admin
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX
UMask=0027
