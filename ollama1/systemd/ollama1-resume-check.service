# After a wake (the sleep hook starts it): Ollama and the card must answer.
# If not, it waits for the card's driver and the models drive to be back
# (at most 90 s each time), restarts Ollama and the tunnel, and once more if
# Ollama still doesn't answer; the record says what it saw (6b371). After
# ollama1-gpu-tune.service when that is running too, so the two don't fight
# over the card. It also starts Ollama when the sleep hook had to stop it, and
# when the hook didn't empty the card for this sleep, unloads anything still
# loaded (restarting Ollama if that fails): no model carried across a sleep (6b446).
[Unit]
Description=ollama1: after waking, check Ollama and the GPU; restart Ollama and the tunnel if needed
After=ollama.service ollama1-gpu-tune.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/ollama1/bin/ollama1-helper resume-check
TimeoutStartSec=15min
