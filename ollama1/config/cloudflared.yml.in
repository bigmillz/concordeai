# ollama1 Cloudflare Tunnel (written by setup.sh). No ports are open at
# home: cloudflared connects out to Cloudflare. The credential file is not
# here; systemd passes it in (ollama1-tunnel.service).
tunnel: @TUNNEL_ID@
metrics: 127.0.0.1:8439
no-autoupdate: true
ingress:
  - hostname: @GW_HOST@
    service: http://127.0.0.1:8431
    originRequest:
      connectTimeout: 10s
      access:
        required: true
        teamName: @TEAM_NAME@
        audTag: ["@GATEWAY_AUD@"]
  - hostname: @ADMIN_HOST@
    service: http://127.0.0.1:8432
    originRequest:
      connectTimeout: 10s
      access:
        required: true
        teamName: @TEAM_NAME@
        audTag: ["@ADMIN_AUD@"]
  # @SSH_DOOR_BEGIN@ (setup.sh keeps these lines only with the SSH door on, 6b507)
  - hostname: @SSH_HOST@
    service: ssh://127.0.0.1:22
    originRequest:
      connectTimeout: 10s
      access:
        required: true
        teamName: @TEAM_NAME@
        audTag: ["@SSH_AUD@"]
  # @SSH_DOOR_END@
  - service: http_status:404
