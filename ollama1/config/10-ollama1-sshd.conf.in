# ollama1 (setup.sh). sshd uses the first value it reads, and this file is
# read before 50-cloud-init.conf, so these win. MaxAuthTries stays at the
# default (6), so an agent offering several keys first still gets to yours.
PermitRootLogin no
AllowUsers @ADMIN_USER_AT_LAN@
PubkeyAuthentication yes
LoginGraceTime 30
X11Forwarding no
@PASSWORD_LINES@
