# ollama1 local port guard, loaded by ollama1-nft.service. setup.sh fills
# in the numeric user ids. ufw handles traffic from outside; this handles
# connections made on this machine, to any of its own addresses (loopback,
# br0's, IPv4 or IPv6):
#   11434 (Ollama)         root, ollama, the gateway, the admin panel
#   8431, 8432 (gateway,   root, cloudflared
#               panel)
# Everyone else (the admin user included, without sudo) gets a TCP reset. The web
# terminal has no TCP port at all: ttyd listens on a UNIX socket in a folder
# only root and the panel's user can open.
table inet ollama1
delete table inet ollama1
table inet ollama1 {
    chain output {
        type filter hook output priority filter; policy accept;
        tcp dport 11434 fib daddr type local meta skuid != { 0, @UID_OLLAMA@, @UID_O1GW@, @UID_O1ADMIN@ } counter reject with tcp reset
        tcp dport { 8431, 8432 } fib daddr type local meta skuid != { 0, @UID_CLOUDFLARED@ } counter reject with tcp reset
    }
}
