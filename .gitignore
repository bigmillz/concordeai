# build artifacts — the DMG ships as a Release asset, not in the tree.
# Three brand generations of bundle names; the .app is a build output
# (its Resources/millenai.py is a stale duplicate of the source).
MillenAI.app/
Concorde.app/
ConcordeAI.app/
*.dmg
*.dmg.sha256
__pycache__/
*.pyc

# macOS / tooling noise
.DS_Store
.claude/

# unrelated to the app, and v23-mac.sh contains a private server address
v23-*.sh
# Windows artifacts, all brand generations — the *-Setup* / *-exe*
# globs carry the -x64/-arm64 suffix the old patterns missed
MillenAI-*-Windows.zip
MillenAI-*-Setup*.exe
MillenAI-*-Windows-exe*.zip
MillenAI.iss
Concorde-*-Windows.zip
ConcordeAI-*-Windows.zip
ConcordeAI-*-Setup*.exe
ConcordeAI-*-Windows-exe*.zip
ConcordeAI-*-x64.msi
.build-venv/
build/
dist/

# icon build intermediates — make_icon.py output; the .icns/.ico are the product
MillenAI.iconset/
icon_preview.png

# drill transcripts live in ~/Library/Application Support/MillenAI/drill_runs
drill_runs/
# generated from CRYPTO_REQS by the build scripts (6b327)
crypto-requirements.txt
crypto-selftest.json
# ConcordeVPN client files (links, QR codes, Shadowrocket profiles) hold
# server passwords and belong to the private VPN repo, never this public one
v23-*
*.shadowrocket.conf

# the native shell (6b532): Rust build output and Tauri's generated schemas
shell/src-tauri/target/
shell/src-tauri/gen/
# the shell build's extracted first-run script and pins (build_shell_dmg.sh, 6b537)
shell/src-tauri/sidecar/
# the on-device speech helper (6b541): built by shell/dictate/build.sh
shell/dictate/concorde-dictate
shell/dictate/concorde-dictate.*
# the on-device PDF reader (6b546): built by shell/pdftext/build.sh
shell/pdftext/concorde-pdftext
shell/pdftext/concorde-pdftext.*

# C++ build trees (the release builds into cpp/build-release)
cpp/build*/
