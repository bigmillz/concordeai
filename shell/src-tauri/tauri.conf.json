{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ConcordeAI",
  "version": "7.0.0",
  "identifier": "com.millen.millenai",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../millenai.py": "millenai.py",
      "../../fonts": "fonts",
      "../../vfx": "vfx",
      "sidecar/launch.sh": "launch.sh",
      "sidecar/crypto-requirements.txt": "crypto-requirements.txt",
      "sidecar/engine-requirements.txt": "engine-requirements.txt"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": ["python3"]
      }
    }
  }
}
